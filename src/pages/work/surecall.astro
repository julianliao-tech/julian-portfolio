          </div>
        </div>
      </section>

      <section class="white-block white-block-flush-bottom">
        <div class="image-row-single">
          <img data-tilt src={img('02.webp')} alt="Collage of SureCall app screens arranged at an angle, showing the signal test, booster setup, and information flows" />
        </div>
      </section>

      <section class="dark-block">
        <div class="wrap">
          <h2>Reflection</h2>
          <p class="reflect-subhead">Opening My Third Eye</p>
          <p>Working on this project deepened my understanding of how UX can bridge digital interfaces and physical environments. Designing for non ideal conditions from bad lighting to a user on the move <em>challenged me to make every screen hold meaning</em>.</p>
          <p>Working in a start up environment for a small to medium sized company was a great experience. I really got to be hands on with every step of this process along the way. I not only enhanced my design skills but learned something about cellular boosters as well. Additionally, I got to work with back end engineers to see how the engineering actually took place. They recommended things for me to change or add based on <strong>how easy/hard it was to code an element</strong>. This was definitely a challenge for me but worth all of the hard work. Thank you SureCall for having me!</p>
        </div>
      </section>

      <section class="dark-block">
        <div class="wrap">
          <h2 class="takeaways-heading">Key Takeaways</h2>
          <div class="takeaways-grid">
            {takeaways.map((t) => (
              <div class="takeaway-card">
                <span class="takeaway-dot" aria-hidden="true"></span>
                <h3>{t.title}</h3>
                <p>{t.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="up-next">
        <div class="wrap">
          <span class="quirky quirky-blue">Up Next</span>
          <a class="up-next-row" href={nextProject.href} data-tilt>
            <img src={nextProject.image} alt="" />
            <div>
              <h2>{nextProject.title}</h2>
              <p>{nextProject.subtitle}</p>
            </div>
            <span class="btn-outline">View Project</span>
          </a>
        </div>
      </section>
    </div>

    <Footer />

    <Lightbox />

    <script>
      import '../../scripts/site.js';
      import '../../scripts/lightbox.js';

      const btn = document.querySelector('[data-copy-email]');
      btn?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText('julianliaowork@gmail.com');
          const original = btn.textContent;
          btn.textContent = 'Copied!';
          setTimeout(() => { btn.textContent = original; }, 1500);
        } catch {
          window.location.href = 'mailto:julianliaowork@gmail.com';
        }
      });

      // Belt-and-suspenders: the autoplay/muted/loop/playsinline attributes
      // already handle this in every modern browser, but some browsers
      // silently drop a programmatic play() if it's called before the
      // element is attached — this re-triggers it once the page is ready.
      document.querySelectorAll<HTMLVideoElement>('.phone-video, .prototype-video').forEach((v) => {
        v.play().catch(() => {});
      });

      // Typewriter effect on the pull-quote — types each segment in order
      // (plain text, then the highlighted phrase, then the trailing plain
      // text) once the quote scrolls into view. Reduced-motion and
      // no-IntersectionObserver both fall back to showing the full text.
      const quoteEl = document.querySelector<HTMLElement>('[data-typewriter]');
      if (quoteEl) {
        const segments = Array.from(quoteEl.querySelectorAll<HTMLElement>('.tw-seg'));
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const typeSegments = () => {
          let segIndex = 0;
          let charIndex = 0;
          const step = () => {
            if (segIndex >= segments.length) return;
            const seg = segments[segIndex];
            const full = seg.dataset.full ?? '';
            if (charIndex <= full.length) {
              seg.textContent = full.slice(0, charIndex);
              charIndex++;
              setTimeout(step, 28);
            } else {
              segIndex++;
              charIndex = 0;
              setTimeout(step, 28);
            }
          };
          step();
        };

        if (reduced || !('IntersectionObserver' in window)) {
          segments.forEach((seg) => { seg.textContent = seg.dataset.full ?? ''; });
        } else {
          const io = new IntersectionObserver((entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                typeSegments();
                obs.disconnect();
              }
            });
          }, { threshold: 0.4 });
          io.observe(quoteEl);
        }
      }
    </script>

    <style>
      :global(body) {
        background: #ffffff;
      }



      .wrap {
        max-width: 74rem;
        margin-inline: auto;
        padding-inline: clamp(1.25rem, 5vw, 3.5rem);
      }

      /* Nav ------------------------------------------------------------ */




      .btn-pill {
        display: inline-flex;
        align-items: center;
        border: 1px solid var(--ink);
        border-radius: 999px;
        padding: 0.6em 1.4em;
        text-decoration: none;
        color: var(--ink);
        background: transparent;
        font-family: var(--font-body);
        font-weight: 600;
        cursor: pointer;
      }

      .btn-pill-solid {
        background: var(--ink);
        color: var(--bg);
      }

      /* Hero banner ------------------------------------------------------- */
      .hero-banner {
        aspect-ratio: 8 / 3;
        overflow: hidden;
      }

      .hero-banner img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
      }

      /* Marquee ----------------------------------------------------------- */
      .marquee-section {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-around;
        min-height: clamp(380px, 48vw, 640px);
        padding-block: clamp(2.5rem, 6vw, 4rem);
        overflow: hidden;
        background: #ffffff;
      }

      .marquee-row {
        overflow: hidden;
        white-space: nowrap;
      }

      .marquee-track {
        display: inline-flex;
        width: max-content;
      }

      .marquee-track span {
        display: inline-block;
        padding-inline: 1.5rem;
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(1.6rem, 5vw, 3rem);
        color: #4fd8ae;
        white-space: nowrap;
      }

      .marquee-row:nth-child(odd) .marquee-track span {
        color: rgba(79, 216, 174, 0.55);
      }

      .marquee-track-left {
        animation: marquee-left 32s linear infinite;
      }

      .marquee-track-right {
        animation: marquee-right 32s linear infinite;
      }

      @keyframes marquee-left {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
      }

      @keyframes marquee-right {
        from { transform: translateX(-50%); }
        to { transform: translateX(0); }
      }

      .marquee-phone {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 5;
      }

      .phone-frame {
        width: clamp(140px, 16vw, 220px);
        aspect-ratio: 658 / 1396;
        border: 3px solid var(--ink);
        border-radius: 1.5rem;
        padding: 0.5rem;
        background: var(--bg);
      }

      .phone-frame .placeholder {
        height: 100%;
        aspect-ratio: auto;
        border-radius: 1rem;
      }

      .phone-video {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 1rem;
      }

      @media (prefers-reduced-motion: reduce) {
        .marquee-track-left,
        .marquee-track-right {
          animation: none;
        }
      }

      /* Head block -------------------------------------------------------- */
      .head-block {
        padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 5vw, 3rem);
      }

      .head-top {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
        align-items: start;
        margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
      }

      .title {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(3.5rem, 10vw, 7rem);
        letter-spacing: -0.01em;
        line-height: 0.98;
        color: var(--ink);
        margin: 0;
      }

      /* Fill matches the section background on purpose — the reference
         had this as a plain white box floating on the page's cream
         background, which read as a mismatched card rather than part
         of the page. */
      .context-box {
        background: transparent;
        border-left: 3px solid var(--line-strong);
        padding-left: 1.25rem;
      }

      .context-label {
        margin: 0 0 0.35rem;
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--ink-faint);
      }

