---
// Slim site footer: a message, the contact icons, and the email address in
// three evenly spaced columns. Colors come from the page's own tokens, so it
// adapts to light and dark pages.
---
<footer class="footer">
  <div class="wrap footer-grid">
    <div class="col col-msg">
      <p class="msg-strong">Appreciate you dropping in!</p>
      <p>Want to team up? Let&rsquo;s make it happen!</p>
    </div>

    <div class="col col-icons">
      <a href="https://www.linkedin.com/in/julian-liao-475685239/" target="_blank" rel="noreferrer" aria-label="LinkedIn">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
      </a>
      <a href="mailto:julianliaowork@gmail.com" aria-label="Email Julian">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
      </a>
    </div>

    <div class="col col-mail">
      <a class="mail" href="mailto:julianliaowork@gmail.com">julianliaowork@gmail.com</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding-block: clamp(4rem, 9vw, 8rem);
    color: var(--ink);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: center;
  }

  .col {
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .col-msg {
    flex-direction: column;
    gap: 0.15rem;
  }

  .col-msg p {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.5;
    font-weight: 400;
    color: var(--ink);
  }

  .col-msg .msg-strong { font-weight: 700; }

  .col-icons { gap: 1.1rem; }

  .col-icons a,
  .mail {
    color: var(--ink);
    text-decoration: none;
    transition: color 0.25s var(--ease);
  }

  .col-icons a { display: grid; place-items: center; }

  .col-icons a:hover, .col-icons a:focus-visible,
  .mail:hover, .mail:focus-visible {
    color: var(--accent);
  }

  .mail {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.005em;
    overflow-wrap: anywhere;
  }

  @media (max-width: 760px) {
    .footer { padding-block: 4rem 5rem; }
    .footer-grid { grid-template-columns: 1fr; gap: 1.75rem; }
  }
</style>
