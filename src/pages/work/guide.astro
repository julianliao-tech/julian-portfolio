        </div>
      </section>

      <section class="white-block tight">
        <div class="image-row-single image-row-single-wide">
          <img data-tilt src={img('03.webp')} alt="Accessibility App Affinity Diagram grouping wheelchair-user research feedback into themes: Physical Barriers in Public, Information Gaps, Inconsistent Maintenance & Upkeep, Confidence in Recommending Accessible Spaces, and Desired App Features" />
        </div>
