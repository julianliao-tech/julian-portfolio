          const io = new IntersectionObserver((entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                typeSegments();
                obs.disconnect();
              }
            });
          }, { threshold: 0.4 });
          io.observe(quoteEl);
        }
      }
