  ],
  Interlaken: [
    { src: 'interlaken-1.webp', alt: 'Julian mid-freefall on a tandem skydive, cloud below him.' },
  ],
  Kauai: [
    { src: 'kauai-1.webp', alt: 'Julian standing up in the buttress roots of an enormous tree on Kauai, another boy sitting on the roots beside him.' },
  ],
  Krakow: [
    { src: 'krakow-1.webp', alt: "Julian in the middle of Krakow's main square, the Cloth Hall behind him." },
  ],
  Lisbon: [
    { src: 'lisbon-1.webp', alt: 'Friends sitting out on a Lisbon rooftop terrace at dusk, domes and rooftops below.' },
  ],
  London: [
    { src: 'london-1.webp', alt: 'Three friends standing in front of Big Ben and the Houses of Parliament.' },
  ],
  Mallorca: [
    { src: 'mallorca-1.webp', alt: 'Julian in a bandana and sunglasses on the cliffs above a rocky Mallorcan cove.' },
    { src: 'mallorca-2.webp', alt: "A hooked rocky headland reaching out into the sea below the cliffs of Mallorca's north coast." },
  ],
  Marrakech: [
