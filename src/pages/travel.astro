       marker is half off the globe, so it docks to the screen instead. */
    .shot {
      position: fixed;
      left: 50% !important;
      top: auto !important;
      bottom: 1rem;
      z-index: 60;
      width: min(19rem, calc(100vw - 1.5rem));
      margin-left: calc(min(19rem, 100vw - 1.5rem) / -2);
