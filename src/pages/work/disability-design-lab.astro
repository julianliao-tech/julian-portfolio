// ---------------------------------------------------------------------
// Case study page — Disability Design Lab (SI 407 midterm).
//
// Deliberately short: a recruiter gets the hero, who it's for, three
// decisions, the screens, and the system. Same page language as
// surecall.astro / guide.astro (full-bleed hero banner, marquee, head block with
// meta strip and typewriter pull quote, white/dark blocks, Up Next),
// with the project's own cobalt indigo + amber standing in for the
// per-case-study accent the way SureCall's green does.
//
// The one section with no precedent elsewhere on the site is "The
// design system", which renders the Figma file's real variable
// collections as live HTML rather than screenshots: the primitive
// ramps, the Light/Dark token aliases, the four Semantics modes, the
// three Typography modes and the Responsive Variables. Every value in
// the data below was read out of the Figma file
// (IUEIN9dDNOWmv6U227Qvb1) with the Figma MCP server, including the
// alias targets, which are resolved to hex here by the same primitive
// map Figma resolves them against.
//
// Mode switchers are progressive: each container ships with a default
// `data-mode` in the markup and CSS hides the other modes' values, so
// with JS off the page still shows one complete, correct mode.
//
// Screens are shown as uniform top-anchored crops so the grid scans at
// a glance; the lightbox (data-zoom-group) opens the full-length frame.
//
// Nothing about the audience is stated as research — the project had
// none, and the wording keeps that distinction.
// ---------------------------------------------------------------------
import '../../styles/global.css';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Lightbox from '../../components/Lightbox.astro';

const base = import.meta.env.BASE_URL;
const pageTitle = 'Disability Design Lab · Julian Liao';
const pageDescription =
  'A concept store for adaptive tools, organized by the daily challenge they solve. 16 screens on a five-collection design system.';
const ogImage = new URL(`${base}images/home/profile-illustration.webp`, Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);
const img = (n: string) => `${base}images/disability-design-lab/${n}`;

const meta = [
  { label: 'Timeline', value: 'Fall 2026' },
  { label: 'Role', value: ['UX/UI Designer', 'Design Systems'] },
  { label: 'Type of Work', value: ['Class Project', 'Ecommerce'] },
  { label: 'Tools', value: ['Figma', 'Figma Slides', 'Figma Make'] },
  {
    label: 'Skills',
    value: ['Design Systems', 'Design Tokens', 'Responsive Design', 'Accessibility'],
  },
];

const marqueeWords = Array(5).fill('DISABILITY DESIGN LAB');

const decisions = [
  {
    num: '01',
    title: 'Browse by daily challenge, not product category',
    body:
      'Four tasks lead the homepage and the navigation: Opening Containers, Getting Dressed, Writing & Drawing, Navigating Your Workspace. I assumed people arrive knowing which task they can no longer do, not which product type they need. Shop all is still there for people who want to browse everything.',
  },
  {
    num: '02',
    title: 'Two typefaces, two jobs',
    body:
      'Atkinson Hyperlegible sets everything a shopper has to read. The Braille Institute designed it to separate the characters that low vision readers mix up. Space Grotesk is limited to headings and short labels, so the rough style never touches the sentence someone reads to decide whether a tool will work for them.',
  },
  {
    num: '03',
    title: 'Rough on the decoration, clean on the controls',
    body:
      'Every hand drawn mark is on decoration: card outlines, chips, dividers, and the line under a heading. Each stroke is real wobbled geometry drawn in two offset passes. NN/g warns that a rough style can remove the visual cues that tell people what is a button, so buttons, form fields and body text stay conventional.',
  },
];

// Eight pages, each at both breakpoints. The desktop crop is what the
// grid shows; the mobile frame sits beside it in the second row.
const screens = [
  { name: 'Homepage', note: 'Leads with the four challenges', file: 'homepage' },
  { name: 'Catalogue', note: 'Filter sidebar, grid three wide', file: 'catalogue' },
  { name: 'Product detail', note: 'Variant chips, stepper, disclosures', file: 'product-detail' },
  { name: 'Quick view', note: 'A modal on a dimmed page', file: 'quickview' },
  { name: 'Shopping cart', note: 'Line items beside a running total', file: 'cart' },
  { name: 'Checkout', note: 'No account required', file: 'checkout' },
  { name: 'Order confirmed', note: 'Same arithmetic as the cart', file: 'confirmed' },
  { name: '404', note: 'The hand drawn mascot, between the fours', file: 'error404' },
];

// ---------------------------------------------------------------------
// Design system data — read from the Figma file's own variable
// collections, text styles and component sets.
// ---------------------------------------------------------------------

const stats = [
