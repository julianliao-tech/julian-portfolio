// than the filename: "mallorca.HEIC" was taken at 48.208, 16.372, which
// is St. Stephen's in Vienna, and "sevilla.HEIC" at 39.474, -0.376,
// which is Valencia Cathedral. Both pictures agree with their
// coordinates, so both are filed by coordinate.
//
// Mallorca, Merzouga and Alpe d'Huez are markers that only exist
// because a photo carried the coordinates. Sintra, Interlaken and
// Munich carried none and were placed by Julian from the pictures
// themselves — don't treat those three as measured.
const shots: Record<string, { src: string; alt: string }[]> = {
  "Alpe d'Huez": [
    { src: 'alpe-dhuez-1.webp', alt: "A group in ski gear crowded around a table of drinks at a mountain bar in Alpe d'Huez." },
