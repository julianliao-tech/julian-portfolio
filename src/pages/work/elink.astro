        width: clamp(150px, 15vw, 220px);
        aspect-ratio: 4 / 5;
        margin-top: calc(clamp(150px, 15vw, 220px) * 1.25 / -2);
        margin-left: calc(clamp(150px, 15vw, 220px) / -2);
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 20px 45px rgba(0, 0, 0, 0.45);
        backface-visibility: hidden;
      }

      .card img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      /* Phones: a tighter ring and smaller cards, and clip the ring so it
         can't widen the page. */
      @media (max-width: 600px) {
        .stage {
          --radius: 230px;
          height: 240px;
        }

        .card {
          width: 120px;
          margin-top: -75px;
          margin-left: -60px;
        }
      }

      /* Dark / white blocks ---------------------------------------------- */
      .dark-block {
        background: var(--ink);
        color: var(--bg);
        padding-block: clamp(3rem, 7vw, 5rem);
      }

      .white-block {
        padding-block: clamp(2.5rem, 6vw, 4rem);
      }

      .tint-blue { background: rgba(0, 87, 157, 0.06); }

      .white-block h2,
      .dark-block h2 {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(1.9rem, 4vw, 2.8rem);
        letter-spacing: -0.01em;
        margin: 0 0 0.6rem;
      }

      .white-block h2 { color: var(--ink); }
      .dark-block h2 { color: var(--bg); }

      .white-block p,
      .dark-block .wrap > p:not(.reflect-subhead) {
        max-width: none;
        font-size: 1rem;
        line-height: 1.6;
        text-align: justify;
        text-align-last: left;
        hyphens: auto;
      }

      .white-block p { color: var(--ink-soft); }
      .dark-block .wrap > p:not(.reflect-subhead) { color: rgba(253, 251, 249, 0.7); }

      .white-block strong { color: var(--ink); font-weight: 700; }
      .dark-block strong { color: var(--bg); font-weight: 700; }

      .reflect-subhead {
        margin: 1.5rem 0 0.75rem;
        font-family: var(--font-body);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.8rem;
        color: rgba(253, 251, 249, 0.5);
      }

      .findings-list {
        margin: 1rem 0 0;
        padding-left: 1.25rem;
        max-width: none;
      }

      .findings-list li {
        font-size: 1rem;
        line-height: 1.6;
        color: var(--ink-soft);
        margin-bottom: 0.4rem;
      }

      .eyebrow-label {
        font-family: var(--font-body);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #00579d;
        margin: 0 0 0.75rem;
        font-size: 0.85rem;
      }

      /* Images ------------------------------------------------------------ */
      .image-row-single {
        margin-top: clamp(1.5rem, 4vw, 2.5rem);
      }

      .image-row-single-wide {
        max-width: 56rem;
        margin-inline: auto;
      }

      .image-row-single img {
        display: block;
        width: 100%;
        border: 1px solid var(--line);
      }

      /* Prototype videos --------------------------------------------------- */
      .wide-video {
        margin-top: clamp(1.5rem, 4vw, 2.5rem);
        margin-bottom: 1rem;
        border-radius: 0.75rem;
        overflow: hidden;
        border: 1px solid var(--line);
        aspect-ratio: 1400 / 790;
        max-width: 56rem;
        margin-inline: auto;
      }

      .wide-video video {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      /* Challenge + solution pairing ------------------------------------------ */
      .solved-label {
        margin: clamp(1.75rem, 4vw, 2.5rem) 0 0;
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--ink-faint);
      }

      .dark-block .solved-label {
        color: rgba(253, 251, 249, 0.5);
      }

      /* Solution pillars ---------------------------------------------------- */
      .pillar-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
        margin-top: clamp(1.5rem, 4vw, 2.5rem);
      }

      .pillar-card {
        border: 1px solid var(--line);
        border-left: 3px solid #00579d;
        padding: 1.25rem 1.5rem;
      }

      .pillar-name {
        margin: 0 0 0.4rem;
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 0.95rem;
        color: var(--ink);
      }

      .pillar-text {
        margin: 0;
        max-width: none;
        font-size: 0.95rem;
        line-height: 1.6;
        color: var(--ink-soft);
      }

      .dark-block .pillar-card {
        border-color: rgba(253, 251, 249, 0.15);
        border-left-color: #4d9fdb;
      }

      .dark-block .pillar-name {
        color: var(--bg);
      }

      .dark-block .pillar-text {
        color: rgba(253, 251, 249, 0.65);
      }

      @media (min-width: 700px) {
        .pillar-grid { grid-template-columns: 1fr 1fr; }
      }

      /* Challenge cards --------------------------------------------------- */
      .challenge-head {
        display: flex;
        flex-direction: column;
        gap: 1.1rem;
        margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
      }

      .challenge-head .quirky {
        margin-top: -0.2rem;
      }

      .challenge-head h2 {
        color: var(--bg);
        margin: 0;
      }

      .quirky {
        font-family: var(--font-quirky);
        font-size: 1.2rem;
        color: #00579d;
        transform: rotate(-3deg);
        display: inline-block;
      }

      .dark-block .quirky {
        color: #4d9fdb;
      }

      .challenge-grid {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
      }

      .challenge-card {
        --tilt-x: 0deg;
        --tilt-y: 0deg;
        border: 1px solid rgba(253, 251, 249, 0.15);
        border-left: 3px solid rgba(253, 251, 249, 0.15);
        padding: 1.5rem;
        background: rgba(253, 251, 249, 0.03);
        transform: perspective(700px) rotateX(var(--tilt-x)) rotateY(var(--tilt-y));
        transition: background 0.3s ease, border-color 0.3s ease, transform 0.3s var(--ease-out);
      }

      .challenge-card p {
        margin: 0.75rem 0 0;
        max-width: none;
        color: rgba(253, 251, 249, 0.45);
        font-size: 1rem;
        line-height: 1.6;
      }

      .challenge-num {
        font-family: var(--font-body);
        font-weight: 800;
        font-size: 1.5rem;
        color: rgba(253, 251, 249, 0.35);
      }

      .challenge-card:hover,
      .challenge-card:focus-visible {
        background: rgba(253, 251, 249, 0.08);
        border-color: rgba(253, 251, 249, 0.3);
        border-left-color: #4d9fdb;
      }

      .challenge-card:hover .challenge-num,
      .challenge-card:focus-visible .challenge-num { color: #4d9fdb; }

      .challenge-card:hover p,
      .challenge-card:focus-visible p {
        color: var(--bg);
        font-weight: 500;
      }

      @media (min-width: 700px) {
        .challenge-grid-4 { grid-template-columns: repeat(3, 1fr); }
      }

      /* Up next / footer --------------------------------------------------- */
      .up-next { padding-block: clamp(3rem, 7vw, 5rem); }

      .up-next-row {
        --tilt-x: 0deg;
        --tilt-y: 0deg;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1.5rem;
        margin-top: 1rem;
        text-decoration: none;
      }

      .up-next-row img {
        width: 100px;
        aspect-ratio: 1;
        object-fit: cover;
        border: 1px solid var(--line);
        transform: perspective(700px) rotateX(var(--tilt-x)) rotateY(var(--tilt-y));
        transition: transform 0.3s var(--ease-out);
      }

      .up-next-row h2 {
        margin: 0;
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(1.6rem, 4vw, 2.2rem);
        color: var(--ink);
      }

      .up-next-row p {
        margin: 0.25rem 0 0;
        color: var(--ink-faint);
        font-size: 0.9rem;
      }

      .btn-outline {
        margin-left: auto;
        border: 1px solid var(--ink);
        border-radius: 999px;
        padding: 0.5em 1.2em;
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--ink);
      }

      /* Line chart ---------------------------------------------------------- */
      .chart-card {
        margin: clamp(1.5rem, 4vw, 2.5rem) 0 0;
        padding: clamp(1.25rem, 3vw, 2rem);
        border: 1px solid rgba(253, 251, 249, 0.15);
        max-width: 44rem;
        margin-inline: auto;
        margin-top: clamp(1.5rem, 4vw, 2.5rem);
      }

      .chart-title {
        margin: 0 0 1rem;
        font-family: var(--font-body);
        font-size: 0.9rem;
        color: rgba(253, 251, 249, 0.6);
        text-align: center;
      }

      .chart-svg {
        display: block;
        width: 100%;
        height: auto;
      }

      .chart-gridline {
        stroke: rgba(253, 251, 249, 0.12);
        stroke-width: 1;
      }

      .chart-axis-label {
        font-family: var(--font-body);
        font-size: 11px;
        fill: rgba(253, 251, 249, 0.45);
      }

      .chart-legend {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1.25rem;
        margin: 1rem 0 0;
        padding: 0;
      }

      .chart-legend li {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-body);
        font-size: 0.85rem;
        color: rgba(253, 251, 249, 0.7);
      }

      .chart-swatch {
        display: inline-block;
        width: 12px;
        height: 12px;
        border-radius: 3px;
      }

      /* Before / after slider ------------------------------------------------- */
      .compare {
        margin: clamp(1.5rem, 4vw, 2.5rem) 0 0;
      }

      .compare-frame {
        position: relative;
        aspect-ratio: 2880 / 1600;
        overflow: hidden;
        border-radius: 1.25rem;
        border: 1px solid var(--line);
        background: #0e1b2b;
        user-select: none;
      }

      .compare-img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top;
        pointer-events: none;
      }

      .compare-before {
        clip-path: inset(0 calc(100% - var(--pos)) 0 0);
        filter: grayscale(0.7) brightness(0.93);
      }

      .compare-pill {
        position: absolute;
        top: 1rem;
        z-index: 3;
        font-family: var(--font-body);
        font-weight: 800;
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #fdfbf9;
        padding: 0.65em 1.2em;
        border-radius: 999px;
        pointer-events: none;
      }

      .compare-pill-before { left: 1rem; background: #2f3238; }
      .compare-pill-after { right: 1rem; background: #00579d; }

      .compare-divider {
        position: absolute;
        top: 0;
        bottom: 0;
        left: var(--pos);
        width: 2px;
        margin-left: -1px;
        background: #00579d;
        z-index: 2;
        pointer-events: none;
      }

      .compare-handle {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 44px;
        height: 44px;
        margin: -22px 0 0 -22px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: #ffffff;
        border: 2px solid #00579d;
        color: #101010;
        font-size: 1.1rem;
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
      }

      .compare-range {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        margin: 0;
        opacity: 0;
        cursor: ew-resize;
        z-index: 4;
      }

      .compare-frame:focus-within .compare-handle {
        outline: 3px solid rgba(0, 87, 157, 0.4);
        outline-offset: 2px;
      }

      .compare-caption {
        margin: 0.9rem 0 0;
        font-family: var(--font-body);
        font-size: 0.9rem;
        color: var(--ink-faint);
      }




      /* Stakeholder cards ------------------------------------------------------ */
      .stakeholder-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
        margin-top: clamp(1.5rem, 4vw, 2.5rem);
      }

      .stakeholder-card {
        border: 1px solid rgba(253, 251, 249, 0.15);
        border-left: 3px solid #4d9fdb;
        padding: 1.25rem 1.5rem;
      }

      .stakeholder-name {
        margin: 0;
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 0.95rem;
        color: var(--bg);
      }

      .stakeholder-sub {
        margin: 0.15rem 0 0;
        max-width: none;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: rgba(253, 251, 249, 0.45);
      }

      .stakeholder-points {
        margin: 0.6rem 0 0;
        padding-left: 1.1rem;
        max-width: none;
      }

      .stakeholder-points li {
        font-size: 0.9rem;
        line-height: 1.5;
        color: rgba(253, 251, 249, 0.65);
        margin-bottom: 0.3rem;
      }

      .success-factors {
        margin-top: clamp(1.5rem, 4vw, 2.5rem);
        padding: 1.25rem 1.5rem;
        background: rgba(253, 251, 249, 0.05);
      }

      .success-factors-label {
        margin: 0 0 0.6rem;
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 0.85rem;
        color: #4d9fdb;
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }

      .success-factors-list {
        margin: 0;
        padding-left: 1.1rem;
        max-width: none;
      }

      .success-factors-list li {
        font-size: 0.9rem;
        line-height: 1.6;
        color: rgba(253, 251, 249, 0.7);
      }

      @media (min-width: 700px) {
        .stakeholder-grid { grid-template-columns: 1fr 1fr; }
      }

      /* Project plan: timeline / WBS / Gantt ----------------------------------- */
      .plan-sublabel {
        margin: clamp(2rem, 5vw, 3rem) 0 0.5rem;
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #00579d;
      }

      .timeline-list {
        list-style: none;
        margin: 1rem 0 0;
        padding: 0;
        border-left: 2px solid var(--line);
      }

      .timeline-list li {
        position: relative;
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.5rem 1rem;
        padding: 0.6rem 0 0.6rem 1.25rem;
      }

      .timeline-dot {
        position: absolute;
        left: -5px;
        top: 1.1rem;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #00579d;
      }

      .timeline-label {
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 0.9rem;
        color: var(--ink);
      }

      .timeline-date {
        font-family: var(--font-body);
        font-size: 0.85rem;
        color: var(--ink-faint);
      }

      .phase-tags {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: 1.25rem 0 0;
        padding: 0;
      }

      .phase-tags li {
        font-family: var(--font-body);
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--ink-soft);
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 0.35em 0.85em;
      }

      .wbs-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
        margin-top: 1rem;
      }

      .wbs-phase {
        border: 1px solid var(--line);
        padding: 1rem 1.25rem;
      }

      .wbs-phase-name {
        margin: 0 0 0.5rem;
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 0.85rem;
        color: #00579d;
      }

      .wbs-branches {
        margin: 0;
        padding-left: 1.1rem;
        max-width: none;
      }

      .wbs-branches li {
        font-size: 0.85rem;
        line-height: 1.5;
        color: var(--ink-soft);
      }

      @media (min-width: 900px) {
        .wbs-grid { grid-template-columns: repeat(5, 1fr); }
      }

      .gantt {
        margin-top: 1rem;
      }

      .gantt-row {
        display: grid;
        grid-template-columns: 8.5rem 1fr;
        grid-template-rows: auto auto;
        align-items: center;
        gap: 0.25rem 0.75rem;
        padding: 0.6rem 0;
        border-bottom: 1px solid var(--line);
      }

      .gantt-row-name {
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 0.8rem;
        color: var(--ink);
      }

      .gantt-track {
        position: relative;
        height: 10px;
        background: var(--bg-soft);
        border-radius: 999px;
      }

      .gantt-bar {
        position: absolute;
        top: 0;
        height: 100%;
        border-radius: 999px;
      }

      .gantt-row-dates {
        grid-column: 2;
        font-family: var(--font-body);
        font-size: 0.7rem;
        color: var(--ink-faint);
      }

      .gantt-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 1.25rem;
        margin-top: 1.25rem;
      }

      .gantt-legend-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-body);
        font-size: 0.8rem;
        color: var(--ink-soft);
      }

      .gantt-swatch {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 3px;
      }

      @media (min-width: 700px) {
        .gantt-row { grid-template-columns: 10rem 1fr 6rem; grid-template-rows: auto; }
        .gantt-row-dates { grid-column: 3; text-align: right; }
      }

      /* Risk table ---------------------------------------------------------- */
      .risk-table-wrap {
        margin-top: clamp(1.5rem, 4vw, 2.5rem);
        overflow-x: auto;
      }

      .risk-table {
        width: 100%;
        border-collapse: collapse;
        font-family: var(--font-body);
        font-size: 0.85rem;
      }

      .risk-table th {
        text-align: left;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: rgba(253, 251, 249, 0.45);
        padding: 0.5rem 0.75rem;
        border-bottom: 1px solid rgba(253, 251, 249, 0.2);
        white-space: nowrap;
      }

      .risk-table td {
        vertical-align: top;
        padding: 0.75rem;
        border-bottom: 1px solid rgba(253, 251, 249, 0.1);
        color: rgba(253, 251, 249, 0.7);
      }

      .risk-code {
        font-weight: 700;
        color: var(--bg);
        white-space: nowrap;
      }

      .risk-name {
        margin: 0 0 0.25rem;
        font-weight: 700;
        color: var(--bg);
        max-width: none;
      }

      .risk-detail {
        margin: 0;
        max-width: none;
        font-size: 0.8rem;
        color: rgba(253, 251, 249, 0.55);
      }

      .risk-grade {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.6rem;
        height: 1.6rem;
        border-radius: 4px;
        font-weight: 700;
      }

      .risk-grade-a { background: #e76f33; color: #1a0d05; }
      .risk-grade-b { background: rgba(253, 251, 249, 0.15); color: var(--bg); }

      .risk-mitigation {
        margin: 0;
        padding-left: 1rem;
        max-width: none;
      }

      .risk-mitigation li {
        font-size: 0.8rem;
        line-height: 1.5;
        color: rgba(253, 251, 249, 0.65);
      }

      /* Phones: each risk becomes a stacked card so Grade and Mitigation
         are visible instead of hidden off to the right. */
      @media (max-width: 700px) {
        .risk-table thead { display: none; }

        .risk-table,
        .risk-table tbody { display: block; }

        .risk-table tr {
          display: grid;
          grid-template-columns: 1fr 1fr auto;
          gap: 0.4rem 1rem;
          padding: 1rem 0;
          border-bottom: 1px solid rgba(253, 251, 249, 0.15);
        }

        .risk-table td {
          display: block;
          padding: 0;
          border: 0;
        }

        .risk-table td:nth-child(1),
        .risk-table td:nth-child(2),
        .risk-table td:nth-child(6) { grid-column: 1 / -1; }

        .risk-table td:nth-child(3)::before,
        .risk-table td:nth-child(4)::before,
        .risk-table td:nth-child(5)::before,
        .risk-table td:nth-child(6)::before {
          display: block;
          margin-bottom: 0.2rem;
          font-size: 0.65rem;
          text-transform: uppercase;
          letter-spacing: 0.06em;
          color: rgba(253, 251, 249, 0.45);
        }

        .risk-table td:nth-child(3)::before { content: 'Probability'; }
        .risk-table td:nth-child(4)::before { content: 'Impact'; }
        .risk-table td:nth-child(5)::before { content: 'Grade'; }
        .risk-table td:nth-child(6)::before { content: 'Mitigation'; }
        .risk-table td:nth-child(6) { margin-top: 0.4rem; }
      }

      /* Success metrics ------------------------------------------------------ */
      .metrics-hero {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem 2.5rem;
        align-items: center;
        margin-top: clamp(1.5rem, 4vw, 2.5rem);
        padding: clamp(1.75rem, 4vw, 3rem);
        background: #00579d;
        border-radius: 1.25rem;
        color: #fdfbf9;
      }

      .metrics-section .metrics-hero-num {
        margin: 0;
        max-width: none;
        font-family: var(--font-display);
        font-size: clamp(4.5rem, 16vw, 9rem);
        line-height: 0.9;
        color: #fdfbf9;
      }

      .metrics-section .metrics-hero-title {
        margin: 0 0 0.5rem;
        font-family: var(--font-body);
        font-weight: 800;
        font-size: 1.25rem;
        color: #fdfbf9;
      }

      .metrics-section .metrics-hero-text p:not(.metrics-hero-title) {
        margin: 0;
        max-width: none;
        font-size: 1rem;
        line-height: 1.6;
        color: rgba(253, 251, 249, 0.85);
        text-align: left;
      }

      @media (min-width: 800px) {
        .metrics-hero { grid-template-columns: auto 1fr; }
      }

      .metrics-section .metrics-sublabel {
        margin: clamp(2rem, 5vw, 3rem) 0 0.75rem;
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #00579d;
      }

      .roadmap {
        list-style: none;
        position: relative;
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
        margin: 0;
        padding: 0 0 0 1.5rem;
        border-left: 2px solid var(--line);
      }

      .roadmap-step {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        outline: none;
      }

      .roadmap-dot {
        position: absolute;
        left: calc(-1.5rem - 7px);
        top: 0.3rem;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #ffffff;
        border: 2px solid #00579d;
        transition: background 0.25s ease, transform 0.25s ease;
      }

      .roadmap-when {
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--ink-faint);
      }

      .roadmap-label {
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 0.95rem;
        color: var(--ink-soft);
        transition: color 0.25s ease;
      }

      .roadmap-step:hover .roadmap-dot,
      .roadmap-step:focus-visible .roadmap-dot {
        background: #00579d;
        transform: scale(1.35);
      }

      .roadmap-step:hover .roadmap-label,
      .roadmap-step:focus-visible .roadmap-label {
        color: var(--ink);
      }

      @media (min-width: 900px) {
        .roadmap {
          grid-template-columns: repeat(6, 1fr);
          gap: 1rem;
          padding: 1.75rem 0 0;
          border-left: 0;
          border-top: 2px solid var(--line);
        }
        .roadmap-dot {
          left: 0;
          top: -8px;
        }
      }

      .metric-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
      }

      .metric-card {
        border: 1px solid var(--line);
        border-radius: 1rem;
        padding: 1.5rem;
      }

      .metrics-section .metric-name {
        margin: 0 0 1rem;
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 0.95rem;
        color: var(--ink);
      }

      .metric-stage + .metric-stage {
        margin-top: 1.1rem;
      }

      .metric-stage-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.4rem;
      }

      .metric-when {
        font-family: var(--font-body);
        font-size: 0.8rem;
        color: var(--ink-faint);
      }

      .metric-value {
        font-family: var(--font-display);
        font-size: 1.6rem;
        line-height: 1;
        color: #00579d;
      }

      .metric-track {
        position: relative;
        height: 10px;
        border-radius: 999px;
        background: var(--bg-soft);
        overflow: hidden;
      }

      .metric-fill {
        position: absolute;
        top: 0;
        left: 0;
        height: 100%;
        width: var(--w);
        background: #00579d;
        transform-origin: left center;
        transform: scaleX(0);
        transition: transform 1s var(--ease-out) 0.15s;
      }

      .metric-fill-range {
        left: var(--l);
        background: repeating-linear-gradient(135deg, rgba(0, 87, 157, 0.55) 0 4px, rgba(0, 87, 157, 0.25) 4px 8px);
        transition-delay: 0.5s;
      }

      .metrics-in .metric-fill { transform: scaleX(1); }

      .metric-card-tile {
        display: flex;
        flex-direction: column;
      }

      .metrics-section .metric-big {
        margin: 0 0 0.75rem;
        max-width: none;
        font-family: var(--font-display);
        font-size: clamp(2.5rem, 6vw, 3.5rem);
        line-height: 1;
        color: #00579d;
      }

      .metric-dots {
        list-style: none;
        display: flex;
        gap: 0.5rem;
        margin: 0 0 0.75rem;
        padding: 0;
      }

      .metric-dots li {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: #00579d;
        transform: scale(0);
        transition: transform 0.5s var(--ease-out);
      }

      .metrics-in .metric-dots li:nth-child(1) { transform: scale(1); transition-delay: 0.2s; }
      .metrics-in .metric-dots li:nth-child(2) { transform: scale(1); transition-delay: 0.45s; }
      .metrics-in .metric-dots li:nth-child(3) { transform: scale(1); transition-delay: 0.7s; }

      .metrics-section .metric-note {
        margin: 0.75rem 0 0;
        max-width: none;
        font-size: 0.85rem;
        color: var(--ink-faint);
        text-align: left;
      }

      @media (min-width: 800px) {
        .metric-grid { grid-template-columns: 1fr 1fr; }
      }

      .indicator-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
      }

      .indicator {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.7em 1.1em;
        border-radius: 999px;
        background: rgba(0, 87, 157, 0.08);
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--ink);
      }

      .indicator-pulse {
        position: relative;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #00579d;
      }

      .indicator-pulse::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: 50%;
        background: #00579d;
        animation: indicator-ping 1.8s ease-out infinite;
      }

      @keyframes indicator-ping {
        from { transform: scale(1); opacity: 0.6; }
        to { transform: scale(3); opacity: 0; }
      }

      .metrics-section .indicator-note {
        margin: 0.9rem 0 0;
        max-width: none;
        font-size: 0.9rem;
        color: var(--ink-faint);
        text-align: left;
      }

      @media (prefers-reduced-motion: reduce) {
        .metric-fill, .metric-dots li { transition: none; transform: none; }
        .indicator-pulse::after { animation: none; }
      }

      /* Footer -------------------------------------------------------- */
      .footer { text-align: center; }

      .footer-heading {
        color: var(--bg);
        font-size: clamp(2.5rem, 7vw, 4.5rem);
        font-family: var(--font-display);
        font-weight: 400;
      }

      .footer-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1rem;
        margin: 1.5rem 0 2rem;
      }

      .footer .btn-pill { border-color: var(--bg); color: var(--bg); }
      .footer .btn-pill-solid { background: var(--bg); color: var(--ink); }

      .footer-social {
        color: rgba(253, 251, 249, 0.7);
        font-family: var(--font-body);
        font-weight: 600;
        text-decoration: none;
      }
    </style>
  </body>
</html>
