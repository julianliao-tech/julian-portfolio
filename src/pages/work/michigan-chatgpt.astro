      }

      /* Hero banner ------------------------------------------------------- */
      .hero-banner {
        aspect-ratio: 2600 / 954;
        overflow: hidden;
      }

      .hero-banner img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
      }

      /* Marquee ----------------------------------------------------------- */
      .marquee-section {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-around;
        min-height: clamp(380px, 48vw, 640px);
        padding-block: clamp(2.5rem, 6vw, 4rem);
        overflow: hidden;
        background: #ffffff;
      }

      .marquee-row {
        overflow: hidden;
        white-space: nowrap;
      }

      .marquee-track {
        display: inline-flex;
        width: max-content;
      }

      .marquee-track span {
        display: inline-block;
        padding-inline: 1.5rem;
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(1.4rem, 4.2vw, 2.6rem);
        color: #00274c;
        white-space: nowrap;
      }

      .marquee-row:nth-child(odd) .marquee-track span {
        color: #ffcb05;
        -webkit-text-stroke: 1px #00274c;
      }

      .marquee-track-left {
        animation: marquee-left 32s linear infinite;
      }

      .marquee-track-right {
        animation: marquee-right 32s linear infinite;
      }

      @keyframes marquee-left {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
      }

      @keyframes marquee-right {
        from { transform: translateX(-50%); }
        to { transform: translateX(0); }
      }

      .marquee-laptop {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 5;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .laptop-frame {
        width: clamp(260px, 32vw, 460px);
        aspect-ratio: 1954 / 1272;
        border: 3px solid var(--ink);
        border-radius: 0.75rem;
        padding: 0;
        background: #ffffff;
        overflow: hidden;
      }

      .laptop-frame .placeholder {
        height: 100%;
        aspect-ratio: auto;
        border-radius: 0.4rem;
      }

      .laptop-frame video {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .laptop-base {
        width: 106%;
        height: 12px;
        background: var(--ink);
        border-radius: 0 0 8px 8px;
        margin-top: -1px;
        position: relative;
      }

      .laptop-base::before {
        content: '';
        position: absolute;
        left: 50%;
        top: 0;
        transform: translateX(-50%);
        width: 15%;
        height: 4px;
        background: #ffffff;
        border-radius: 0 0 4px 4px;
      }

      @media (prefers-reduced-motion: reduce) {
        .marquee-track-left,
        .marquee-track-right {
          animation: none;
        }
      }

      /* Head block -------------------------------------------------------- */
      .head-block {
        padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 5vw, 3rem);
      }

      .head-top {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
        align-items: start;
        margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
      }

      .title {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(3rem, 9vw, 6rem);
        letter-spacing: -0.01em;
        line-height: 0.98;
        color: var(--ink);
        margin: 0;
      }

      .context-box {
        background: transparent;
        border-left: 3px solid var(--line-strong);
        padding-left: 1.25rem;
      }

      .context-label {
        margin: 0 0 0.35rem;
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--ink-faint);
      }

      .context-heading {
        margin: 0 0 0.5rem;
        font-family: var(--font-display);
        font-weight: 400;
        font-size: 1.3rem;
        color: var(--ink);
      }

      .context-box p:not(.context-label) {
        margin: 0;
        max-width: none;
        font-size: 1rem;
        line-height: 1.6;
        color: var(--ink-soft);
      }

      .context-box strong {
        color: var(--ink);
        font-weight: 700;
      }

      @media (min-width: 800px) {
        .head-top { grid-template-columns: auto 1fr; gap: 2.5rem; }
      }

      .meta {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
        gap: 1.5rem;
        padding-bottom: clamp(1.5rem, 4vw, 2.5rem);
        border-bottom: 1px solid var(--line);
        margin: 0 0 clamp(1.5rem, 4vw, 2.5rem);
      }

      .meta dt {
        font-family: var(--font-body);
        font-size: 0.8rem;
        color: var(--ink-faint);
        margin-bottom: 0.35rem;
      }

      .meta dd {
        margin: 0;
        font-family: var(--font-body);
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.9rem;
        color: var(--ink);
      }

      .meta dd span {
        display: block;
      }

      .intro {
        font-size: 1rem;
        line-height: 1.6;
        color: var(--ink-soft);
        max-width: none;
        text-align: justify;
        text-align-last: left;
        hyphens: auto;
      }

      .intro strong {
        color: var(--ink);
        font-weight: 700;
      }

      .pull-quote {
        position: relative;
        max-width: none;
        font-family: var(--font-serif);
        font-weight: 400;
        font-size: clamp(1.6rem, 3.4vw, 2.4rem);
        line-height: 1.4;
        color: var(--ink-faint);
        margin-top: clamp(1.5rem, 4vw, 2.5rem);
        text-align: center;
      }

      .pull-quote-highlight {
        color: #00274c;
        font-weight: 700;
        box-shadow: inset 0 -0.35em 0 rgba(255, 203, 5, 0.35);
      }

      .pull-quote[data-typewriter]::after {
        content: '';
        display: inline-block;
        width: 2px;
        height: 1em;
        margin-left: 2px;
        background: currentColor;
        vertical-align: text-bottom;
        animation: pull-quote-blink 0.9s steps(1) infinite;
      }

      @keyframes pull-quote-blink {
        50% { opacity: 0; }
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      @media (prefers-reduced-motion: reduce) {
        .pull-quote[data-typewriter]::after {
          animation: none;
        }
      }

      /* Location band ------------------------------------------------------- */
      .stat-band {
        background: #00274c;
        color: #fdfbf9;
        padding-block: clamp(2.5rem, 6vw, 4rem);
      }

      .location-block {
        text-align: center;
        padding-inline: clamp(1.25rem, 5vw, 3.5rem);
      }

      .location-label {
        margin: 0 0 0.5rem;
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #fdfbf9;
      }

      .location-name {
        margin: 0;
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(2rem, 6vw, 3.5rem);
        line-height: 1.1;
        color: #fdfbf9;
      }

      /* Dark / white blocks ---------------------------------------------- */
      .dark-block {
        background: var(--ink);
        color: var(--bg);
        padding-block: clamp(3rem, 7vw, 5rem);
      }

      .white-block {
        padding-block: clamp(2.5rem, 6vw, 4rem);
      }

      .white-block-flush-bottom {
        padding-bottom: 0;
      }

      .white-block-flush-top {
        padding-top: 0;
      }

      .white-block h2,
      .dark-block h2 {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(1.9rem, 4vw, 2.8rem);
        letter-spacing: -0.01em;
        margin: 0 0 0.6rem;
      }

      .white-block h2 { color: var(--ink); }
      .dark-block h2 { color: var(--bg); }

      .white-block p,
      .dark-block .wrap > p:not(.reflect-subhead) {
        max-width: none;
        font-size: 1rem;
        line-height: 1.6;
        text-align: justify;
        text-align-last: left;
        hyphens: auto;
      }

      .white-block p { color: var(--ink-soft); }
      .dark-block .wrap > p:not(.reflect-subhead) { color: rgba(253, 251, 249, 0.7); }

      .white-block strong { color: var(--ink); font-weight: 700; }
      .white-block em { color: var(--ink); font-style: italic; }
      .dark-block strong { color: var(--bg); font-weight: 700; }
      .dark-block em { color: var(--bg); font-style: italic; }

      .reflect-subhead {
        margin: 1.5rem 0 0.75rem;
        font-family: var(--font-body);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.8rem;
        color: rgba(253, 251, 249, 0.5);
      }

      .reflect-subhead:first-of-type { margin-top: 0; }

      .findings-list {
        margin: 1rem 0 0;
        padding-left: 1.25rem;
        max-width: none;
      }

      .findings-list li {
        font-size: 1rem;
        line-height: 1.6;
        color: var(--ink-soft);
        margin-bottom: 0.4rem;
      }

      .findings-list-dark li {
        color: rgba(253, 251, 249, 0.7);
      }

      .visitor-needs {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px dashed var(--line);
      }

      .visitor-heading {
        margin: 0;
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 1rem;
        color: #00274c;
      }

      @media (min-width: 700px) {
        .visitor-needs { grid-template-columns: 1fr 1fr; }
      }

      .eyebrow-label {
        font-family: var(--font-body);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #00274c;
        margin: 0 0 0.75rem;
        font-size: 0.85rem;
      }

      /* Images ------------------------------------------------------------ */
      .image-row {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
        margin-top: clamp(1.5rem, 4vw, 2.5rem);
      }

      .image-row img {
        display: block;
        width: 100%;
      }

      @media (min-width: 700px) {
        .image-row-detail { grid-template-columns: 1fr 1fr; }
      }

      .image-row-single {
        margin-top: clamp(1.5rem, 4vw, 2.5rem);
      }

      .image-row-single-flush {
        margin-top: 0.35rem;
      }

      .image-row-single-zero {
        margin-top: 0;
      }

      .image-row-single-wide {
        max-width: 56rem;
        margin-inline: auto;
      }

      .image-row-single img {
        display: block;
        width: 100%;
      }

      .placeholder {
        display: grid;
        place-items: center;
        aspect-ratio: 21 / 9;
        border: 1px dashed var(--line-strong);
        background: #ffffff;
        color: var(--ink-faint);
        font-family: var(--font-body);
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      /* Challenge cards --------------------------------------------------- */
      .challenge-head {
        display: flex;
        flex-direction: column;
        gap: 1.1rem;
        margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
      }

      .challenge-head .quirky {
        margin-top: -0.2rem;
      }

      .challenge-head h2 {
        color: var(--bg);
        margin: 0;
      }

      .quirky {
        font-family: var(--font-quirky);
        font-size: 1.2rem;
        color: #ffcb05;
        transform: rotate(-3deg);
        display: inline-block;
      }

      .quirky-tight {
        margin-top: 6rem;
        margin-bottom: 0.15rem;
      }

      .challenge-grid {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
      }

      .challenge-card {
        --tilt-x: 0deg;
        --tilt-y: 0deg;
        border: 1px solid rgba(253, 251, 249, 0.15);
        border-left: 3px solid rgba(253, 251, 249, 0.15);
        padding: 1.5rem;
        background: rgba(253, 251, 249, 0.03);
        transform: perspective(700px) rotateX(var(--tilt-x)) rotateY(var(--tilt-y));
        transition: background 0.3s ease, border-color 0.3s ease, transform 0.3s var(--ease-out);
      }

      .challenge-card p {
        margin: 0.75rem 0 0;
        max-width: none;
        color: rgba(253, 251, 249, 0.45);
        font-size: 1rem;
        line-height: 1.6;
      }

      .challenge-num {
        font-family: var(--font-body);
        font-weight: 800;
        font-size: 1.5rem;
        color: rgba(253, 251, 249, 0.35);
      }

      .challenge-card.is-active {
        background: rgba(253, 251, 249, 0.08);
        border-color: rgba(253, 251, 249, 0.3);
        border-left-color: #ffcb05;
      }

      .challenge-card.is-active .challenge-num { color: #ffcb05; }

      .challenge-card.is-active p {
        color: var(--bg);
        font-weight: 500;
      }

      @media (min-width: 700px) {
        .challenge-grid-4 { grid-template-columns: repeat(3, 1fr); }
      }

      /* Feature bands (brand-color, full-bleed) --------------------------- */
      .feature-band {
        display: grid;
        grid-template-columns: 1fr;
      }

      .feature-band-maize { background: #ffcb05; }
      .feature-band-navy { background: #00274c; }

      .feature-media img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      /* Laptop + mobile mockups shown side by side instead of stacked in
         separate sections — the mobile shot gets a narrower share since
         it's naturally portrait next to the laptop's landscape shot.
         Real product screenshots use object-fit: contain (not cover) and
         a capped height so the full screen is always visible instead of
         being cropped, and so the whole section stays comfortably in
         view rather than stretching to fill the row. */
      .feature-media-pair {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        padding: 1.5rem;
        max-height: clamp(260px, 38vw, 440px);
      }

      .feature-media-pair img,
      .feature-media-pair video {
        flex: 1 1 0;
        min-width: 0;
        min-height: 0;
        width: auto;
        height: 100%;
        max-width: 100%;
        object-fit: contain;
      }

      @media (min-width: 500px) {
        .feature-media-pair {
          flex-direction: row;
        }

        .feature-media-pair .feature-media-mobile {
          flex: 0 0 34%;
        }
      }

      .feature-text {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: clamp(2rem, 5vw, 3.5rem);
      }

      .feature-heading {
        font-family: var(--font-serif);
        font-weight: 400;
        font-style: italic;
        font-size: clamp(1.6rem, 3vw, 2.1rem);
        margin: 0 0 0.6rem;
      }

      .feature-band-maize .feature-heading { color: #00274c; }
      .feature-band-navy .feature-heading { color: #ffcb05; }

      .feature-text p {
        margin: 0;
        max-width: none;
        font-size: 1rem;
        line-height: 1.6;
      }

      .feature-band-maize .feature-text p { color: rgba(0, 39, 76, 0.75); }
      .feature-band-navy .feature-text p { color: rgba(255, 255, 255, 0.75); }

      .feature-band-maize .feature-text strong { color: #00274c; }
      .feature-band-navy .feature-text strong { color: #ffffff; }
      .feature-band-maize .feature-text em { color: #00274c; }
      .feature-band-navy .feature-text em { color: #ffcb05; }

      @media (min-width: 800px) {
        .feature-band { grid-template-columns: 1fr 1fr; }
        .feature-band-reverse .feature-media { order: 2; }
        .feature-band-reverse .feature-text { order: 1; }
      }

      /* Up next --------------------------------------------------------------- */
      .up-next { padding-block: clamp(3rem, 7vw, 5rem); }

      .up-next-row {
        --tilt-x: 0deg;
        --tilt-y: 0deg;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1.5rem;
        margin-top: 1rem;
        text-decoration: none;
      }

      .up-next-row img {
        width: 100px;
        aspect-ratio: 1;
        object-fit: cover;
        border: 1px solid var(--line);
        transform: perspective(700px) rotateX(var(--tilt-x)) rotateY(var(--tilt-y));
        transition: transform 0.3s var(--ease-out);
      }

      .up-next-row h2 {
        margin: 0;
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(1.6rem, 4vw, 2.2rem);
        color: var(--ink);
      }

      .up-next-row p {
        margin: 0.25rem 0 0;
        color: var(--ink-faint);
        font-size: 0.9rem;
      }

      .btn-outline {
        margin-left: auto;
        border: 1px solid var(--ink);
        border-radius: 999px;
        padding: 0.5em 1.2em;
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--ink);
      }

      /* The Brand / Digital Presence ---------------------------------------- */
      .brand-section {
        position: relative;
        background:
          repeating-linear-gradient(to right, var(--line) 0 1px, transparent 1px 8.333%),
          repeating-linear-gradient(to bottom, var(--line) 0 1px, transparent 1px 64px),
          #ffffff;
        padding-block: clamp(3rem, 7vw, 5rem);
        overflow: hidden;
      }

      .brand-intro {
        position: relative;
        margin-bottom: clamp(2.5rem, 6vw, 4rem);
      }

      .brand-heading {
        margin: 0.5rem 0 0;
        font-family: var(--font-body);
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 0.95;
        font-size: clamp(3rem, 9vw, 6.5rem);
        color: #000000;
      }

      .brand-intro .eyebrow-label {
        color: #000000;
      }

      .brand-showcase-row {
        position: relative;
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
        align-items: center;
        margin-bottom: clamp(2rem, 5vw, 3rem);
      }

      .brand-showcase-row:last-child {
        margin-bottom: 0;
      }

      /* A real phone shell — bezel + notch — noticeably smaller than the
         laptop shell below it, matching real device proportions. */
      .brand-phone-frame {
        position: relative;
        justify-self: center;
        width: clamp(150px, 17vw, 210px);
        aspect-ratio: 804 / 1434;
        border: 3px solid var(--ink);
        border-radius: 1.75rem;
        overflow: hidden;
        background: #ffffff;
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.12);
      }

      .brand-phone-frame::before {
        content: '';
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 38%;
        height: 16px;
        background: var(--ink);
        border-radius: 0 0 10px 10px;
        z-index: 2;
      }

      .brand-phone-frame img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      /* Reuses the same laptop-frame / laptop-base shell built for the
         marquee video, just wider than the phone above. */
      .brand-laptop-shell {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
      }

      .brand-laptop-frame {
        width: 100%;
        max-width: clamp(280px, 36vw, 460px);
        aspect-ratio: 1600 / 1043;
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.12);
      }

      .brand-laptop-frame img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .brand-laptop-shell .laptop-base {
        max-width: clamp(297px, 38.2vw, 488px);
      }

      .brand-spec-card {
        background: #101010;
        color: #fdfbf9;
        padding: clamp(1.75rem, 4vw, 2.5rem);
        border-radius: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: clamp(1.5rem, 4vw, 2.25rem);
        justify-content: center;
      }

      .spec-row {
        display: flex;
        flex-wrap: wrap;
        gap: clamp(1.75rem, 5vw, 3.5rem);
      }

      .spec-item {
        flex: 0 0 auto;
        min-width: 70px;
      }

      .spec-label {
        margin: 0 0 0.5rem;
        font-family: var(--font-body);
        font-size: 1rem;
        color: rgba(253, 251, 249, 0.5);
      }

      .spec-value {
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 1.4rem;
        color: #fdfbf9;
      }

      .spec-swatch {
        display: inline-block;
        width: 14px;
        height: 14px;
        border-radius: 3px;
        flex-shrink: 0;
      }

      @media (min-width: 800px) {
        .brand-showcase-row { grid-template-columns: 1fr 1fr; }
        .brand-phone-frame { justify-self: center; }
      }

      /* Footer ------------------------------------------------------------------ */
      .footer { text-align: center; }

      .footer-heading {
        color: var(--bg);
        font-size: clamp(2.5rem, 7vw, 4.5rem);
        font-family: var(--font-display);
        font-weight: 400;
      }

      .footer-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1rem;
        margin: 1.5rem 0 2rem;
      }

      .footer .btn-pill { border-color: var(--bg); color: var(--bg); }
      .footer .btn-pill-solid { background: var(--bg); color: var(--ink); }

      .footer-social {
        color: rgba(253, 251, 249, 0.7);
        font-family: var(--font-body);
        font-weight: 600;
        text-decoration: none;
      }
    </style>
  </body>
</html>
