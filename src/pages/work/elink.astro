    <script>
      import '../../scripts/site.js';

      const btn = document.querySelector('[data-copy-email]');
      btn?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText('julianliaowork@gmail.com');
          const original = btn.textContent;
          btn.textContent = 'Copied!';
          setTimeout(() => { btn.textContent = original; }, 1500);
        } catch {
          window.location.href = 'mailto:julianliaowork@gmail.com';
        }
      });

      // Belt-and-suspenders autoplay, same as the other format tests.
      document.querySelectorAll<HTMLVideoElement>('.laptop-frame video, .wide-video video').forEach((v) => {
        v.play().catch(() => {});
      });

      // Typewriter effect on the pull-quote — types each segment in order
      // (plain text, then the highlighted phrase, then the trailing plain
      // text) once the quote scrolls into view. Reduced-motion and
      // no-IntersectionObserver both fall back to showing the full text.
      const quoteEl = document.querySelector<HTMLElement>('[data-typewriter]');
      if (quoteEl) {
        const segments = Array.from(quoteEl.querySelectorAll<HTMLElement>('.tw-seg'));
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const typeSegments = () => {
          let segIndex = 0;
          let charIndex = 0;
          const step = () => {
            if (segIndex >= segments.length) return;
            const seg = segments[segIndex];
            const full = seg.dataset.full ?? '';
            if (charIndex <= full.length) {
              seg.textContent = full.slice(0, charIndex);
              charIndex++;
              setTimeout(step, 28);
            } else {
              segIndex++;
              charIndex = 0;
              setTimeout(step, 28);
            }
          };
          step();
        };

        if (reduced || !('IntersectionObserver' in window)) {
          segments.forEach((seg) => { seg.textContent = seg.dataset.full ?? ''; });
        } else {
          const io = new IntersectionObserver((entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                typeSegments();
                obs.disconnect();
              }
            });
          }, { threshold: 0.4 });
          io.observe(quoteEl);
        }
      }

      // Success metrics — when the block scrolls into view, bars grow and
      // numbers count up. No-JS / reduced motion just shows the final state.
      const metricsEl = document.querySelector<HTMLElement>('[data-metrics]');
      if (metricsEl) {
        const reducedMetrics = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const counters = Array.from(metricsEl.querySelectorAll<HTMLElement>('[data-count]'));
        const run = () => {
          metricsEl.classList.add('metrics-in');
          counters.forEach((c) => {
            const to = Number(c.dataset.count);
            const start = performance.now();
            const dur = 1200;
            const tickCount = (now: number) => {
              const t = Math.min(1, (now - start) / dur);
              c.textContent = String(Math.round(to * (1 - Math.pow(1 - t, 3))));
              if (t < 1) requestAnimationFrame(tickCount);
            };
            c.textContent = '0';
            requestAnimationFrame(tickCount);
          });
        };
        if (reducedMetrics || !('IntersectionObserver' in window)) {
          metricsEl.classList.add('metrics-in');
        } else {
          const ioMetrics = new IntersectionObserver((entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                run();
                obs.disconnect();
              }
            });
          }, { threshold: 0.25 });
          ioMetrics.observe(metricsEl);
        }
      }

      // Before/after slider — the transparent range input sits over the
      // frame, so mouse, touch, and keyboard all drive the same --pos value.
      document.querySelectorAll<HTMLElement>('[data-compare]').forEach((el) => {
        const range = el.querySelector<HTMLInputElement>('.compare-range');
        if (!range) return;
        const update = () => el.style.setProperty('--pos', `${range.value}%`);
        range.addEventListener('input', update);
        update();
      });

      // 3D photo carousel — continuous auto-rotate via rAF, with pointer
      // drag to spin manually (resumes auto-rotating a moment after
      // release). Reduced motion: render one static frame.
      const stage = document.querySelector<HTMLElement>('[data-carousel]');
      const ring = document.querySelector<HTMLElement>('[data-ring]');
      if (stage && ring) {
        const reducedCarousel = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let angle = 0;
        let dragging = false;
        let lastX = 0;
        let velocity = 0;
        let resumeAt = 0;
        const AUTO_SPEED = 6; // deg/sec

        const applyRing = () => {
          ring.style.transform = `rotateY(${angle}deg)`;
        };
        applyRing();

        if (!reducedCarousel) {
          let last = performance.now();
          const tick = (now: number) => {
            const dt = (now - last) / 1000;
            last = now;
            if (dragging) {
              // handled in pointermove
            } else if (now < resumeAt) {
              angle += velocity * dt;
              velocity *= 0.94;
            } else {
              angle += AUTO_SPEED * dt;
            }
            applyRing();
            requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);

          stage.addEventListener('pointerdown', (e) => {
            dragging = true;
            lastX = e.clientX;
            stage.setPointerCapture(e.pointerId);
          });
          stage.addEventListener('pointermove', (e) => {
            if (!dragging) return;
            const dx = e.clientX - lastX;
            lastX = e.clientX;
            const delta = dx * 0.3;
            angle += delta;
            velocity = delta * 6;
            applyRing();
          });
          const releaseCarousel = () => {
            if (!dragging) return;
            dragging = false;
            resumeAt = performance.now() + 900;
          };
          stage.addEventListener('pointerup', releaseCarousel);
          stage.addEventListener('pointerleave', releaseCarousel);
        }
      }
    </script>

