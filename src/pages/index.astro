---
import { existsSync } from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const sortedProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
// Michigan ChatGPT leads the grid as a standalone, highlighted feature —
// everything else keeps its normal order behind it.
const projects = [
  ...sortedProjects.filter((p) => p.id === 'michigan-chatgpt'),
  ...sortedProjects.filter((p) => p.id !== 'michigan-chatgpt'),
];

const consultingWork = {
  slug: 'consulting-work',
  title: 'Consulting Work',
  tileImage: `${base}images/home/tile-consulting-work.webp`,
  tileAlt: 'Consulting project thumbnails: Q-Bakehouse and MCBC Pink Moon',
};

// Opt-in, zero-config hover video: drop `tile-<slug>.mp4` next to the
// existing `tile-<slug>.webp` in public/images/home/ and it's picked
// up automatically — no frontmatter or code change needed per
// project. Nothing renders a video until that file actually exists.
const homeImagesDir = path.join(process.cwd(), 'public', 'images', 'home');
const hoverVideo = (slug: string) => {
  const file = `tile-${slug}.mp4`;
  return existsSync(path.join(homeImagesDir, file)) ? `${base}images/home/${file}` : null;
};

const cards = [
  ...projects.map((p) => ({
    href: `${base}work/${p.id}/`,
    title: p.data.title,
    image: p.data.tileImage,
    alt: p.data.tileAlt,
    video: hoverVideo(p.id),
  })),
  {
    href: `${base}work/${consultingWork.slug}/`,
    title: consultingWork.title,
    image: consultingWork.tileImage,
    alt: consultingWork.tileAlt,
    video: hoverVideo(consultingWork.slug),
  },
];

const pad = (n: number) => String(n).padStart(2, '0');

// Real skills, pulled from every case study's own frontmatter — not a
// separate hand-maintained list — for the marquee strip below.
const skillsTicker = Array.from(new Set(projects.flatMap((p) => p.data.skills))).sort();
---
<BaseLayout title="Julian Liao — UX Designer">
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="eyebrow rise" style="--d: 40ms">UX Designer</p>
        <h1 class="hero-title">
          <span class="line">
            <span class="word rise" style="--d: 100ms">Hello,</span> <span class="word rise" style="--d: 160ms">I'm</span>
          </span>{' '}
          <span class="line">
            <span class="word rise" style="--d: 220ms">Julian</span> <span class="word rise" style="--d: 280ms"><span class="wave" aria-hidden="true">👋</span></span>
          </span>
        </h1>
        <p class="hero-sub rise" style="--d: 300ms">
          UX designer focused on <em class="serif">intuitive</em> and{' '}
          <em class="serif">accessible</em> user experiences.
        </p>
        <p class="hero-school rise" style="--d: 380ms">
          <span class="pip" aria-hidden="true"></span>Student @ The University of Michigan
        </p>
      </div>

      <div class="hero-portrait rise" style="--d: 300ms">
        <div class="portrait-float" data-parallax="0.05">
          <div class="portrait-ring" aria-hidden="true"></div>
          <img
            src={`${base}images/home/profile-illustration.webp`}
            alt="Illustrated portrait of Julian Liao"
            width="136"
            height="204"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>

    <a class="scroll-cue rise" style="--d: 620ms" href="#work">
      <span>Scroll</span>
      <span class="cue-rail" aria-hidden="true"><span class="cue-dot"></span></span>
    </a>
  </section>

  <section id="work" class="work wrap">
    <div class="section-head" data-reveal>
      <h2>
        Pro<span class="j-hop">j<span class="lamp-jump" aria-hidden="true">
          <svg class="lamp-icon" viewBox="0 0 40 60" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M6 4 26 4 19 17 13 17Z" fill="currentColor" />
            <circle cx="16" cy="19" r="3" fill="currentColor" />
            <path d="M16 19 21 34" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
            <circle cx="21" cy="34" r="3" fill="currentColor" />
            <path d="M21 34 15 49" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
            <ellipse cx="15" cy="53" rx="9" ry="3.5" fill="currentColor" />
          </svg>
        </span></span>ects
      </h2>
      <span class="section-count" data-count-to={cards.length}>{pad(cards.length)}</span>
    </div>

    <ol class="work-grid">
      {cards.map((card, i) => {
        const isFeatured = i === 0;
        const isLarge = !isFeatured && (i - 1) % 4 === 0;
        return (
          <li
            class:list={['bento-item', { 'is-featured': isFeatured, 'is-large': isLarge }]}
            data-reveal
            data-reveal-delay={isFeatured ? 0 : (i % 2) * 90}
          >
            <a class="card" href={card.href}>
              <span class="card-media" data-tilt style={`--card-i: ${i}`}>
                {card.video ? (
                  <video
                    class="reveal-zoom"
                    data-hover-video
                    src={card.video}
                    poster={card.image}
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    aria-hidden="true"
                  />
                ) : (
                  <img class="reveal-zoom" src={card.image} alt={card.alt} loading="lazy" decoding="async" />
                )}
                {isFeatured && <span class="featured-badge">Featured</span>}
              </span>
              <span class="card-foot">
                <span class="card-index" data-count-to={i + 1}>{pad(i + 1)}</span>
                <span class="card-title">{card.title}</span>
                <span class="card-arrow" data-magnetic aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M7 17 17 7M9 7h8v8"/></svg>
                </span>
              </span>
            </a>
          </li>
        );
      })}
    </ol>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[...skillsTicker, ...skillsTicker].map((skill) => (
        <span class="marquee-item">{skill}</span>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  /* Hero ---------------------------------------------------------- */
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(1.25rem, 3vw, 2rem) clamp(1rem, 2vw, 1.5rem);
    overflow: hidden;
  }

  .hero-inner {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
    align-items: center;
  }

  .hero-title {
    font-size: clamp(2rem, 5vw, 4.25rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0 0 var(--space-2);
  }

  .hero-title .line {
    display: inline;
  }

  .wave {
    display: inline-block;
    transform-origin: 70% 70%;
    animation: wave 2.8s var(--ease) 1.2s 2;
  }

  @keyframes wave {
    0%, 60%, 100% { transform: rotate(0deg); }
    10% { transform: rotate(14deg); }
    20% { transform: rotate(-8deg); }
    30% { transform: rotate(14deg); }
    40% { transform: rotate(-4deg); }
    50% { transform: rotate(10deg); }
  }

  .hero-sub {
    font-size: clamp(0.9rem, 1.3vw, 1.1rem);
    line-height: 1.35;
    color: var(--ink);
    max-width: none;
    margin-bottom: var(--space-2);
  }

  .hero-sub em {
    color: var(--accent);
    font-size: 1.1em;
  }

  /* Underline bar (base styling in global.css) sweeps in after the
     rest of the hero has settled. */
  .hero-sub em::after {
    animation: sweep-in 0.6s var(--ease-out) both;
    animation-delay: 1s;
  }

  .hero-sub em:nth-of-type(2)::after {
    animation-delay: 1.2s;
  }

  .hero-school {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--step-micro);
    color: var(--ink-soft);
    margin: 0;
    padding: 0.35rem 0.85rem 0.35rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: var(--r-full);
    background: rgba(16, 16, 16, 0.03);
  }

  .pip {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  /* The illustration is a transparent cut-out, so it sits straight on
     the page with a warm glow behind it rather than in a frame. */
  .hero-portrait {
    width: min(110px, 24vw);
    justify-self: start;
  }

  .portrait-float {
    position: relative;
    will-change: transform;
  }

  .hero-portrait img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
  }

  .portrait-ring {
    position: absolute;
    inset: -28% -34%;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 45%, var(--accent-soft), transparent 64%);
    filter: blur(22px);
  }

  .scroll-cue {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: clamp(0.75rem, 2vw, 1.25rem);
    margin-left: var(--gutter);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--step-micro);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-faint);
    text-decoration: none;
    transition: color 0.3s var(--ease);
  }

  .scroll-cue:hover { color: var(--ink); }

  .cue-rail {
    position: relative;
    width: 1px;
    height: 20px;
    background: var(--line-strong);
    overflow: hidden;
  }

  .cue-dot {
    position: absolute;
    left: -1px;
    top: 0;
    width: 3px;
    height: 12px;
    border-radius: 2px;
    background: var(--accent);
    animation: cue 2.4s var(--ease) infinite;
  }

  @keyframes cue {
    0% { transform: translateY(-6px); opacity: 0; }
    35% { opacity: 1; }
    100% { transform: translateY(20px); opacity: 0; }
  }

  @media (min-width: 900px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .hero-portrait { justify-self: end; width: min(140px, 12vw); }
  }

  /* Work grid ------------------------------------------------------ */
  .work {
    padding-block: clamp(0.75rem, 2vw, 1.5rem) var(--space-6);
  }

  /* Work grid --------------------------------------------------------
     Bento layout: the featured item (.is-featured) always spans the
     full row; everything else flows through an auto-placed, dense
     grid so a large tile (.is-large, every 4th item) and its
     neighboring small tiles backfill into a single row instead of
     leaving gaps. Thumbnails get an actual radius (unlike the rest
     of the site's zeroed --r-* tokens) so the tiles read as bento
     cards rather than the old flourish-free display grid. */
  .work-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  .bento-item.is-featured {
    grid-column: 1 / -1;
  }

  .card {
    display: block;
    height: 100%;
    text-decoration: none;
  }

  .card-media {
    display: block;
    position: relative;
    overflow: hidden;
    border-radius: clamp(14px, 1.8vw, 22px);
    border: 1px solid var(--line);
    background: var(--bg-elev);
    /* Fixed (not aspect-ratio-driven) so every tile in a bento row —
       whether it's a single-column or a wide .is-large tile — bottoms
       out at the same height instead of the wide tile growing taller
       at 2x the width. */
    height: clamp(220px, 24vw, 340px);
  }

  /* [data-tilt] (see site.js) keeps --tilt-x/y live while the cursor
     moves over the thumbnail, so the screen rotates toward it — the
     card's own device mockup "spins" to follow the pointer. */
  .card-media {
    --tilt-x: 0deg;
    --tilt-y: 0deg;
  }

  /* Idle float -----------------------------------------------------
     Each thumbnail drifts gently on its own at rest — independent of
     the cursor-tilt transform on the image inside it, so the two
     never fight over the `transform` property. A negative delay
     (keyed off --card-i, set inline per card above) starts every
     card mid-cycle instead of in lockstep, so the grid doesn't
     visibly pulse in unison. */
  .card-media {
    animation: card-float 7s ease-in-out infinite;
    animation-delay: calc(var(--card-i, 0) * -1.3s);
  }

  .card:hover .card-media,
  .card:focus-visible .card-media {
    animation-play-state: paused;
  }

  @keyframes card-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  .card-media img,
  .card-media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: perspective(900px) rotateX(var(--tilt-x)) rotateY(var(--tilt-y)) scale(1.04);
    transition: transform 0.6s var(--ease-out), filter 0.6s var(--ease);
  }

  .card:hover .card-media img,
  .card:focus-visible .card-media img,
  .card:hover .card-media video,
  .card:focus-visible .card-media video {
    transform: perspective(900px) rotateX(var(--tilt-x)) rotateY(var(--tilt-y)) scale(1.14);
    transition: transform 0.15s var(--ease-out);
  }

  /* Featured card ---------------------------------------------------
     Michigan ChatGPT stands alone in the top row: a wider frame, an
     accent-tinted border/glow, and a badge instead of just relying on
     grid position to read as "different." */
  .is-featured .card-media {
    height: clamp(320px, 36vw, 480px);
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .featured-badge {
    position: absolute;
    top: clamp(0.85rem, 2vw, 1.25rem);
    left: clamp(0.85rem, 2vw, 1.25rem);
    z-index: 1;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--step-micro);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-ink);
    background: var(--accent);
    padding: 0.4rem 0.75rem;
    border-radius: var(--r-full);
  }

  /* Lamp easter egg ---------------------------------------------------
     A nod to the Pixar hop: a desk lamp hops in from the right, across
     "ects", and lands on the "j" in "Projects" — taking the place of
     its dot, the way Luxo Jr. takes the dot of the "i". .j-hop is the
     positioning anchor (sized to the letter itself, so this scales
     with the heading's responsive font-size); .lamp-jump plays the
     hop-in once, triggered by the same scroll-reveal system as the
     rest of the section (html.js + [data-reveal].is-in), and holds
     its landed position afterward instead of looping. */
  .j-hop {
    position: relative;
    display: inline-block;
  }

  .lamp-jump {
    position: absolute;
    bottom: 70%;
    left: 50%;
    width: clamp(18px, 1.8vw, 26px);
    z-index: 3;
    pointer-events: none;
    transform: translate(calc(-50% + 4.2em), 60%) rotate(-10deg) scaleY(0.9);
    opacity: 0;
    animation: lamp-hop-in 1.8s cubic-bezier(0.32, 0.9, 0.34, 1) 0.3s both;
    animation-play-state: paused;
  }

  html.js .section-head.is-in .lamp-jump {
    animation-play-state: running;
  }

  .lamp-icon {
    display: block;
    width: 100%;
    height: auto;
    color: var(--accent);
    filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.25));
  }

  @keyframes lamp-hop-in {
    0% { transform: translate(calc(-50% + 4.2em), 60%) rotate(-10deg) scaleY(0.9); opacity: 0; }
    6% { opacity: 1; }
    18% { transform: translate(calc(-50% + 2.6em), -140%) rotate(6deg) scaleY(1.05); }
    30% { transform: translate(calc(-50% + 2.6em), 15%) rotate(-4deg) scaleY(0.82); }
    38% { transform: translate(calc(-50% + 2.6em), 0%) rotate(0deg) scaleY(1); }
    55% { transform: translate(calc(-50% + 0.9em), -150%) rotate(5deg) scaleY(1.05); }
    70% { transform: translate(-50%, 10%) rotate(-3deg) scaleY(0.8); }
    80% { transform: translate(-50%, -6%) rotate(2deg) scaleY(1.12); }
    90% { transform: translate(-50%, 1%) rotate(-1deg) scaleY(0.97); }
    100% { transform: translate(-50%, 0%) rotate(0deg) scaleY(1); opacity: 1; }
  }

  .is-featured .card-title {
    font-size: clamp(1.85rem, 3.4vw, 2.75rem);
  }

  .card-foot {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-2);
    padding-top: var(--space-3);
  }

  .card-index {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--step-micro);
    letter-spacing: 0.18em;
    color: var(--ink-faint);
    padding-top: 0.2em;
    align-self: start;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.3vw, 1.85rem);
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--ink);
    transition: color 0.3s var(--ease);
  }

  .card:hover .card-title { color: var(--accent); }

  .card-arrow {
    --magnet-x: 0px;
    --magnet-y: 0px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--ink-soft);
    transform: translate(var(--magnet-x), var(--magnet-y));
    transition: transform 0.45s var(--ease-out), background 0.35s var(--ease),
      color 0.35s var(--ease), border-color 0.35s var(--ease);
  }

  .card:hover .card-arrow {
    transform: translate(calc(var(--magnet-x) + 3px), calc(var(--magnet-y) - 3px));
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
    transition: transform 0.15s var(--ease-out), background 0.35s var(--ease),
      color 0.35s var(--ease), border-color 0.35s var(--ease);
  }

  /* Draws in once the card scrolls into view (li[data-reveal].is-in),
     rather than just appearing with the rest of the card. Gated
     behind html.js — without it .is-in never arrives, so an
     undrawn (all-dashed-out) arrow would otherwise stay invisible. */
  html.js .card-arrow svg path {
    stroke-dasharray: 40;
    stroke-dashoffset: 40;
    transition: stroke-dashoffset 0.7s var(--ease-out) 0.25s;
  }

  html.js .work-grid li.is-in .card-arrow svg path {
    stroke-dashoffset: 0;
  }

  @media (min-width: 700px) {
    .work-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-flow: row dense;
      column-gap: clamp(2rem, 4vw, 3rem);
    }
    .bento-item.is-large {
      grid-column: span 2;
    }
  }

  @media (min-width: 1080px) {
    .work-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Skills marquee --------------------------------------------------
     An infinite strip built from the real skills list on every case
     study (see frontmatter above) — the list is duplicated once so
     the loop from 0% to -50% is seamless. */
  .marquee {
    overflow: hidden;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding-block: clamp(1rem, 3vw, 1.5rem);
    mask-image: linear-gradient(90deg, transparent, black 6%, black 94%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, black 6%, black 94%, transparent);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    gap: clamp(2rem, 5vw, 3.5rem);
    animation: marquee 32s linear infinite;
  }

  .marquee-item {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--step-small);
    letter-spacing: 0.05em;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* Entrance ------------------------------------------------------- */
  .rise {
    animation: rise 0.95s var(--ease-out) both;
    animation-delay: var(--d, 0ms);
  }

  @keyframes rise {
    from { opacity: 0; transform: translate3d(0, 28px, 0); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .rise { animation: none; }
    .wave, .cue-dot { animation: none; }
    /* No hop, just the lamp already resting where it lands. */
    .lamp-jump { animation: none; opacity: 1; transform: translate(-50%, 0); }
  }
</style>
