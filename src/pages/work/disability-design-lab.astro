  ['Collage/Blue-grey', '#d2dee6'],
];
for (const [name, hex] of collage) primitives[name] = hex;

const resolve = (alias: string) => primitives[alias] ?? '#000000';

// Tokens — modes Light / Dark. Values are alias targets, not hex.
const tokenGroups: { group: string; rows: [string, string, string][] }[] = [
