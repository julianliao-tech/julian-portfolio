        align-items: center;
        gap: 1rem;
        padding: 1.5rem;
        border: 1px solid var(--line);
        background: var(--paper);
      }

      .sem-btn {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding: 0 1.4em;
        border: 1px solid;
        font-family: 'Atkinson Hyperlegible', var(--font-body);
        font-weight: 600;
        font-size: var(--step-caption);
      }

      .sem-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.35em 0.7em;
        border: 1px solid;
        font-family: 'Atkinson Hyperlegible', var(--font-body);
        font-size: var(--step-micro);
        letter-spacing: var(--track-label);
      }

      .sem-note { font-family: var(--font-mono); font-size: var(--step-small); }

      /* Type specimen --------------------------------------------------- */
      .spec-list {
        list-style: none;
        margin: 0;
        padding: 0;
        border-top: 1px solid var(--line);
      }

      .spec-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 0.5rem 1.5rem;
        align-items: baseline;
        padding-block: 1rem;
        border-bottom: 1px solid var(--line);
      }

      .spec-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.3rem 0.9rem;
      }

      .spec-name { color: var(--indigo); font-weight: 500; }

      .spec-use {
        font-family: var(--font-body);
        font-size: var(--step-small);
        color: var(--ink-faint);
      }

      .spec-nums {
        font-family: var(--font-mono);
        font-size: var(--step-micro);
        color: var(--ink);
      }

      /* The published-but-unreached steps. Muted, not hidden: the point
         of showing them is that the scale is complete. */
      .spec-unused {
        align-self: center;
        font-family: var(--font-mono);
        font-size: var(--step-micro);
        letter-spacing: var(--track-label);
        text-transform: uppercase;
        color: var(--ink-faint);
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 0.1rem 0.45rem;
        white-space: nowrap;
      }

      .spec-row:has(.spec-unused) .spec-sample { color: var(--ink-faint); }

      /* The sample is set at the size and leading the active mode's
         variables carry — the specimen changes, not just the numbers. */
      .spec-sample {
        margin: 0;
        max-width: none;
        color: var(--ink);
        overflow-wrap: anywhere;
      }

      [data-mode='Mobile'] .spec-sample { font-size: var(--s-Mobile); line-height: var(--l-Mobile); }
      [data-mode='Tablet'] .spec-sample { font-size: var(--s-Tablet); line-height: var(--l-Tablet); }
      [data-mode='Desktop'] .spec-sample { font-size: var(--s-Desktop); line-height: var(--l-Desktop); }

      .spec-face-heading { font-family: 'Space Grotesk', var(--font-body); }
      .spec-face-body { font-family: 'Atkinson Hyperlegible', var(--font-body); }
      .spec-face-annotation { font-family: 'Caveat', cursive; }

      @media (min-width: 900px) {
        .spec-row { grid-template-columns: 16rem minmax(0, 1fr); }
        .spec-meta { flex-direction: column; gap: 0.15rem; }
      }

      /* Faces ----------------------------------------------------------- */
      .face-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 1.25rem;
        margin-top: clamp(1.75rem, 4vw, 2.5rem);
      }

      .face-card {
        border: 1px solid var(--line);
        padding: 1.4rem;
      }

      .face-sample {
        margin: 0 0 0.9rem;
        max-width: none;
        font-size: clamp(2rem, 4.5vw, 2.75rem);
        line-height: 1.1;
        color: var(--indigo);
      }

      .face-card h3 {
        font-family: var(--font-body);
        font-weight: 600;
        font-size: var(--step-card-title);
        margin: 0 0 var(--gap-subheading);
        color: var(--ink);
      }

      .face-card p:not(.face-sample) {
        margin: 0;
        font-size: var(--step-body);
        line-height: var(--leading-body);
        color: var(--ink-soft);
      }

      @media (min-width: 820px) {
        .face-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      }

      /* Prototype -------------------------------------------------------
         A laptop-ish stage borrowed from elink.astro's .laptop-frame, so
         the embed reads as a device rather than a bare rectangle. The
         poster and the iframe share the stage, which keeps its own
         aspect ratio either way and stops the swap shifting the page. */
      .proto-stage {
        margin-top: clamp(1.5rem, 4vw, 2.25rem);
        max-width: 62rem;
        margin-inline: auto;
      }

      .proto-screen {
        position: relative;
        aspect-ratio: 16 / 10;
        border: 3px solid var(--ink);
        border-radius: 0.75rem 0.75rem 0 0;
        overflow: hidden;
        background: var(--paper);
      }

      /* No `.proto-screen iframe` rule here: the iframe is created at
         click time, so Astro's scoping attribute never lands on it and
         a rule written here would not match. It is sized inline in the
         script above instead. */

      .proto-launch {
        display: block;
        width: 100%;
        height: 100%;
        padding: 0;
        border: 0;
        background: none;
        cursor: pointer;
      }

      .proto-launch img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top center;
        filter: saturate(0.9) brightness(0.96);
        transition: filter 0.25s ease, transform 0.4s ease;
      }

      .proto-launch:hover img,
      .proto-launch:focus-visible img {
        filter: none;
        transform: scale(1.015);
      }

      .proto-cta {
        position: absolute;
        inset-inline: 0;
        bottom: clamp(1.25rem, 4vw, 2.25rem);
        margin-inline: auto;
        width: fit-content;
        padding: 0.7rem 1.4rem;
        background: var(--ink);
        color: var(--paper);
        font-family: 'Space Grotesk', var(--font-body);
        font-weight: 600;
        font-size: var(--step-caption);
        border-radius: 999px;
      }

      .proto-base {
        height: 0.85rem;
        border-radius: 0 0 0.6rem 0.6rem;
        background: var(--ink);
      }

      .proto-note {
        margin: 0.9rem auto 0;
        max-width: 62rem;
        font-family: var(--font-mono);
        font-size: var(--step-micro);
        color: var(--ink-faint);
      }

      @media (prefers-reduced-motion: reduce) {
        .proto-launch img { transition: none; }
        .proto-launch:hover img,
        .proto-launch:focus-visible img { transform: none; }
      }

      /* Components ------------------------------------------------------
         The exports run from a 600x12 rule to a 136x767 figure, so a
         plain `width: 100%` grid tears itself apart. Instead every media
         box is a fixed ratio and the specimen is centered inside it,
         never scaled past 1.6x its own export. Rows stay level and
         nothing is upscaled into mush. */
      .comp-tier {
        margin: clamp(1.75rem, 4vw, 2.5rem) 0 0.9rem;
        font-family: var(--font-mono);
        font-size: var(--step-micro);
        letter-spacing: var(--track-label);
        text-transform: uppercase;
        color: var(--indigo);
      }

      .comp-grid {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 1.25rem;
      }

      .comp-card {
        display: flex;
        flex-direction: column;
        border: 1px solid var(--line);
        background: #ffffff;
      }

      .comp-media {
        display: grid;
        place-items: center;
        padding: clamp(0.4rem, 1.6vw, 0.8rem);
        background: var(--paper);
        border-bottom: 1px solid var(--line);
      }

      /* 2.6/1, not 3/1: the four set sheets are 2.35, 2.89, 3.14 and 5.23
         to 1, and a 3/1 box left the Button letterboxed top and bottom on
         every screen. A slightly taller box lets three of the four fill
         their width. */
      .comp-media-set { aspect-ratio: 2.6 / 1; }
      .comp-media-single { aspect-ratio: 4 / 3; }

      /* The Stick Figure sheet is 136x767 -- a vertical strip of four
         poses. In the 4/3 box it came out about 40px wide on a phone,
         which is why it read as missing. A portrait box gives it the
         dimension it actually needs. */
      .comp-media-tall { aspect-ratio: 3 / 4; }

      /* width/height auto means an <img> renders at its intrinsic pixel
         size and max-* can only ever shrink it, so a small export sat
         marooned in the middle of its box and a 1512px sheet was scaled
         down to whatever was left after the padding. 100% + contain fills
         the box in both directions, still never cropping, and --mw/--mh
         keep the cap at 1.6x the export so nothing turns to mush. */
      .comp-media img {
        display: block;
        width: 100%;
        height: 100%;
        max-width: var(--mw);
        max-height: var(--mh);
        object-fit: contain;
      }

      .comp-body {
        flex: 1;
        padding: 0.9rem 1.1rem 1.1rem;
      }

      .comp-body h3 {
        font-family: 'Space Grotesk', var(--font-body);
        font-weight: 600;
        font-size: var(--step-card-title);
        margin: 0 0 var(--gap-caption);
        color: var(--ink);
      }

      .comp-body p {
        margin: 0;
        font-family: var(--font-mono);
        font-size: var(--step-micro);
        line-height: 1.5;
        color: var(--indigo);
      }

      @media (min-width: 720px) {
        .comp-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      }

      @media (min-width: 1040px) {
        .comp-grid-singles { grid-template-columns: repeat(4, minmax(0, 1fr)); }
      }

      /* Up next --------------------------------------------------------- */
      .up-next { padding-block: clamp(3rem, 7vw, 4.5rem); }

      .up-next-row {
        --tilt-x: 0deg;
        --tilt-y: 0deg;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1.5rem;
        margin-top: 1rem;
        text-decoration: none;
      }

      .up-next-row img {
        width: 100px;
        aspect-ratio: 1;
        object-fit: cover;
        border: 1px solid var(--line);
        transform: perspective(700px) rotateX(var(--tilt-x)) rotateY(var(--tilt-y));
        transition: transform 0.3s var(--ease-out);
      }

      .up-next-row h2 {
        margin: 0;
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(1.6rem, 4vw, 2.2rem);
        color: var(--ink);
      }

      .up-next-row p {
        margin: 0.25rem 0 0;
        color: var(--ink-faint);
        font-size: var(--step-caption);
      }

      .btn-outline {
        margin-left: auto;
        border: 1px solid var(--ink);
        border-radius: 999px;
        padding: 0.5em 1.2em;
        font-family: var(--font-body);
        font-weight: 600;
        font-size: var(--step-small);
        text-transform: uppercase;
        letter-spacing: var(--track-label);
        color: var(--ink);
      }
    
      /* Opinion asides — my read on a stage, separate from the account
         of what the file actually contains. */
      .take {
        max-width: 62ch;
        margin: 2rem 0 2rem;
        padding-left: 1.1rem;
        border-left: 3px solid var(--amber);
        font-family: var(--font-body);
        font-size: var(--step-body);
        line-height: var(--leading-body);
        color: var(--ink-soft);
      }

      .take strong { color: var(--ink); font-weight: 600; }

      .ai-heading { margin-top: clamp(2.25rem, 5vw, 3.25rem); }
</style>
  </body>
</html>
