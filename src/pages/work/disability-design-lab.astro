    <script>
      import '../../scripts/site.js';
      import '../../scripts/lightbox.js';

      // The prototype loads on click, not on page load: a third-party
      // iframe on every visit costs the page its own load time, and most
      // readers never reach for it. The poster is the real homepage
      // frame, so the stage is not empty before the swap.
      document.querySelectorAll<HTMLButtonElement>('[data-proto-launch]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const src = btn.dataset.protoSrc;
          const stage = btn.parentElement;
          if (!src || !stage) return;
          const frame = document.createElement('iframe');
          frame.src = src;
          frame.title = 'Disability Design Lab, working prototype';
          frame.loading = 'lazy';
          frame.allow = 'clipboard-write';
          frame.setAttribute('allowfullscreen', '');
          // Sized here rather than in the <style> block on purpose.
          // Astro scopes that block by stamping a data-astro-cid-*
          // attribute on every element it compiles, and an element
          // built by createElement never gets one — so a `.proto-screen
          // iframe` rule silently fails to match and the frame falls
          // back to the HTML default 300x150. Keep these inline.
          frame.style.display = 'block';
          frame.style.width = '100%';
          frame.style.height = '100%';
          frame.style.border = '0';
          stage.replaceChildren(frame);
        });
      });

      // Mode switchers for the three variable-collection blocks. The
      // markup ships with a default data-mode and the CSS hides every
      // other mode's values, so with JS off one complete mode still
      // renders — this only moves which one is showing.
      document.querySelectorAll<HTMLElement>('[data-mode-group]').forEach((strip) => {
        const buttons = Array.from(strip.querySelectorAll<HTMLButtonElement>('[data-mode-set]'));
        buttons.forEach((btn) => {
          btn.addEventListener('click', () => {
            const mode = btn.dataset.modeSet;
            if (!mode) return;
            strip.dataset.mode = mode;
            buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
          });
        });
      });

      const btn = document.querySelector('[data-copy-email]');
      btn?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText('julianliaowork@gmail.com');
          const original = btn.textContent;
          btn.textContent = 'Copied!';
          setTimeout(() => { btn.textContent = original; }, 1500);
        } catch {
          window.location.href = 'mailto:julianliaowork@gmail.com';
        }
      });

      // Typewriter effect on the pull-quote — same behavior as the other
      // case studies: types each segment in order once the quote scrolls
      // into view, and falls back to the full text under reduced-motion
      // or without IntersectionObserver.
      const quoteEl = document.querySelector<HTMLElement>('[data-typewriter]');
      if (quoteEl) {
        const segments = Array.from(quoteEl.querySelectorAll<HTMLElement>('.tw-seg'));
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const typeSegments = () => {
          let segIndex = 0;
          let charIndex = 0;
          const step = () => {
            if (segIndex >= segments.length) return;
            const seg = segments[segIndex];
            const full = seg.dataset.full ?? '';
            if (charIndex <= full.length) {
              seg.textContent = full.slice(0, charIndex);
              charIndex++;
              setTimeout(step, 22);
            } else {
              segIndex++;
              charIndex = 0;
              setTimeout(step, 22);
            }
          };
          step();
        };

        if (reduced || !('IntersectionObserver' in window)) {
          segments.forEach((seg) => { seg.textContent = seg.dataset.full ?? ''; });
        } else {
          const io = new IntersectionObserver((entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                typeSegments();
                obs.disconnect();
              }
            });
          }, { threshold: 0.4 });
          io.observe(quoteEl);
        }
      }
