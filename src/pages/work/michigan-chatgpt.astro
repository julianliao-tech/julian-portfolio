    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Instrument+Serif:ital@0;1&family=Permanent+Marker&display=swap"
    />
  </head>
  <body>
    <Nav />

    <div data-zoom-group data-zoom-scan>
      <section class="hero-banner">
        <img data-tilt src={img('00-cover-banner.webp')} alt="Michigan ChatGPT redesign shown on a laptop and phone, with the M AI Lab mark, on a maize background" />
      </section>

      <section class="marquee-section" aria-hidden="true">
        <div class="marquee-row">
          <div class="marquee-track marquee-track-left">
            {[...marqueeWords, ...marqueeWords].map((w) => <span>{w}</span>)}
          </div>
        </div>
        <div class="marquee-row">
          <div class="marquee-track marquee-track-right">
            {[...marqueeWords, ...marqueeWords].map((w) => <span>{w}</span>)}
          </div>
        </div>
        <div class="marquee-row">
          <div class="marquee-track marquee-track-left">
            {[...marqueeWords, ...marqueeWords].map((w) => <span>{w}</span>)}
          </div>
        </div>
        <div class="marquee-row">
          <div class="marquee-track marquee-track-right">
            {[...marqueeWords, ...marqueeWords].map((w) => <span>{w}</span>)}
          </div>
        </div>
        <div class="marquee-laptop">
          <div class="laptop-frame">
