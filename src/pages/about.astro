---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;

const gallery = [
  {
    src: `${base}images/about/about-1.webp`,
    alt: "Photography/Film Making collage: Julian at Michigan Stadium in a photo-crew vest, with film festival selection notices for his short 'The Letter'",
  },
  {
    src: `${base}images/about/about-2.webp`,
    alt: 'DJ/Music Production collage: Julian DJing outdoors on turntables, and producing music at a laptop and keyboard',
  },
  {
    src: `${base}images/about/about-3.webp`,
    alt: 'Sports collage: Julian playing baseball, basketball, and soccer, with his Michigan Squash team and a sectional-champion award',
  },
  {
    src: `${base}images/about/about-4.webp`,
    alt: 'Furniture Design collage: a handmade wooden stool with a woven cord seat, plus a close-up of the weave pattern',
  },
];

// Flank the copy: two shots in the left margin, two in the right.
const leftShots = gallery.slice(0, 2);
const rightShots = gallery.slice(2);
---
<BaseLayout
  title="About — Julian Liao"
  description="Julian Liao is a UX design student at the University of Michigan."
>
  <section class="wrap about-head">
    <p class="eyebrow">About</p>
    <h1>A bit about me</h1>
  </section>

  <section class="wrap about-body">
    <div class="about-layout" data-zoom-group>
      <div class="about-margin about-margin-left">
        {leftShots.map((item, i) => (
          <figure class="shot" data-reveal data-reveal-delay={i * 90}>
            <div class="shot-frame" data-zoom-frame>
              <img
                class="reveal-zoom"
                src={item.src}
                alt={item.alt}
                width="2500"
                height="1932"
                loading="lazy"
                decoding="async"
                data-zoomable
              />
            </div>
          </figure>
        ))}
      </div>

      <div class="about-copy">
        <p data-reveal>
          I'm Julian, a student at the <strong>University</strong> of <strong>Michigan</strong> studying UX
          Design with a double minor in Digital Studies and Business at the Ross School of Business.
        </p>
        <p data-reveal>
          Growing up, I spent my summers bringing my ambitious ideas to life at a short film camp with my
          friends; writing, shooting, and editing stories that turned imagination into reality.
        </p>
        <p data-reveal>
          Over the years, I've been creative through sports, street photography, music production and
          furniture design.
        </p>
        <p data-reveal>
          While studying in the library as a freshman in college, I stumbled across a flyer advertising a
          UX Design opportunity. Being my curious self I looked into it and the craft immediately clicked
          with me.
        </p>
        <p data-reveal>
          UX Design blends my creative instincts with a structured, thoughtful process I genuinely enjoy.
          Today, I design digital experiences that are intuitive, accessible, and meaningful; driven by the
          same passion that first had me holding a camera and chasing a story.
        </p>
      </div>

      <div class="about-margin about-margin-right">
        {rightShots.map((item, i) => (
          <figure class="shot" data-reveal data-reveal-delay={i * 90 + 40}>
            <div class="shot-frame" data-zoom-frame>
              <img
                class="reveal-zoom"
                src={item.src}
                alt={item.alt}
                width="2500"
                height="1932"
                loading="lazy"
                decoding="async"
                data-zoomable
              />
            </div>
          </figure>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-head {
    padding-block: clamp(3.5rem, 9vw, 7rem) clamp(2rem, 5vw, 3.5rem);
  }

  .about-head h1 {
    font-size: var(--step-display);
    line-height: 1;
    margin: 0;
  }

  .about-body {
    padding-bottom: clamp(3rem, 8vw, 6rem);
    /* Wider than the site's default --max-width so the enlarged
       margin photos have room without squeezing the text column. */
    max-width: 96rem;
  }

  /* Mobile-first: copy, then the two shot pairs below it. The margin
     layout only kicks in once there's room either side of the text —
     see the min-width query below. */
  .about-layout {
    display: grid;
    gap: clamp(2rem, 5vw, 3rem);
  }

  .about-copy {
    order: 1;
    max-width: 42rem;
    margin-inline: auto;
    border-top: 1px solid var(--line);
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  .about-copy p {
    font-size: clamp(1.05rem, 1.6vw, 1.35rem);
    line-height: 1.55;
    max-width: none;
    margin-bottom: var(--space-3);
  }

  /* The opening line carries the weight. */
  .about-copy p:first-child {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.35rem, 2.6vw, 2.1rem);
    line-height: 1.28;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin-bottom: var(--space-4);
  }

  /* Two shots per margin, side by side while they're still a
     full-width block (mobile), stacked once they move into the
     sidebar columns (see the min-width query below). */
  .about-margin {
    order: 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(0.75rem, 2vw, 1.25rem);
  }

  .about-margin-right {
    order: 3;
  }

  .shot {
    margin: 0;
  }

  .shot-frame {
    overflow: hidden;
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    background: var(--bg-elev);
    transition: border-color 0.4s var(--ease);
  }

  .shot-frame:hover {
    border-color: var(--line-strong);
  }

  .shot-frame img {
    width: 100%;
    height: auto;
  }

  /* Margins either side of the text — sized up (3x the original
     7-10rem columns) and vertically centered against the text block,
     once there's enough width to hold them. */
  @media (min-width: 1400px) {
    .about-layout {
      grid-template-columns: minmax(21rem, 30rem) minmax(0, 38rem) minmax(21rem, 30rem);
      align-items: center;
      justify-content: center;
    }

    .about-copy,
    .about-margin-left,
    .about-margin-right {
      order: initial;
    }

    .about-copy {
      margin-inline: 0;
    }

    .about-margin {
      grid-template-columns: 1fr;
      gap: clamp(1.5rem, 3vw, 2.5rem);
      align-content: center;
    }

    .about-margin-left {
      justify-self: end;
    }

    .about-margin-right {
      justify-self: start;
    }
  }
</style>
