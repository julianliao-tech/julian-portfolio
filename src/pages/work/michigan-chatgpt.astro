---
// ---------------------------------------------------------------------
// Case study page.
// Same architecture built for the SureCall format test (full-bleed
// images between narrow text, a marquee intro, brand-color feature
// bands, dark "Challenge" sections, tilt/lightbox/scroll-progress
// interactions), applied to Michigan ChatGPT's own real content and
// its own brand colors (Michigan Maize #FFCB05 / Michigan Blue
// #00274C) instead of reusing SureCall's green.
//
// Every fact and every image is pulled from
// src/content/projects/michigan-chatgpt.md, public/images/michigan-chatgpt/,
// and real screenshots/wireframes Julian added directly — nothing invented.
// One spot still has no matching real asset (the marquee's intro video)
// and is left as a labeled placeholder box rather than filled with a
// stand-in.
// ---------------------------------------------------------------------
import '../../styles/global.css';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Lightbox from '../../components/Lightbox.astro';

const base = import.meta.env.BASE_URL;
const pageTitle = 'Michigan ChatGPT — Julian Liao';
const pageDescription = 'Redesigning U-M\'s AI workspace into one clear, trusted homepage';
const ogImage = new URL(`${base}images/home/profile-illustration.webp`, Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);
const img = (n: string) => `${base}images/michigan-chatgpt/${n}`;

const meta = [
  { label: 'Timeline', value: 'Aug – Dec 2025' },
  { label: 'Role', value: ['Product Designer', 'UX Researcher'] },
  { label: 'Team', value: 'Solo Project' },
  { label: 'Tools', value: ['Figma', 'FigJam', 'Slack'] },
  {
    label: 'Skills',
    value: ['Wireframing', 'Prototyping', 'Design Systems', 'Interaction Design', 'User Research'],
  },
];

const challenges = [
  'Communicating the purpose of multiple AI tools without overwhelming users.',
  'Simplifying scattered navigation patterns into one cohesive experience.',
  'Designing for both first-time visitors discovering tools and returning users who already know where they\'re going.',
];

const researchFindings = [
  "Difficulty understanding what each AI tool does",
  "Low confidence navigating between services",
  "Reliance on external AI tools due to confusion on Michigan's offerings",
  'Lack of visual hierarchy or familiarity in the interface',
];

const keyInsights = [
  'Users felt overwhelmed by unclear terminology and too many competing tools.',
  'Familiarity and simplicity dramatically increase trust in digital systems.',
  'Navigation must be clean, predictable, and consistent across the experience.',
];

const firstTimeNeeds = [
  'Immediately understand that MichiganGPT is a suite of U-M AI tools',
  'Learn what each tool does and which one fits my need',
  'Navigate comfortably through a clean, familiar, Michigan-branded workspace',
];

const returningNeeds = [
  'Jump straight into the tool I use most',
  'See updates, announcements, or new features',
  'Access documentation, support, or login in one click',
];

const whatShipped = [
  'Clear hierarchy and predictable patterns',
  'Cards for each AI tool, evenly spaced and highly scannable',
  'Strengthened Michigan branding without overwhelming the UI',
  'Accessibility upgrades for legibility, navigation, and recognition',
  'Trust-building elements such as curated responses and user-centered features',
];

const lookingAhead = [
  'A full documentation experience',
  "A personalized dashboard based on user history",
  'Better integration with academic tools across campus',
];

const marqueeWords = Array(6).fill('U-M AI WORKSPACE');

const nextProject = {
  title: 'SureCall',
  subtitle: 'A field tool for installing and testing Verizon 5G boosters',
  image: `${base}images/home/tile-surecall.png`,
  href: `${base}work/surecall/`,
};
---

{/* prettier-ignore */}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#fdfbf9" />
