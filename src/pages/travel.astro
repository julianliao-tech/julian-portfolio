  Amsterdam: [
    { src: 'amsterdam-1.webp', alt: 'Five friends dressed head to toe in orange on an Amsterdam street.' },
  ],
  Barcelona: [
    { src: 'barcelona-1.webp', alt: 'Julian and a friend sitting on a rock above Barcelona, the whole city spread out behind them.' },
    { src: 'barcelona-2.webp', alt: 'Julian sitting on a low stone wall in the mountains outside Barcelona, ridges stretching into the haze.' },
  ],
  Beijing: [
    { src: 'beijing-1.webp', alt: 'A young Julian in an orange shirt on the Great Wall at Mutianyu, the wall running off along the ridge behind him.' },
  ],
  Berlin: [
    { src: 'berlin-1.webp', alt: 'Julian pointing up at the Fraternal Kiss mural on a standing stretch of the Berlin Wall.' },
  ],
  Bratislava: [
    { src: 'bratislava-1.webp', alt: "Five friends with their backpacks around the Napoleon's soldier statue in Bratislava's main square." },
  ],
  Budapest: [
    { src: 'budapest-1.webp', alt: 'Three friends with drinks at a table at night, the Hungarian Parliament lit gold across the water.' },
  ],
  Cairns: [
    { src: 'cairns-1.webp', alt: 'A snorkeler swimming just above a large humphead wrasse over the Great Barrier Reef.' },
  ],
  'Cancún': [
    { src: 'cancun-1.webp', alt: 'A five-a-side game underway on a green pitch in Cancún, palms and a hotel tower behind it.' },
  ],
  Chongqing: [
    { src: 'chongqing-1.webp', alt: 'A young Julian in front of the carved stone and timber front of a guild hall in Chongqing.' },
  ],
  Copenhagen: [
    { src: 'copenhagen-1.webp', alt: 'Swimmers on the wooden deck of a Copenhagen harbour bath, one of them mid-jump into the water.' },
  ],
  'Costa Rica': [
    { src: 'costa-rica-1.webp', alt: 'Six friends sitting in a shallow jungle river in Costa Rica, rock and trees closing in over it.' },
  ],
  Dublin: [
    { src: 'dublin-1.webp', alt: 'A big group of friends packed shoulder to shoulder in a Dublin pub.' },
  ],
  'Hawaii (Big Island)': [
    { src: 'hawaii-big-island-1.webp', alt: 'A much younger Julian standing alone on a dark volcanic beach at dusk.' },
  ],
  Hangzhou: [
    { src: 'hangzhou-1.webp', alt: 'A willow-lined causeway along West Lake in Hangzhou, bamboo arching over the path.' },
  ],
  'Hong Kong': [
