---
// ---------------------------------------------------------------------
// Case study page.
// Same architecture built for the SureCall and Michigan ChatGPT format
// tests (full-bleed images between narrow text, a marquee intro, a
// brand-color stat band, dark "Challenge" sections, brand-color
// feature bands, tilt/lightbox/scroll-progress interactions), applied
// here to the Guide app's own real content and its own real brand
// colors — periwinkle blue #97ADD1, coral #E28A8A, and mint green
// #97D1A3, all pulled directly from the Design Kit asset (15.webp),
// not guessed.
//
// Every fact and every image is pulled from
// src/content/projects/guide.md and public/images/guide/ — nothing
// invented. Guide has exactly three challenges in the source doc, so
// (like SureCall) this uses three separate interleaved "Challenge"
// sections rather than one combined grid. There's no stated project
// location in the source doc, so — unlike the SureCall/Michigan
// pages — there's no location band here; a real stat band (4-week
// timeline, 20+ survey responses, 3 core functions, all literally
// counted from the source doc) stands in its place instead.
// ---------------------------------------------------------------------
import '../../styles/global.css';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Lightbox from '../../components/Lightbox.astro';

const base = import.meta.env.BASE_URL;
const pageTitle = 'Guide Mobile Application · Julian Liao';
const pageDescription = 'A wheelchair-accessible navigation app for safer, independent travel';
const ogImage = new URL(`${base}images/home/profile-illustration.webp`, Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);
const img = (n: string) => `${base}images/guide/${n}`;

const meta = [
  { label: 'Timeline', value: '4 Weeks' },
  { label: 'Role', value: ['UX Designer', 'UX Researcher'] },
  { label: 'Team', value: 'Just Me!' },
  { label: 'Tools', value: ['Figma', 'FigJam', 'Miro'] },
  {
    label: 'Skills',
    value: ['Wireframing', 'Prototyping', 'Design Systems', 'Interaction Design', 'User Research'],
  },
];

const challenges = [
  'Decide which obstacles actually stop a wheelchair, and leave the rest off the map.',
  'Show that an elevator is ahead without making the user stop and read.',
  'Design for someone who is moving and cannot look at their phone for long.',
];

const painPoints = ['Elevators', 'Ramps', 'Crowds', 'Bathrooms', 'Report'];

// The four conclusions from the survey and interviews. These were a flat image
// (04.webp) until now; the text is the same, rebuilt as real markup so it is
// selectable, searchable and readable by a screen reader.
// Each card is tipped a different amount so the row reads as pinned notes
// rather than a grid. Straightens on hover.
const insightRotations = [-2.2, 1.6, -1.1, 2.4];

const keyInsights = [
  {
    title: 'The problems people hit most often',
    list: ['Lack of ramps', 'Broken elevators', 'Poor signage', 'Crowded spaces'],
  },
  {
    title: 'Confidence giving accessibility information is low',
    body: 'Most people did not feel confident telling someone with a disability whether a place would be accessible.',
  },
  {
    title: 'People want real time data',
    body: 'Respondents wanted to know whether a route is accessible right now, not whether it was accessible once.',
  },
  {
    title: 'People who go out more have seen the problems',
    body: 'Respondents who visit public spaces often had run into these accessibility problems themselves.',
  },
];
const trustPoints = ['Elevator Status', 'Ramp Conditions', 'Reported Obstacles'];

// Percentages measured directly from the real donut charts (surveytwo.png,
// the Confidence Level screenshot) — not invented.
const surveyCharts = [
  {
    title: 'Knowledge',
    question: 'Have you ever used an app, map or website that included accessibility information about a public space?',
    segments: [
      { label: 'No', pct: 80, color: '#162e5f' },
      { label: 'Yes', pct: 20, color: '#1a50e0' },
    ],
  },
  {
    title: 'Confidence Level',
    question: 'If a friend/family member asked you for advice about which public spaces are accessible, how confident would you feel giving them accurate info?',
    segments: [
      { label: 'Not Very Confident', pct: 58, color: '#162e5f' },
      { label: 'Somewhat Confident', pct: 32, color: '#1c50de' },
      { label: 'Other', pct: 10, color: '#6093e4' },
    ],
  },
];

// The donut is an SVG whose radius makes the circumference exactly 100, so a
// segment's stroke-dasharray is just its percentage. `start` is the running
// total, used for stroke-dashoffset (25 rotates the origin to 12 o'clock).
const withArcs = (segments: { pct: number; color: string; label: string }[]) => {
  let acc = 0;
  return segments.map((s) => {
    const seg = { ...s, start: acc };
    acc += s.pct;
    return seg;
  });
};

const marqueeWords = Array(6).fill('TRAVELIN’ SAFE');

const nextProject = {
  title: 'Michigan ChatGPT',
  subtitle: 'Four campus AI tools nobody could tell apart, rebuilt into one starting page',
  image: `${base}images/home/tile-michigan-chatgpt.webp`,
  href: `${base}work/michigan-chatgpt/`,
};
---

{/* prettier-ignore */}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#fdfbf9" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={canonical.href} />
    <meta name="description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,600&family=Instrument+Serif:ital@0;1&family=Permanent+Marker&display=swap"
    />
  </head>
  <body>
    <Nav />

    <div data-zoom-group data-zoom-scan>
      <section class="hero-banner">
        <img data-tilt src={img('01.webp')} alt="Guide app screens on a blue background: the Travelin' Safe title screen, a Nearby listing of accessible spots, and the G logo" />
      </section>
      <section class="marquee-section" aria-hidden="true">
        <div class="marquee-row">
          <div class="marquee-track marquee-track-left">
            {[...marqueeWords, ...marqueeWords].map((w) => <span>{w}</span>)}
          </div>
        </div>
        <div class="marquee-row">
          <div class="marquee-track marquee-track-right">
            {[...marqueeWords, ...marqueeWords].map((w) => <span>{w}</span>)}
          </div>
        </div>
        <div class="marquee-row">
          <div class="marquee-track marquee-track-left">
            {[...marqueeWords, ...marqueeWords].map((w) => <span>{w}</span>)}
          </div>
        </div>
        <div class="marquee-row">
          <div class="marquee-track marquee-track-right">
            {[...marqueeWords, ...marqueeWords].map((w) => <span>{w}</span>)}
          </div>
        </div>
        <div class="marquee-phone">
          <div class="phone-frame">
            <video src={img('marquee-banner.mp4')} autoplay muted loop playsinline aria-label="Screen recording of the Guide app opening to the G logo"></video>
          </div>
        </div>
      </section>
      <section class="head-block">
        <div class="wrap">
          <div class="head-top">
            <h1 class="title">Guide</h1>
            <div class="context-box">
              <p class="context-label">Where this started</p>
              <h2 class="context-heading">Checking a route should not take longer than the trip</h2>
              <p>Guide is a navigation app for wheelchair users. It finds routes that meet ADA requirements, warns people about obstacles and crowds before they get there, and shows where the nearest elevators, ramps and accessible restrooms are. I built it so someone can find out whether a route will work before they leave the house.</p>
            </div>
          </div>

          <dl class="meta">
            {meta.map((m) => (
              <div>
                <dt>{m.label}</dt>
                <dd>{Array.isArray(m.value) ? m.value.map((v) => <span>{v}</span>) : m.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
      <section class="white-block personal-section">
        <div class="wrap personal-grid">
          <div class="personal-text">
            <p class="eyebrow-label">Why I built it</p>
            <h2>My brothers used wheelchairs, and every trip out had to be planned</h2>
            <p>Two of my brothers, Nate and Jake, used wheelchairs. They had epidermolysis bullosa, a condition that makes skin fragile and causes blisters, so going out took planning. Someone in my family had to find out beforehand where the ramps were, which door worked, and whether there would be a crowd.</p>
            <p>I thought about building this app for years before I had the skills to do it. <strong>Most people can leave the house without checking whether they will be able to get through the door. I wanted to give everyone else that same head start.</strong></p>
          </div>
          <div class="personal-photos">
            <img data-tilt src={img('personal-01.webp')} alt="Julian as a child with his brothers, one recovering from a bandaged arm, in a family photo" />
            <img data-tilt src={img('personal-02.webp')} alt="An earlier childhood photo of Julian with his brothers Nate and Jake" />
          </div>
        </div>
      </section>
      <section class="head-block head-block-tail">
        <div class="wrap">
          <p class="pull-quote" data-typewriter>
            <span aria-hidden="true"><span class="tw-seg" data-full="How do you tell someone a route will work "></span><span class="tw-seg pull-quote-highlight" data-full="before they leave the house"></span><span class="tw-seg" data-full=", traveling on their own?"></span></span>
            <span class="sr-only">How do you tell someone a route will work before they leave the house, traveling on their own?</span>
          </p>
        </div>
      </section>
      <section class="dark-block">
        <div class="wrap">
          <div class="challenge-head">
            <span class="quirky">Obstacles</span>
            <h2>Finding out about an obstacle when you arrive is too late</h2>
          </div>
          <ol class="challenge-grid">
            {challenges.map((c, i) => (
              <li class:list={['challenge-card']} data-tilt>
                <span class="challenge-num">{String(i + 1).padStart(2, '0')}</span>
                <p>{c}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
      <section class="white-block tight">
        <div class="wrap">
          <h2>Four out of five people had never seen accessibility info in a map</h2>
          <p>I ran a survey with over 20 responses and interviewed people who use a wheelchair or travel with someone who does. Two problems came up every time: <strong>the path was not usable for people in wheelchairs, and there was no way of knowing that before going on the route.</strong> I built the app to tell people about both before they leave.</p>
          <p class="take">The survey showed me how common the problem was. The interviews showed me what it is like to plan every trip around it. If I could only run one of the two, I would run the interviews.</p>
        </div>
        <div class="image-row-single image-row-single-wide">
          <img data-tilt src={img('02-quotes-cropped.webp')} alt="Three quotes from survey respondents about inconsistent doors and elevators, missing ADA-accessible entrances, and difficulty maneuvering a wheelchair through crowds" />
        </div>
      </section>
      <section class="white-block tight">
        <div class="wrap">
          <p class="eyebrow-label">The survey results</p>
          <p>Every percentage below is measured from my own survey responses. Hover a segment to see its share.</p>
          <div class="chart-grid">
            {surveyCharts.map((chart) => (
              <div class="chart-card">
                <h3 class="chart-title">{chart.title}</h3>
                <div class="chart-row">
                  <div class="donut-wrap" data-donut>
                    <svg
                      class="donut-svg"
                      viewBox="0 0 50 50"
                      role="img"
                      aria-label={`${chart.title}: ${chart.segments.map((s) => `${s.pct}% ${s.label}`).join(', ')}`}
                    >
                      {withArcs(chart.segments).map((s) => (
                        <circle
                          class="donut-seg"
                          cx="25"
                          cy="25"
                          r="15.915"
                          data-pct={s.pct}
                          data-label={s.label}
                          style={`stroke: ${s.color}; stroke-dasharray: ${s.pct} ${100 - s.pct}; stroke-dashoffset: ${(125 - s.start) % 100};`}
                        >
                          <title>{s.pct}% {s.label}</title>
                        </circle>
                      ))}
                    </svg>
                    <span class="donut-tip" aria-hidden="true"></span>
                  </div>
                  <ul class="chart-legend">
                    {chart.segments.map((s) => (
                      <li>
                        <span class="swatch" style={{ background: s.color }}></span>
                        <span class="legend-pct">{s.pct}%</span>
                        <span class="legend-label">{s.label}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <p class="chart-question">"{chart.question}"</p>
              </div>
            ))}
          </div>
        </div>
      </section>
      <section class="white-block tight">
        <div class="wrap">
          <h2>Grouping the answers into themes</h2>
          <p>I put every survey answer and interview note on a board and grouped the ones that said the same thing. Five themes came out of it: physical barriers in public, gaps in the information people are given, maintenance that is not kept up, low confidence recommending a place to someone else, and the features people asked for.</p>
        </div>
        <div class="image-row-single image-row-single-wide">
          <img data-tilt src={img('03.webp')} alt="Affinity diagram grouping wheelchair user research feedback into five themes: physical barriers in public, information gaps, inconsistent maintenance and upkeep, confidence in recommending accessible spaces, and desired app features" />
        </div>
      </section>
      <section class="white-block tight">
        <div class="wrap">
          <p class="eyebrow-label">Four key insights</p>
          <h2>What the research came down to</h2>
          <ol class="insight-row">
            {keyInsights.map((k, i) => (
              <li class="insight" style={`--rot: ${insightRotations[i]}deg`}>
                <span class="insight-pin" aria-hidden="true"></span>
                <span class="insight-num">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="insight-title">{k.title}</h3>
                {k.list
                  ? <ul class="insight-list">{k.list.map((item) => <li>{item}</li>)}</ul>
                  : <p class="insight-body">{k.body}</p>}
              </li>
            ))}
          </ol>
        </div>
      </section>
      <section class="white-block tight">
        <div class="wrap">
          <h2>What building personas taught me</h2>
          <p>I built personas for wheelchair users and for the people who travel with them. The finished persona documents were not what helped. Writing them made me put down what frustrated each person, not just what they wanted. <em>Two people can want the same thing for different reasons, and that means two different screens.</em> My first personas just matched the app I already wanted to build, so I rewrote them using what people actually told me.</p>
          <div class="image-row image-row-detail image-row-personas">
            <img data-tilt src={img('05.webp')} alt="User persona: Joseph, 33, an Occupational Therapist with moderate tech comfort, with his goals, pain points, and needs" />
            <img data-tilt src={img('16.webp')} alt="User persona: Sarah, 28, a freelance graphic designer and wheelchair user in an urban area, with her goals, pain points, and needs" />
          </div>
        </div>
      </section>
      <section class="white-block tight">
        <div class="wrap">
          <p class="eyebrow-label">The user <span class="accent">flow</span></p>
        </div>
        <div class="image-row-single image-row-single-wide">
          <img data-tilt src={img('08.webp')} alt="User flow diagram for the Guide navigation app" />
        </div>
      </section>
      <section class="white-block tight">
        <div class="wrap">
          <h2>Three versions of the route screen, and why I picked the third</h2>
          <p>Version one drew the route and the obstacles, but it had no way to end the trip and no key for the icons, so you had to learn the map before you could use it. Option 3 <strong>labeled the symbols and added an End button without adding a step</strong>. It is not the best looking of the three. I picked it because it works when you only have one hand free.</p>
          <p class="take">When I put three options side by side, I pick the best looking one and find reasons for it afterwards. So now I write down what the screen has to let someone do before I lay the options out, and I score each option against that list. <strong>If I only compare the options to each other, one of them looks best even when all three are bad.</strong></p>
        </div>
        <div class="image-row-single image-row-single-wide">
          <img data-tilt src={img('10.webp')} alt="Three iterations of the navigation page, from a version without an end button to the final option with labeled icons" />
        </div>
      </section>
      <section class="white-block tight">
        <div class="wrap">
          <h2>I picked the version with a Call button over the better looking one</h2>
          <p>Option 1 looked clean because it left out the address and the opening hours. I picked Option 3, which <em>puts the most important information first and gives you one obvious thing to do next</em>. In testing, the Call button was what got people through the task. The question people actually have on that screen is whether someone can confirm the place will work when they arrive.</p>
        </div>
        <div class="image-row-single image-row-single-wide">
          <img data-tilt src={img('11.webp')} alt="Three iterations of the location detail page, ending in a version with a dedicated Call button and segmented data" />
        </div>
      </section>
      <section class="feature-band feature-band-blue feature-band-reverse tight">
        <div class="feature-media">
          <img data-tilt src={img('12.webp')} alt="Two Guide app screens showing an elevator location callout and an important alert callout over the map" />
        </div>
        <div class="feature-text">
          <h2 class="feature-heading">Five things people wanted to know before going on a route</h2>
          <p>Everything people told me came down to five things worth marking on a route: elevators, ramps, crowds, accessible restrooms, and a way to report something broken. I started with a longer list, and cutting it down was most of the work. <em>Five is the number someone can read quickly while they are moving.</em> I kept the report marker because it is what keeps the map accurate after I stop updating it.</p>
          <ul class="pinpoint-row">
            {painPoints.map((p) => <li>{p}</li>)}
          </ul>
        </div>
      </section>
      <section class="feature-band feature-band-blue tight">
        <div class="feature-media">
          <img data-tilt src={img('13.webp')} alt="Two Guide app screens: turn by turn directions to Warm Springs Plaza with an accessibility icon bar, and the surrounding map view" />
        </div>
        <div class="feature-text">
          <h2 class="feature-heading">A route is only reliable if someone checked it recently</h2>
          <p>The app gives one route, the most accessible one with the fewest detours. It favors paths that are maintained, marked and <strong>confirmed by someone recently</strong>. You can open the route to see elevator status, ramp condition, and anything that has been reported.</p>
          <p class="take">People plan their day around an accessibility map. I think <strong>launching one and then not updating it is worse than never launching it</strong>, because the person who finds out it is wrong is already standing outside a door that does not open.</p>
          <ul class="pinpoint-row">
            {trustPoints.map((p) => <li>{p}</li>)}
          </ul>
        </div>
      </section>
      <section class="white-block tight">
        <div class="wrap">
          <h2>The finished prototype</h2>
        </div>
        <div class="prototype-phone">
          <video src={img('prototype.mp4')} autoplay muted loop playsinline aria-label="Screen recording of the Guide prototype: navigating from Home and Nearby through location detail, directions, and alerts"></video>
        </div>
      </section>
      <section class="white-block tight">
        <div class="wrap">
          <p class="eyebrow-label">The design kit</p>
        </div>
        <div class="image-row-single image-row-single-wide">
          <img data-tilt src={img('15.webp')} alt="Guide app design kit: Work Sans typography scale, a blue/gray/coral color palette with hex codes, and the app's icon and button assets" />
        </div>
      </section>
      <section class="white-block tight">
        <div class="wrap">
          <h2>How it turned out, and what I would change</h2>
          <p>Designing for someone who is already moving made me <em>cut the route screen down to five markers and one action</em>, which is far less than I started with.</p>
          <p>I ran every stage of this myself, from the first survey response to the prototype. I never went back to the people I interviewed to test the finished screens on them, and that is the part I did not finish. It is the first thing I would do if I worked on this again.</p>
          <p>What I took from this is a habit I use on everything now. Before I draw anything I ask what the person is doing with their hands, their attention and their time while they use it. Guide had to work for someone pushing a wheelchair through a crowd, with one hand free and about two seconds to look. Once that is the test, most of what I wanted to put on the screen does not survive it.</p>
          <p>This one was harder to work on than I expected. My brothers are the reason it exists, so I was slower and more careful with it than I am with other projects, because I did not want to build something that looked like it helped and did not. <strong>The part I am still uneasy about is that I made an accessibility app without putting it in front of a single wheelchair user.</strong> I know why I did not manage it in four weeks. I still think it was the wrong call.</p>
          <h2 class="ai-heading">How I would change this today with AI</h2>
          <p>The problem I never solved was keeping the map current. A map of ramps and elevators goes out of date within months, and I was relying on users to report every change themselves. Today I would have a model look at the photo somebody submits and confirm that the ramp or the elevator is there and working, so a report gets checked in seconds instead of sitting in a queue. I would also use a model to pull accessibility details out of sources that already exist, like business websites, city inspection records and reviews, so the map has something on it the day it launches instead of being empty.</p>
          <p>I would not put any of that on the map without saying where it came from. <strong>A wrong accessibility claim is worse than no claim</strong>, because somebody plans their day around it. Anything a model produced would be marked as unconfirmed until a person checked it, and the route the app recommends would still only use paths a person has confirmed.</p>
        </div>
      </section>
      <section class="up-next tight">
        <div class="wrap">
          <span class="quirky">Up Next</span>
          <a class="up-next-row" href={nextProject.href} data-tilt>
            <img src={nextProject.image} alt="" />
            <div>
              <h2>{nextProject.title}</h2>
              <p>{nextProject.subtitle}</p>
            </div>
            <span class="btn-outline">View Project</span>
          </a>
        </div>
      </section>
    </div>

    <Footer />

    <Lightbox />

    <script>
      import '../../scripts/site.js';
      import '../../scripts/lightbox.js';

      // Donut tooltips. The tooltip element is authored in the template (not
      // created here) so Astro's scoped styles actually apply to it.
      document.querySelectorAll<HTMLElement>('[data-donut]').forEach((wrap) => {
        const tip = wrap.querySelector<HTMLElement>('.donut-tip');
        if (!tip) return;
        const hide = () => tip.classList.remove('is-on');
        wrap.querySelectorAll<SVGCircleElement>('.donut-seg').forEach((seg) => {
          const show = (e: PointerEvent) => {
            tip.textContent = `${seg.dataset.pct}% ${seg.dataset.label}`;
            tip.classList.add('is-on');
            const box = wrap.getBoundingClientRect();
            tip.style.left = `${e.clientX - box.left}px`;
            tip.style.top = `${e.clientY - box.top}px`;
          };
          seg.addEventListener('pointerenter', show as EventListener);
          seg.addEventListener('pointermove', show as EventListener);
          seg.addEventListener('pointerleave', hide);
        });
      });

      const btn = document.querySelector('[data-copy-email]');
      btn?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText('julianliaowork@gmail.com');
          const original = btn.textContent;
          btn.textContent = 'Copied!';
          setTimeout(() => { btn.textContent = original; }, 1500);
        } catch {
          window.location.href = 'mailto:julianliaowork@gmail.com';
        }
      });

      document.querySelectorAll<HTMLVideoElement>('.marquee-phone video, .feature-media video, .prototype-phone video').forEach((v) => {
        v.play().catch(() => {});
      });

      // Typewriter effect on the pull-quote — types each segment in order
      // (plain text, then the highlighted phrase, then the trailing plain
      // text) once the quote scrolls into view. Reduced-motion and
      // no-IntersectionObserver both fall back to showing the full text.
      const quoteEl = document.querySelector<HTMLElement>('[data-typewriter]');
      if (quoteEl) {
        const segments = Array.from(quoteEl.querySelectorAll<HTMLElement>('.tw-seg'));
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const typeSegments = () => {
          let segIndex = 0;
          let charIndex = 0;
          const step = () => {
            if (segIndex >= segments.length) return;
            const seg = segments[segIndex];
            const full = seg.dataset.full ?? '';
            if (charIndex <= full.length) {
              seg.textContent = full.slice(0, charIndex);
              charIndex++;
              setTimeout(step, 28);
            } else {
              segIndex++;
              charIndex = 0;
