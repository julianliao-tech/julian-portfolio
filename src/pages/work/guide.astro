        aspect-ratio: 8 / 3;
        overflow: hidden;
      }

      .hero-banner img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 35%;
      }

      /* Marquee ----------------------------------------------------------- */
      .marquee-section {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-around;
        min-height: clamp(380px, 48vw, 640px);
        padding-block: clamp(2.5rem, 6vw, 4rem);
        overflow: hidden;
        background: #ffffff;
      }

      .marquee-row {
        overflow: hidden;
        white-space: nowrap;
      }

      .marquee-track {
        display: inline-flex;
        width: max-content;
      }

      .marquee-track span {
        display: inline-block;
        padding-inline: 1.5rem;
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(1.4rem, 4.2vw, 2.6rem);
        color: #97add1;
        white-space: nowrap;
      }

      .marquee-row:nth-child(odd) .marquee-track span {
        color: rgba(151, 173, 209, 0.45);
      }

      .marquee-track-left {
        animation: marquee-left 32s linear infinite;
      }

      .marquee-track-right {
        animation: marquee-right 32s linear infinite;
      }

      @keyframes marquee-left {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
      }

      @keyframes marquee-right {
        from { transform: translateX(-50%); }
        to { transform: translateX(0); }
      }

      .marquee-phone {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 5;
      }

      .phone-frame {
        width: clamp(140px, 16vw, 220px);
        aspect-ratio: 654 / 1416;
        border: 3px solid var(--ink);
        border-radius: 1.5rem;
        padding: 0;
        background: #ffffff;
        overflow: hidden;
      }

      .phone-frame .placeholder {
        height: 100%;
        aspect-ratio: auto;
        border-radius: 0;
      }

      .phone-frame video {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      @media (prefers-reduced-motion: reduce) {
        .marquee-track-left,
        .marquee-track-right {
          animation: none;
        }
      }

      /* Head block -------------------------------------------------------- */
      .head-block {
        padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 5vw, 3rem);
      }

      .head-block-tail {
        padding-top: 0;
      }

      /* Personal note ------------------------------------------------- */
      .personal-section {
        padding-top: 0;
      }

      .personal-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: clamp(1.5rem, 4vw, 2.5rem);
        align-items: center;
      }

      .personal-photos {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        align-items: center;
      }

      .personal-photos img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 0.5rem;
      }

      @media (min-width: 800px) {
        .personal-grid { grid-template-columns: 1.15fr 1fr; }
      }

      .head-top {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
        align-items: start;
        margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
      }

      .title {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(3.5rem, 10vw, 7rem);
        letter-spacing: -0.01em;
        line-height: 0.98;
        color: var(--ink);
        margin: 0;
      }

      .context-box {
        background: transparent;
        border-left: 3px solid var(--line-strong);
        padding-left: 1.25rem;
      }

      .context-label {
        margin: 0 0 0.35rem;
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--ink-faint);
      }

      .context-heading {
        margin: 0 0 0.5rem;
        font-family: var(--font-display);
        font-weight: 400;
        font-size: 1.3rem;
        color: var(--ink);
      }

      .context-box p:not(.context-label) {
        margin: 0;
        max-width: none;
        font-size: 1rem;
        line-height: 1.6;
        color: var(--ink-soft);
      }

      @media (min-width: 800px) {
        .head-top { grid-template-columns: auto 1fr; gap: 2.5rem; }
      }

      .meta {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
        gap: 1.5rem;
        padding-bottom: clamp(1.5rem, 4vw, 2.5rem);
        border-bottom: 1px solid var(--line);
        margin: 0 0 clamp(1.5rem, 4vw, 2.5rem);
      }

      .meta dt {
        font-family: var(--font-body);
        font-size: 0.8rem;
        color: var(--ink-faint);
        margin-bottom: 0.35rem;
      }

      .meta dd {
        margin: 0;
        font-family: var(--font-body);
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.9rem;
        color: var(--ink);
      }

      .meta dd span {
        display: block;
      }

      .intro {
        font-size: 1rem;
        line-height: 1.6;
        color: var(--ink-soft);
        max-width: none;
        text-align: justify;
        text-align-last: left;
        hyphens: auto;
      }

      .intro strong {
        color: var(--ink);
        font-weight: 700;
      }

      .pull-quote {
        position: relative;
        max-width: none;
        font-family: var(--font-serif);
        font-weight: 400;
        font-size: clamp(1.6rem, 3.4vw, 2.4rem);
        line-height: 1.4;
        color: var(--ink-faint);
        margin-top: clamp(1.5rem, 4vw, 2.5rem);
        text-align: center;
      }

      .pull-quote-highlight {
        color: #1d2b3f;
        font-weight: 700;
        box-shadow: inset 0 -0.35em 0 rgba(151, 173, 209, 0.35);
      }

      .pull-quote[data-typewriter]::after {
        content: '';
        display: inline-block;
        width: 2px;
        height: 1em;
        margin-left: 2px;
        background: currentColor;
        vertical-align: text-bottom;
        animation: pull-quote-blink 0.9s steps(1) infinite;
      }

      @keyframes pull-quote-blink {
        50% { opacity: 0; }
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      @media (prefers-reduced-motion: reduce) {
        .pull-quote[data-typewriter]::after {
          animation: none;
        }
      }

      /* Dark / white blocks ---------------------------------------------- */
      .dark-block {
        background: var(--ink);
        color: var(--bg);
        padding-block: clamp(3rem, 7vw, 5rem);
      }

      .white-block {
        padding-block: clamp(2.5rem, 6vw, 4rem);
      }

      .white-block-flush-bottom {
        padding-bottom: 0;
      }

      /* Tighter vertical rhythm for the run of sections below Challenge 2. */
      .tight.white-block {
        padding-block: clamp(1.25rem, 3vw, 2rem);
      }

      .tight.dark-block {
        padding-block: clamp(1.5rem, 3.5vw, 2.25rem);
      }

      .tight.feature-band .feature-text {
        padding-block: clamp(1.25rem, 3vw, 2rem);
      }

      .white-block.tint-blue { background: rgba(151, 173, 209, 0.12); }
      .white-block.tint-coral { background: rgba(226, 138, 138, 0.1); }

      .white-block h2,
      .dark-block h2 {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(1.9rem, 4vw, 2.8rem);
        letter-spacing: -0.01em;
        margin: 0 0 0.6rem;
      }

      .white-block h2 { color: var(--ink); }
      .dark-block h2 { color: var(--bg); }

      .white-block p,
      .dark-block .wrap > p {
        max-width: none;
        font-size: 1rem;
        line-height: 1.6;
        text-align: justify;
        text-align-last: left;
        hyphens: auto;
      }

      .white-block p { color: var(--ink-soft); }
      .dark-block .wrap > p { color: rgba(253, 251, 249, 0.7); }

      .white-block strong { color: var(--ink); font-weight: 700; }
      .white-block em { color: var(--ink); font-style: italic; }
      .dark-block strong { color: var(--bg); font-weight: 700; }
      .dark-block em { color: var(--bg); font-style: italic; }


      .eyebrow-label {
        font-family: var(--font-body);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #97add1;
        margin: 0 0 0.75rem;
        font-size: 0.85rem;
      }

      .eyebrow-label .accent { color: #e28a8a; }

      /* Images ------------------------------------------------------------ */
      .image-row-single {
        margin-top: clamp(1.5rem, 4vw, 2.5rem);
      }

      .image-row-single-wide {
        max-width: 56rem;
        margin-inline: auto;
      }

      .image-row-single-full {
        max-width: none;
        width: 100%;
      }

      .prototype-phone {
        width: clamp(240px, 26vw, 340px);
        aspect-ratio: 792 / 1720;
        margin: clamp(1.5rem, 4vw, 2.5rem) auto 0;
        border: 3px solid var(--ink);
        border-radius: 15% / 6.9%;
        overflow: hidden;
        background: #ffffff;
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.14);
      }

      .prototype-phone video {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .image-row-single img {
        display: block;
        width: 100%;
      }

      .image-row {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
        margin-top: clamp(1.5rem, 4vw, 2.5rem);
      }

      .image-row img {
        display: block;
        width: 100%;
      }

      .image-row-personas img {
        aspect-ratio: 1775 / 1205;
        object-fit: contain;
      }

      /* Survey donut charts — built with a CSS conic-gradient, not
         images. Percentages are measured from the real source charts. */
      .chart-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2.5rem;
        margin-top: 1.5rem;
      }

      @media (min-width: 700px) {
        .chart-grid { grid-template-columns: 1fr 1fr; }
      }

      .chart-card {
        border: 1px solid var(--line);
        padding: clamp(1.5rem, 3vw, 2rem);
      }

      .chart-title {
        margin: 0 0 1.25rem;
        font-family: var(--font-display);
        font-weight: 400;
        font-size: 1.6rem;
        color: var(--ink);
      }

      .chart-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1.75rem;
      }

      .donut {
        position: relative;
        width: clamp(140px, 22vw, 190px);
        aspect-ratio: 1;
        border-radius: 50%;
        flex-shrink: 0;
      }

      .donut-hole {
        position: absolute;
        inset: 30%;
        border-radius: 50%;
        background: #ffffff;
        display: block;
      }

      .chart-legend {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        flex: 1 1 160px;
      }

      .chart-legend li {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-family: var(--font-body);
        font-size: 0.95rem;
        color: var(--ink);
      }

      .chart-legend .swatch {
        display: inline-block;
        width: 16px;
        height: 16px;
        flex-shrink: 0;
      }

      .chart-question {
        margin: 1.5rem 0 0;
        max-width: none;
        font-family: var(--font-serif);
        font-style: italic;
        font-size: 1rem;
        line-height: 1.5;
        color: var(--ink-soft);
      }

      @media (min-width: 700px) {
        .image-row-detail { grid-template-columns: 1fr 1fr; }
      }

      .placeholder {
        display: grid;
        place-items: center;
        aspect-ratio: 21 / 9;
        border: 1px dashed var(--line-strong);
        background: #ffffff;
        color: var(--ink-faint);
        font-family: var(--font-body);
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      /* Feature bands (brand-color, full-bleed) --------------------------- */
      .feature-band {
        display: grid;
        grid-template-columns: 1fr;
      }

      .feature-band-blue { background: #97add1; }
      .feature-band-coral { background: #e28a8a; }

      /* Guide's Solved Pain Points / Built on Trust images (12.webp,
         13.webp) are tall phone-portrait screenshots, unlike SureCall's
         wider feature-band images. Capping + insetting them here (rather
         than stretching full-bleed) matches the smaller, padded phone
         footprint SureCall's feature bands render at. */
      .feature-media {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: clamp(2rem, 5vw, 3.5rem);
      }

      .feature-media img {
        display: block;
        width: auto;
        max-width: 100%;
        height: auto;
        max-height: clamp(220px, 28vw, 360px);
        object-fit: contain;
      }

      .feature-text {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: clamp(2rem, 5vw, 3.5rem);
      }

      .feature-heading {
        font-family: var(--font-serif);
        font-weight: 400;
        font-style: italic;
        font-size: clamp(1.6rem, 3vw, 2.1rem);
        color: #1d2b3f;
        margin: 0 0 0.6rem;
      }

      .feature-text p {
        margin: 0;
        max-width: none;
        font-size: 1rem;
        line-height: 1.6;
        color: rgba(29, 43, 63, 0.75);
      }

      .pinpoint-row {
        list-style: none;
        margin: 1.5rem 0 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
      }

      .pinpoint-row li {
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 0.8rem;
        color: #1d2b3f;
        background: rgba(253, 251, 249, 0.55);
        border: 1px solid rgba(29, 43, 63, 0.2);
        border-radius: 999px;
        padding: 0.4em 0.9em;
      }

      .feature-text strong,
      .feature-text em { color: #1d2b3f; }

      @media (min-width: 800px) {
        .feature-band { grid-template-columns: 1fr 1fr; }
        .feature-band-reverse .feature-media { order: 2; }
        .feature-band-reverse .feature-text { order: 1; }
      }

      /* Challenge cards --------------------------------------------------- */
      .challenge-head {
        display: flex;
        flex-direction: column;
        gap: 1.1rem;
        margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
      }

      .challenge-head .quirky {
        margin-top: -0.2rem;
      }

      .challenge-head h2 {
        color: var(--bg);
        margin: 0;
      }

      .quirky {
        font-family: var(--font-quirky);
        font-size: 1.2rem;
        color: #97add1;
        transform: rotate(-3deg);
        display: inline-block;
      }

      .challenge-grid {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
      }

      .challenge-card {
        --tilt-x: 0deg;
        --tilt-y: 0deg;
        border: 1px solid rgba(253, 251, 249, 0.15);
        border-left: 3px solid rgba(253, 251, 249, 0.15);
        padding: 1.5rem;
        background: rgba(253, 251, 249, 0.03);
        transform: perspective(700px) rotateX(var(--tilt-x)) rotateY(var(--tilt-y));
        transition: background 0.3s ease, border-color 0.3s ease, transform 0.3s var(--ease-out);
      }

      .challenge-card p {
        margin: 0.75rem 0 0;
        max-width: none;
        color: rgba(253, 251, 249, 0.45);
        font-size: 1rem;
        line-height: 1.6;
      }

      .challenge-num {
        font-family: var(--font-body);
        font-weight: 800;
        font-size: 1.5rem;
        color: rgba(253, 251, 249, 0.35);
      }

      .challenge-card.is-active {
        background: rgba(253, 251, 249, 0.08);
        border-color: rgba(253, 251, 249, 0.3);
        border-left-color: #97add1;
      }

      .challenge-card.is-active .challenge-num { color: #97add1; }

      .challenge-card.is-active p {
        color: var(--bg);
        font-weight: 500;
      }

      @media (min-width: 700px) {
        .challenge-grid { grid-template-columns: repeat(3, 1fr); }
      }

      /* Up next --------------------------------------------------------------- */
      .up-next { padding-block: clamp(3rem, 7vw, 5rem); }

      .tight.up-next { padding-block: clamp(1.5rem, 3.5vw, 2.25rem); }

      .up-next-row {
        --tilt-x: 0deg;
        --tilt-y: 0deg;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1.5rem;
        margin-top: 1rem;
        text-decoration: none;
      }

      .up-next-row img {
        width: 100px;
        aspect-ratio: 1;
        object-fit: cover;
        border: 1px solid var(--line);
        transform: perspective(700px) rotateX(var(--tilt-x)) rotateY(var(--tilt-y));
        transition: transform 0.3s var(--ease-out);
      }

      .up-next-row h2 {
        margin: 0;
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(1.6rem, 4vw, 2.2rem);
        color: var(--ink);
      }

      .up-next-row p {
        margin: 0.25rem 0 0;
        color: var(--ink-faint);
        font-size: 0.9rem;
      }

      .btn-outline {
        margin-left: auto;
        border: 1px solid var(--ink);
        border-radius: 999px;
        padding: 0.5em 1.2em;
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--ink);
      }

      /* Footer ------------------------------------------------------------------ */
      .footer { text-align: center; }

      .footer-heading {
        color: var(--bg);
        font-size: clamp(2.5rem, 7vw, 4.5rem);
        font-family: var(--font-display);
        font-weight: 400;
      }

      .footer-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1rem;
        margin: 1.5rem 0 2rem;
      }

      .footer .btn-pill { border-color: var(--bg); color: var(--bg); }
      .footer .btn-pill-solid { background: var(--bg); color: var(--ink); }

      .footer-social {
        color: rgba(253, 251, 249, 0.7);
        font-family: var(--font-body);
        font-weight: 600;
        text-decoration: none;
      }
    
      /* Opinion asides — what I make of each stage, kept visually
         separate from the account of what happened. */
      .take {
        max-width: 60ch;
        margin: 2rem 0 0;
        padding-left: 1.1rem;
        border-left: 3px solid #1a50e0;
        font-family: var(--font-body);
        font-size: 1rem;
        line-height: 1.7;
        color: var(--ink-soft);
      }

      .take strong { color: var(--ink); font-weight: 700; }

      .take-label {
        display: block;
        margin-bottom: 0.35rem;
        font-family: var(--font-quirky);
        font-size: 1.05rem;
        color: #1a50e0;
      }
</style>
  </body>
</html>
