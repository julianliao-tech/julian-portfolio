---
const base = import.meta.env.BASE_URL;
const here = Astro.url.pathname.replace(/\/+$/, '');
const isActive = (href: string) => here === href.replace(/\/+$/, '');

const links = [
  { label: 'Home', href: base },
  { label: 'About', href: `${base}about/` },
  { label: 'Photos', href: `${base}photos/` },
];
---
<header class="nav" data-nav>
  <div class="nav-inner wrap">
    <a class="wordmark" href={base}>
      <span class="mark" aria-hidden="true"></span>
      <span class="wordmark-text">Julian Liao</span>
    </a>

    <nav class="links" aria-label="Primary">
      {links.map((link) => (
        <a
          class:list={['navlink', { 'is-active': isActive(link.href), 'is-home': link.label === 'Home' }]}
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}

      <span class="divider" aria-hidden="true"></span>

      <a
        class="icon"
        href="https://www.linkedin.com/in/julian-liao-475685239/"
        target="_blank"
        rel="noreferrer"
        aria-label="LinkedIn"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
      </a>
      <a class="icon" href="mailto:julianliaowork@gmail.com" aria-label="Email Julian">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
      </a>
    </nav>
  </div>
  <div class="progress" data-progress aria-hidden="true"></div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid transparent;
    transition: transform 0.5s var(--ease-out), background 0.4s var(--ease),
      border-color 0.4s var(--ease), backdrop-filter 0.4s var(--ease);
  }

  .nav.is-stuck {
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    border-bottom-color: var(--line);
  }

  .nav.is-hidden {
    transform: translateY(-101%);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: clamp(0.85rem, 1.6vw, 1.25rem);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--ink);
    white-space: nowrap;
  }

  .mark {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 0 var(--accent-soft);
    transition: transform 0.4s var(--ease-out), box-shadow 0.4s var(--ease);
  }

  .wordmark:hover .mark {
    transform: scale(1.35);
    box-shadow: 0 0 0 6px var(--accent-soft);
  }

  .links {
    display: flex;
    align-items: center;
    gap: clamp(0.85rem, 2vw, 1.75rem);
  }

  .navlink {
    position: relative;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-small);
    letter-spacing: -0.01em;
    color: var(--ink-soft);
    padding-block: 0.25rem;
    transition: color 0.3s var(--ease);
  }

  .navlink::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.45s var(--ease-out);
  }

  .navlink:hover,
  .navlink:focus-visible {
    color: var(--ink);
  }

  .navlink:hover::after,
  .navlink:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .navlink.is-active {
    color: var(--ink);
  }

  .navlink.is-active::after {
    background: var(--accent);
    transform: scaleX(1);
  }

  .divider {
    width: 1px;
    height: 16px;
    background: var(--line-strong);
  }

  .icon {
    display: grid;
    place-items: center;
    color: var(--ink-soft);
    transition: color 0.3s var(--ease), transform 0.3s var(--ease-out);
  }

  .icon:hover {
    color: var(--accent);
    transform: translateY(-2px);
  }

  .progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), #ff9f6b);
    transform: scaleX(0);
    transform-origin: left center;
  }

  @media (max-width: 560px) {
    /* The wordmark already goes home. */
    .navlink.is-home { display: none; }
    .divider { display: none; }
    .wordmark-text { font-size: 0.95rem; }
  }
</style>
