---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const consultingWork = {
  slug: 'consulting-work',
  title: 'Consulting Work',
  tileImage: `${base}images/home/tile-consulting-work.webp`,
  tileAlt: 'Consulting project thumbnails: Q-Bakehouse and MCBC Pink Moon',
};

const cards = [
  ...projects.map((p) => ({
    href: `${base}work/${p.id}/`,
    title: p.data.title,
    image: p.data.tileImage,
    alt: p.data.tileAlt,
  })),
  {
    href: `${base}work/${consultingWork.slug}/`,
    title: consultingWork.title,
    image: consultingWork.tileImage,
    alt: consultingWork.tileAlt,
  },
];

const pad = (n: number) => String(n).padStart(2, '0');
---
<BaseLayout title="Julian Liao — UX Designer">
  <section class="hero">
    <div class="aurora" aria-hidden="true" data-parallax="0.06"></div>

    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="eyebrow rise" style="--d: 40ms">UX Designer</p>
        <h1 class="hero-title">
          <span class="line rise" style="--d: 120ms">Hello, I'm</span>
          <span class="line rise" style="--d: 200ms">Julian <span class="wave" aria-hidden="true">👋</span></span>
        </h1>
        <p class="hero-sub rise" style="--d: 300ms">
          UX designer focused on <em class="serif">intuitive</em> and
          <em class="serif">accessible</em> user experiences.
        </p>
        <p class="hero-school rise" style="--d: 380ms">
          <span class="pip" aria-hidden="true"></span>Student @ The University of Michigan
        </p>
      </div>

      <div class="hero-portrait rise" style="--d: 300ms">
        <div class="portrait-float" data-parallax="0.05">
          <div class="portrait-ring" aria-hidden="true"></div>
          <img
            src={`${base}images/home/profile-illustration.webp`}
            alt="Illustrated portrait of Julian Liao"
            width="136"
            height="204"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>

    <a class="scroll-cue rise" style="--d: 620ms" href="#work">
      <span>Scroll</span>
      <span class="cue-rail" aria-hidden="true"><span class="cue-dot"></span></span>
    </a>
  </section>

  <section id="work" class="work wrap">
    <div class="section-head" data-reveal>
      <h2>Projects</h2>
      <span class="section-count">{pad(cards.length)}</span>
    </div>

    <ol class="work-grid">
      {cards.map((card, i) => (
        <li data-reveal data-reveal-delay={(i % 2) * 90}>
          <a class="card" href={card.href}>
            <span class="card-media">
              <img class="reveal-zoom" src={card.image} alt={card.alt} loading="lazy" decoding="async" />
            </span>
            <span class="card-foot">
              <span class="card-index">{pad(i + 1)}</span>
              <span class="card-title">{card.title}</span>
              <span class="card-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M7 17 17 7M9 7h8v8"/></svg>
              </span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<style>
  /* Hero ---------------------------------------------------------- */
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(4rem, 11vw, 9rem) clamp(4rem, 9vw, 7rem);
    overflow: hidden;
  }

  /* A single quiet wash, not a saturated dark-mode gradient blob —
     matches the flourish-free reference sites. */
  .aurora {
    position: absolute;
    z-index: -1;
    top: -30%;
    left: 50%;
    width: min(70rem, 130vw);
    aspect-ratio: 1 / 1;
    transform: translateX(-50%);
    background: radial-gradient(circle at 42% 40%, var(--accent-soft), transparent 55%);
    filter: blur(20px);
    pointer-events: none;
  }

  .hero-inner {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }

  .hero-title {
    font-size: var(--step-display);
    line-height: 0.98;
    letter-spacing: -0.01em;
    margin: 0 0 var(--space-3);
  }

  .hero-title .line {
    display: block;
  }

  .wave {
    display: inline-block;
    transform-origin: 70% 70%;
    animation: wave 2.8s var(--ease) 1.2s 2;
  }

  @keyframes wave {
    0%, 60%, 100% { transform: rotate(0deg); }
    10% { transform: rotate(14deg); }
    20% { transform: rotate(-8deg); }
    30% { transform: rotate(14deg); }
    40% { transform: rotate(-4deg); }
    50% { transform: rotate(10deg); }
  }

  .hero-sub {
    font-size: clamp(1.15rem, 2.1vw, 1.75rem);
    line-height: 1.35;
    color: var(--ink);
    max-width: 22ch;
    margin-bottom: var(--space-3);
  }

  .hero-sub em {
    color: var(--accent);
    font-size: 1.1em;
  }

  .hero-school {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--step-small);
    color: var(--ink-soft);
    margin: 0;
    padding: 0.5rem 1rem 0.5rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: var(--r-full);
    background: rgba(16, 16, 16, 0.03);
  }

  .pip {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  /* The illustration is a transparent cut-out, so it sits straight on
     the page with a warm glow behind it rather than in a frame. */
  .hero-portrait {
    width: min(210px, 46vw);
    justify-self: start;
  }

  .portrait-float {
    position: relative;
    will-change: transform;
  }

  .hero-portrait img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
  }

  .portrait-ring {
    position: absolute;
    inset: -28% -34%;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 45%, var(--accent-soft), transparent 64%);
    filter: blur(22px);
  }

  .scroll-cue {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    margin-left: var(--gutter);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--step-micro);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-faint);
    text-decoration: none;
    transition: color 0.3s var(--ease);
  }

  .scroll-cue:hover { color: var(--ink); }

  .cue-rail {
    position: relative;
    width: 1px;
    height: 44px;
    background: var(--line-strong);
    overflow: hidden;
  }

  .cue-dot {
    position: absolute;
    left: -1px;
    top: 0;
    width: 3px;
    height: 12px;
    border-radius: 2px;
    background: var(--accent);
    animation: cue 2.4s var(--ease) infinite;
  }

  @keyframes cue {
    0% { transform: translateY(-14px); opacity: 0; }
    35% { opacity: 1; }
    100% { transform: translateY(44px); opacity: 0; }
  }

  @media (min-width: 900px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    }
    .hero-portrait { justify-self: end; width: min(270px, 24vw); }
  }

  /* Work grid ------------------------------------------------------ */
  .work {
    padding-block: clamp(3rem, 7vw, 6rem) var(--space-6);
  }

  /* Work grid --------------------------------------------------------
     Display cards, carried over from the previous layout, rebuilt on
     the new warm-light tokens: sharp image corners (--r-lg is now
     0px), the new blue accent, and Instrument Serif for the title
     instead of a bold geometric sans (the serif has no 700 weight,
     so the title relies on size rather than weight for presence). */
  .work-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .card {
    display: block;
    text-decoration: none;
  }

  .card-media {
    display: block;
    position: relative;
    overflow: hidden;
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    background: var(--bg-elev);
  }

  .card-media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.9s var(--ease-out), filter 0.6s var(--ease);
  }

  .card:hover .card-media img,
  .card:focus-visible .card-media img {
    transform: scale(1.045);
  }

  .card-foot {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-2);
    padding-top: var(--space-3);
  }

  .card-index {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--step-micro);
    letter-spacing: 0.18em;
    color: var(--ink-faint);
    padding-top: 0.2em;
    align-self: start;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.3vw, 1.85rem);
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--ink);
    transition: color 0.3s var(--ease);
  }

  .card:hover .card-title { color: var(--accent); }

  .card-arrow {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--ink-soft);
    transition: transform 0.45s var(--ease-out), background 0.35s var(--ease),
      color 0.35s var(--ease), border-color 0.35s var(--ease);
  }

  .card:hover .card-arrow {
    transform: translate(3px, -3px);
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  @media (min-width: 860px) {
    .work-grid {
      grid-template-columns: 1fr 1fr;
      column-gap: clamp(2rem, 4vw, 4rem);
      /* Room for the offset column, which sits outside layout flow. */
      padding-bottom: clamp(2rem, 5vw, 4.5rem);
    }
    /* Offset lives on the card, not the <li>: the <li> owns the
       scroll-reveal transform. */
    .work-grid > li:nth-child(even) .card {
      transform: translateY(clamp(2rem, 5vw, 4.5rem));
    }
  }

  /* Entrance ------------------------------------------------------- */
  .rise {
    animation: rise 0.95s var(--ease-out) both;
    animation-delay: var(--d, 0ms);
  }

  @keyframes rise {
    from { opacity: 0; transform: translate3d(0, 28px, 0); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .rise { animation: none; }
    .wave, .cue-dot { animation: none; }
    .work-grid > li:nth-child(even) .card { transform: none; }
  }
</style>
