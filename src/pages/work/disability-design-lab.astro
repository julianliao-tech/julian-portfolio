];

const marqueeWords = Array(5).fill('DISABILITY DESIGN LAB');

const decisions = [
  {
    num: '01',
    title: 'Browse by daily challenge, not product category',
    body:
      'Four challenges lead the homepage and the nav: Opening Containers, Getting Dressed, Writing & Drawing, Navigating Your Workspace. My assumption is that people arrive naming the task that stopped working, not a product type. Shop all is still there, as the second way in.',
  },
  {
    num: '02',
    title: 'Two typefaces, two jobs',
    body:
      'Atkinson Hyperlegible sets everything a shopper has to read. The Braille Institute drew it to separate the characters low vision readers confuse. Space Grotesk is limited to headings and short labels, so the aesthetic never touches the sentence someone reads to decide whether a tool fits their hand.',
  },
  {
    num: '03',
    title: 'Raw on the chrome, clean on the content',
    body:
      'Every hand drawn mark sits on the chrome (card outlines, chips, dividers, the rule under a heading), and each stroke is genuinely wobbled geometry drawn in two offset passes. NN/g warns that neobrutalism can strip the affordances that signal what is a control, so the controls and the copy stay conventional.',
  },
];

// Eight pages, each at both breakpoints. The desktop crop is what the
// grid shows; the mobile frame sits beside it in the second row.
const screens = [
  { name: 'Homepage', note: 'Leads with the four challenges', file: 'homepage' },
  { name: 'Catalogue', note: 'Filter sidebar, grid three wide', file: 'catalogue' },
  { name: 'Product detail', note: 'Variant chips, stepper, disclosures', file: 'product-detail' },
  { name: 'Quick view', note: 'A modal on a dimmed page', file: 'quickview' },
  { name: 'Shopping cart', note: 'Line items beside a running total', file: 'cart' },
  { name: 'Checkout', note: 'No account required', file: 'checkout' },
  { name: 'Order confirmed', note: 'Same arithmetic as the cart', file: 'confirmed' },
  { name: '404', note: 'The hand drawn mascot, between the fours', file: 'error404' },
];

