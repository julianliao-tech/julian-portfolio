---
// ---------------------------------------------------------------------
// Case study page.
// Rebuilt to match the SureCall case-page design reference
// section-for-section: hero banner, a two-direction horizontal marquee
// with a phone video slot, a context callout beside the title, the
// "Signal Page Iteration" and C-Band comparison images, two full-bleed
// green feature bands (Confidence During Setup / Signal Strength,
// Translated), Design Kit, and the closing phone collage. Sections
// present in earlier drafts but absent from this reference (Pain
// Points, Mapping the Flow) are dropped to match it exactly.
//
// Two things called out as intentional, not bugs: images/video frames
// that don't fill their box are left as-is (reference does this too),
// and any text box whose fill didn't match its section's background in
// the reference has been converted to match (the "SureCall partnered
// with Verizon..." context box, and the two feature captions in the
// green bands) rather than reproduced as a mismatched white box.
//
// Two pieces of media are real videos in the reference (the phone in
// the marquee, and the final prototype phone) that don't exist as
// files yet — left as empty labeled placeholders per your instruction,
// ready to swap in once you add them. Everything else is a real asset
// already in public/images/surecall/ — nothing invented.
// ---------------------------------------------------------------------
import '../../styles/global.css';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Lightbox from '../../components/Lightbox.astro';

const base = import.meta.env.BASE_URL;
const pageTitle = 'SureCall and Verizon Mobile Application · Julian Liao';
const pageDescription = 'A field tool for installing and testing Verizon 5G boosters';
const ogImage = new URL(`${base}images/home/profile-illustration.webp`, Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);
const img = (n: string) => `${base}images/surecall/${n}`;

const meta = [
  { label: 'Timeline', value: '10 Weeks' },
  { label: 'Role', value: 'UX Designer' },
  { label: 'Type of Work', value: ['Mobile App', 'Client Work'] },
  { label: 'Tools', value: ['Figma', 'Slack', 'FigJam', 'Miro'] },
  {
    label: 'Skills',
    value: ['Wireframing', 'Prototyping', 'Design Systems', 'Interaction Design', 'Information Architecture'],
  },
];

const challenges = [
  'Turn a live signal number into something a person can read at a glance.',
  'Explain what 5G UW is without handing anybody a manual.',
  'Work for someone on a ladder, in a basement, with one hand free.',
];

const takeaways = [
  {
    title: 'Design for the worst conditions, not the demo',
    body: 'Bad light, one free hand, a garage that had no signal to begin with. Every screen had to hold its own weight, because out there nobody gets a second guess.',
  },
  {
    title: 'Engineers will tell you what is cheap to build',
    body: "SureCall's backend engineers flagged what was easy and what was painful, and it changed what I drew. Now I ask before I draw instead of after.",
  },
];

const marqueeWords = Array(6).fill('5G BOOSTER APP');

const nextProject = {
  title: 'connexU',
  subtitle: 'Five out of five people could not find how to register. So I rebuilt it.',
  image: `${base}images/home/tile-connexu.png`,
  href: `${base}work/connexu/`,
};
---

{/* prettier-ignore */}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#fdfbf9" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={canonical.href} />
    <meta name="description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta name="twitter:card" content="summary_large_image" />
