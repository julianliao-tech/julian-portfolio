---
import { getCollection, render } from 'astro:content';
import ProjectLayout from '../../layouts/ProjectLayout.astro';

// These projects have their own bespoke pages in this folder, so they're
// excluded here to avoid a route collision — their content-collection
// entries still feed the Home grid tiles and the prev/next pager order.
export async function getStaticPaths() {
  const bespokePages = ['michigan-chatgpt', 'surecall', 'guide', 'connexu', 'elink'];
  const projects = await getCollection('projects');
  return projects
    .filter((entry) => !bespokePages.includes(entry.id) && !entry.data.draft)
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<ProjectLayout
  title={entry.data.title}
  role={entry.data.role}
  timeline={entry.data.timeline}
  team={entry.data.team}
  tools={entry.data.tools}
  skills={entry.data.skills}
  order={entry.data.order}
  tileImage={entry.data.tileImage}
  tileAlt={entry.data.tileAlt}
  nextOverrideHref={entry.data.nextOverrideHref}
  nextOverrideTitle={entry.data.nextOverrideTitle}
>
  <Content />
</ProjectLayout>
