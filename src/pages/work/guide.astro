---
// ---------------------------------------------------------------------
// Case study page.
// Same architecture built for the SureCall and Michigan ChatGPT format
// tests (full-bleed images between narrow text, a marquee intro, a
// brand-color stat band, dark "Challenge" sections, brand-color
// feature bands, tilt/lightbox/scroll-progress interactions), applied
// here to the Guide app's own real content and its own real brand
// colors — periwinkle blue #97ADD1, coral #E28A8A, and mint green
// #97D1A3, all pulled directly from the Design Kit asset (15.webp),
// not guessed.
//
// Every fact and every image is pulled from
// src/content/projects/guide.md and public/images/guide/ — nothing
// invented. Guide has exactly three challenges in the source doc, so
// (like SureCall) this uses three separate interleaved "Challenge"
// sections rather than one combined grid. There's no stated project
// location in the source doc, so — unlike the SureCall/Michigan
// pages — there's no location band here; a real stat band (4-week
// timeline, 20+ survey responses, 3 core functions, all literally
// counted from the source doc) stands in its place instead.
// ---------------------------------------------------------------------
import '../../styles/global.css';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Lightbox from '../../components/Lightbox.astro';

const base = import.meta.env.BASE_URL;
const pageTitle = 'Guide Mobile Application · Julian Liao';
const pageDescription = 'A wheelchair-accessible navigation app for safer, independent travel';
const ogImage = new URL(`${base}images/home/profile-illustration.webp`, Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);
const img = (n: string) => `${base}images/guide/${n}`;

const meta = [
  { label: 'Timeline', value: '4 Weeks' },
  { label: 'Role', value: ['UX Designer', 'UX Researcher'] },
  { label: 'Team', value: 'Just Me!' },
  { label: 'Tools', value: ['Figma', 'FigJam', 'Miro'] },
  {
    label: 'Skills',
    value: ['Wireframing', 'Prototyping', 'Design Systems', 'Interaction Design', 'User Research'],
  },
];

const challenges = [
  'Work out which obstacles actually change a trip, and leave the rest off the map.',
  'Tell somebody an elevator is coming up without making them stop to read.',
  'Design for a person already moving, who cannot study their phone.',
];

const painPoints = ['Elevators', 'Ramps', 'Crowds', 'Bathrooms', 'Report'];
const trustPoints = ['Elevator Status', 'Ramp Conditions', 'Reported Obstacles'];

// Percentages measured directly from the real donut charts (surveytwo.png,
// the Confidence Level screenshot) — not invented.
const surveyCharts = [
  {
    title: 'Knowledge',
    question: 'Have you ever used an app, map or website that included accessibility information about a public space?',
    segments: [
      { label: 'No', pct: 80, color: '#162e5f' },
      { label: 'Yes', pct: 20, color: '#1a50e0' },
    ],
  },
  {
    title: 'Confidence Level',
    question: 'If a friend/family member asked you for advice about which public spaces are accessible, how confident would you feel giving them accurate info?',
    segments: [
      { label: 'Not Very Confident', pct: 58, color: '#162e5f' },
      { label: 'Somewhat Confident', pct: 32, color: '#1c50de' },
      { label: 'Other', pct: 10, color: '#6093e4' },
    ],
  },
];

const conicGradient = (segments: { pct: number; color: string }[]) => {
  let acc = 0;
  const stops = segments.map((s) => {
    const start = acc;
    acc += s.pct;
    return `${s.color} ${start}% ${acc}%`;
  });
  return `conic-gradient(${stops.join(', ')})`;
};

const marqueeWords = Array(6).fill('TRAVELIN’ SAFE');

const nextProject = {
  title: 'Michigan ChatGPT',
  subtitle: 'Four campus AI tools nobody could tell apart, rebuilt into one front door',
  image: `${base}images/home/tile-michigan-chatgpt.webp`,
  href: `${base}work/michigan-chatgpt/`,
};
---

{/* prettier-ignore */}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#fdfbf9" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={canonical.href} />
    <meta name="description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,600&family=Instrument+Serif:ital@0;1&family=Permanent+Marker&display=swap"
    />
  </head>
  <body>
    <Nav />

    <div data-zoom-group data-zoom-scan>
      <section class="hero-banner">
        <img data-tilt src={img('01.webp')} alt="Guide app screens on a blue background: the Travelin' Safe title screen, a Nearby listing of accessible spots, and the G logo" />
      </section>

      <section class="marquee-section" aria-hidden="true">
        <div class="marquee-row">
          <div class="marquee-track marquee-track-left">
            {[...marqueeWords, ...marqueeWords].map((w) => <span>{w}</span>)}
          </div>
        </div>
        <div class="marquee-row">
          <div class="marquee-track marquee-track-right">
            {[...marqueeWords, ...marqueeWords].map((w) => <span>{w}</span>)}
          </div>
        </div>
        <div class="marquee-row">
          <div class="marquee-track marquee-track-left">
            {[...marqueeWords, ...marqueeWords].map((w) => <span>{w}</span>)}
          </div>
        </div>
        <div class="marquee-row">
          <div class="marquee-track marquee-track-right">
            {[...marqueeWords, ...marqueeWords].map((w) => <span>{w}</span>)}
          </div>
        </div>
        <div class="marquee-phone">
          <div class="phone-frame">
            <video src={img('marquee-banner.mp4')} autoplay muted loop playsinline aria-label="Screen recording of the Guide app opening to the G logo"></video>
          </div>
        </div>
      </section>

      <section class="head-block">
        <div class="wrap">
          <div class="head-top">
            <h1 class="title">Guide</h1>
            <div class="context-box">
              <p class="context-label">Where this started</p>
              <h2 class="context-heading">Planning the route should not cost more than the trip</h2>
              <p>Guide is a navigation app for wheelchair users. It does three things: route you along paths that actually comply with the ADA, warn you about obstacles and crowds before you reach them, and show what is nearby (elevators, ramps, accessible restrooms) while you are still deciding. The point is that you know what is coming, so a trip stops being a gamble you take and starts being a trip you take.</p>
            </div>
          </div>

          <dl class="meta">
            {meta.map((m) => (
              <div>
                <dt>{m.label}</dt>
                <dd>{Array.isArray(m.value) ? m.value.map((v) => <span>{v}</span>) : m.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      <section class="white-block personal-section">
        <div class="wrap personal-grid">
          <div class="personal-text">
            <p class="eyebrow-label">Why this one</p>
            <h2>My brothers used wheelchairs, and every trip out took planning</h2>
            <p>Two of my brothers, Nate and Jake, used wheelchairs. They lived with epidermolysis bullosa, which leaves the skin fragile and prone to blistering, so a short trip out of the house was never a short trip. Somebody had to know in advance where the ramps were, which door worked, whether there would be a crowd.</p>
            <p>Watching that taught me how often people with disabilities get quietly left out of ordinary days, and how rarely anybody builds for it. I had been thinking about this app for years before I had the skills to draw it. It is the most personal project in this portfolio, and the intent behind it is simple: <strong>most people get to assume a route will work. I wanted to build the thing that removes the assuming for everyone else.</strong></p>
          </div>
          <div class="personal-photos">
            <img data-tilt src={img('personal-01.webp')} alt="Julian as a child with his brothers, one recovering from a bandaged arm, in a family photo" />
            <img data-tilt src={img('personal-02.webp')} alt="An earlier childhood photo of Julian with his brothers Nate and Jake" />
          </div>
        </div>
      </section>

      <section class="head-block head-block-tail">
        <div class="wrap">
          <p class="pull-quote" data-typewriter>
            <span aria-hidden="true"><span class="tw-seg" data-full="How do you make a route feel certain "></span><span class="tw-seg pull-quote-highlight" data-full="before somebody is already out in it"></span><span class="tw-seg" data-full=", travelling alone?"></span></span>
            <span class="sr-only">How do you make a route feel certain before somebody is already out in it, travelling alone?</span>
          </p>
        </div>
      </section>

      <section class="dark-block">
        <div class="wrap">
          <div class="challenge-head">
            <span class="quirky">Obstacles</span>
            <h2>An obstacle you discover on arrival is not information</h2>
          </div>
          <ol class="challenge-grid">
            {challenges.map((c, i) => (
              <li class:list={['challenge-card', { 'is-active': i === 0 }]} data-tilt>
                <span class="challenge-num">{String(i + 1).padStart(2, '0')}</span>
                <p>{c}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="white-block tight">
        <div class="wrap">
          <h2>Four out of five people had never seen accessibility info in a map</h2>
          <p>I ran a survey with over 20 responses and sat down with people who either have a disability or travel regularly with someone who does. The survey gave me the spread; the interviews told me why. The same two complaints came back every time: the path itself was not usable, and there was no way to find that out before setting off. <strong>That second one is the real product.</strong> Everything I drew after this points at it.</p>
          <p class="take">
            <span class="take-label">What I think about this stage</span>
            The survey told me the problem was common. The interviews told me what it costs somebody.
            I have come to think <strong>numbers are mostly for convincing other people, and
            conversations are for knowing what to build</strong>. If I could only run one, I would run
            the interviews every time and lose the chart.
          </p>
        </div>
        <div class="image-row-single image-row-single-wide">
          <img data-tilt src={img('02-quotes-cropped.webp')} alt="Three quotes from survey respondents about inconsistent doors and elevators, missing ADA-accessible entrances, and difficulty maneuvering a wheelchair through crowds" />
        </div>
      </section>

      <section class="white-block tight">
        <div class="wrap">
          <p class="eyebrow-label">What kept coming up</p>
        </div>
        <div class="image-row-single image-row-single-wide">
          <img data-tilt src={img('04.webp')} alt="Four key insights: most common travel issues, low confidence providing accessibility info, high demand for real-time data, and frequent visitors noticing accessibility issues firsthand" />
        </div>
      </section>

      <section class="white-block tight">
        <div class="image-row-single image-row-single-wide">
          <img data-tilt src={img('03.webp')} alt="Accessibility App Affinity Diagram grouping wheelchair-user research feedback into themes: Physical Barriers in Public, Information Gaps, Inconsistent Maintenance & Upkeep, Confidence in Recommending Accessible Spaces, and Desired App Features" />
        </div>
      </section>

      <section class="white-block tight">
        <div class="wrap">
          <p class="eyebrow-label">The numbers behind it</p>
          <div class="chart-grid">
            {surveyCharts.map((chart) => (
              <div class="chart-card">
                <h3 class="chart-title">{chart.title}</h3>
                <div class="chart-row">
                  <div class="donut" style={{ background: conicGradient(chart.segments) }}>
                    <span class="donut-hole"></span>
                  </div>
                  <ul class="chart-legend">
                    {chart.segments.map((s) => (
                      <li>
                        <span class="swatch" style={{ background: s.color }}></span>
                        {s.label}
                      </li>
                    ))}
                  </ul>
                </div>
                <p class="chart-question">"{chart.question}"</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="dark-block tight">
        <div class="wrap">
          <div class="challenge-head">
            <span class="quirky">Wayfinding</span>
            <h2>Nobody can read a screen while they are moving</h2>
          </div>
          <ol class="challenge-grid">
            {challenges.map((c, i) => (
              <li class:list={['challenge-card', { 'is-active': i === 1 }]} data-tilt>
                <span class="challenge-num">{String(i + 1).padStart(2, '0')}</span>
                <p>{c}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="white-block tight">
        <div class="wrap">
          <h2>What building personas actually taught me</h2>
          <p>I built personas out of the research for wheelchair users and for the people who travel with them. The useful part was not the finished documents. It was that writing them forced me to name the frustration behind each goal, and <em>two personas who want the same thing for different reasons need two different screens</em>. The mistake I made first was writing personas that agreed with the app I already wanted to build. The ones I kept are the ones that argued with it.</p>
          <div class="image-row image-row-detail image-row-personas">
            <img data-tilt src={img('05.webp')} alt="User persona: Joseph, 33, an Occupational Therapist with moderate tech comfort, with his goals, pain points, and needs" />
            <img data-tilt src={img('16.webp')} alt="User persona: Sarah, 28, a freelance graphic designer and wheelchair user in an urban area, with her goals, pain points, and needs" />
          </div>
        </div>
      </section>

      <section class="white-block tight">
        <div class="wrap">
          <p class="eyebrow-label">Mapping the <span class="accent">Flow</span></p>
        </div>
        <div class="image-row-single image-row-single-wide">
          <img data-tilt src={img('08.webp')} alt="User flow diagram for the Guide navigation app" />
        </div>
      </section>

      <section class="white-block tight">
        <div class="wrap">
          <h2>Sketching the route before drawing the app</h2>
          <p>I sketched rough wireframes to work out the flow and the layout, and to check which pieces of accessibility information people actually wanted and in what order. Quick to make, quick to throw away. <strong>Nobody argues with a sketch the way they argue with a finished screen</strong>, which is exactly why I stayed there as long as I could.</p>
          <div class="image-row-single">
            <img data-tilt src={img('09.webp')} alt="Low-fidelity wireframes exploring the Guide app's core screens" />
          </div>
        </div>
      </section>

      <section class="dark-block tight">
        <div class="wrap">
          <div class="challenge-head">
            <span class="quirky">On the move</span>
            <h2>The screen has to work at a glance, held at an angle</h2>
          </div>
          <ol class="challenge-grid">
            {challenges.map((c, i) => (
              <li class:list={['challenge-card', { 'is-active': i === 2 }]} data-tilt>
                <span class="challenge-num">{String(i + 1).padStart(2, '0')}</span>
                <p>{c}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="white-block tight">
        <div class="wrap">
          <h2>Three versions of the route screen, and why the third won</h2>
          <p>The first version drew the path and the obstacles but gave you no way to end the trip and no key for the icons, which is a map you have to learn before you can use it. Option 3 was the one that <strong>said what the symbols meant and let you stop, without adding a step to get there</strong>. It is not the prettiest of the three. It is the one you can use with a hand on a wheel.</p>
          <p class="take">
            <span class="take-label">What I think about this stage</span>
            Something I had to catch myself doing: when I put three options side by side I pick the
            best looking one, every single time, and then find reasons afterwards. So now I write down
            what the screen has to let somebody do before I lay the options out, and I judge each one
            against that list instead of against the other two.
            <strong>Comparing designs to each other is how a whole set of bad options starts looking
            fine.</strong>
          </p>
        </div>
        <div class="image-row-single image-row-single-wide">
          <img data-tilt src={img('10.webp')} alt="Three iterations of the navigation page, from a version without an end button to the final option with labeled icons" />
        </div>
      </section>

      <section class="white-block tight">
        <div class="wrap">
          <h2>The version with a Call button beat the better looking one</h2>
          <p>Option 1 looked clean because it was missing the address and the hours. Easy to look clean when you leave out what people came for. I picked Option 3: <em>a clear hierarchy, and one obvious thing to do next</em>. In testing, the dedicated "Call" button was what got people through the task, because the real question on that screen is not what is here, it is whether anyone can confirm the place will work when I arrive.</p>
        </div>
        <div class="image-row-single image-row-single-wide">
          <img data-tilt src={img('11.webp')} alt="Three iterations of the location detail page, ending in a version with a dedicated Call button and segmented data" />
        </div>
      </section>

      <section class="feature-band feature-band-blue feature-band-reverse tight">
        <div class="feature-media">
          <img data-tilt src={img('12.webp')} alt="Two Guide app screens showing an elevator-location callout and an important-alert callout over the map" />
        </div>
        <div class="feature-text">
          <h2 class="feature-heading">Five things people wanted to know before setting off</h2>
          <p>Everything people told me collapsed into five markers worth putting on a route: elevators, ramps, crowds, accessible restrooms, and a way to report something that is wrong. <em>Five is the number you can read at a glance</em>; I had a longer list and cutting it was most of the work. The report marker is the one I would defend hardest. It is the only one that keeps the map honest after I stop maintaining it.</p>
          <ul class="pinpoint-row">
            {painPoints.map((p) => <li>{p}</li>)}
          </ul>
        </div>
      </section>

      <section class="feature-band feature-band-blue tight">
        <div class="feature-media">
          <img data-tilt src={img('13.webp')} alt="Two Guide app screens: turn-by-turn directions to Warm Springs Plaza with an accessibility icon bar, and the surrounding map view" />
        </div>
        <div class="feature-text">
          <h2 class="feature-heading">A route is only trustworthy if somebody checked it recently</h2>
          <p>The app surfaces one route, the most accessible one with the fewest detours, and it favors paths that are maintained, marked, and <strong>confirmed by somebody recently</strong>. You can open any route to see elevator status, ramp condition and whatever has been reported. An accessibility map that nobody updates is worse than no map, because it gets believed. Recency is the feature.</p>
          <p class="take">
            <span class="take-label">What I think about this stage</span>
            This is the one piece I would push back on if a client asked me to build it. An accessibility
            map is a promise, and people plan their day around it. <strong>Shipping one and then not
            maintaining it is worse than never shipping it at all</strong>, because the failure lands on
            somebody standing outside a door that does not open. I would rather launch a smaller map that
            stays true than a complete one that rots.
          </p>
          <ul class="pinpoint-row">
            {trustPoints.map((p) => <li>{p}</li>)}
          </ul>
        </div>
      </section>

      <section class="white-block tight">
        <div class="wrap">
          <h2>How it ended up</h2>
        </div>
        <div class="prototype-phone">
          <video src={img('prototype.mp4')} autoplay muted loop playsinline aria-label="Screen recording of the Guide prototype: navigating from Home and Nearby through location detail, directions, and alerts"></video>
        </div>
      </section>

      <section class="white-block tight">
        <div class="wrap">
          <p class="eyebrow-label">The kit it is built from</p>
        </div>
        <div class="image-row-single image-row-single-wide">
          <img data-tilt src={img('15.webp')} alt="Guide app design kit: Work Sans typography scale, a blue/gray/coral color palette with hex codes, and the app's icon and button assets" />
        </div>
      </section>

      <section class="white-block white-block-flush-bottom tight">
        <div class="image-row-single image-row-single-full">
          <img data-tilt src={img('14.webp')} alt="A map of the full Guide app screen flow, from Home and Nearby through location detail, directions, search, and alert-description screens" />
        </div>
      </section>

      <section class="dark-block tight">
        <div class="wrap">
          <h2>Where it landed, and what I would change</h2>
          <p>Designing for somebody already in motion forced me to <em>cut everything down to what is essential</em>, and it turns out that is a much shorter list than I wanted it to be. That habit followed me into every project since.</p>
          <p>I ran every stage of this one myself, from the first survey response to the final prototype. If I picked it up again I would go back to the people I interviewed and test the finished flow on them, because I never closed that loop and it is the part I think about. <strong>This is the project I would still be working on if I could only keep one</strong>, and it is the reason I care about this field rather than just being good at it.</p>
        </div>
      </section>

      <section class="up-next tight">
        <div class="wrap">
          <span class="quirky">Up Next</span>
          <a class="up-next-row" href={nextProject.href} data-tilt>
            <img src={nextProject.image} alt="" />
            <div>
              <h2>{nextProject.title}</h2>
              <p>{nextProject.subtitle}</p>
            </div>
            <span class="btn-outline">View Project</span>
          </a>
        </div>
      </section>
    </div>

    <Footer />

    <Lightbox />

    <script>
      import '../../scripts/site.js';
      import '../../scripts/lightbox.js';

      const btn = document.querySelector('[data-copy-email]');
      btn?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText('julianliaowork@gmail.com');
          const original = btn.textContent;
          btn.textContent = 'Copied!';
          setTimeout(() => { btn.textContent = original; }, 1500);
        } catch {
          window.location.href = 'mailto:julianliaowork@gmail.com';
        }
      });

      document.querySelectorAll<HTMLVideoElement>('.marquee-phone video, .feature-media video, .prototype-phone video').forEach((v) => {
        v.play().catch(() => {});
      });

      // Typewriter effect on the pull-quote — types each segment in order
      // (plain text, then the highlighted phrase, then the trailing plain
      // text) once the quote scrolls into view. Reduced-motion and
      // no-IntersectionObserver both fall back to showing the full text.
      const quoteEl = document.querySelector<HTMLElement>('[data-typewriter]');
      if (quoteEl) {
        const segments = Array.from(quoteEl.querySelectorAll<HTMLElement>('.tw-seg'));
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const typeSegments = () => {
          let segIndex = 0;
          let charIndex = 0;
          const step = () => {
            if (segIndex >= segments.length) return;
            const seg = segments[segIndex];
            const full = seg.dataset.full ?? '';
            if (charIndex <= full.length) {
              seg.textContent = full.slice(0, charIndex);
              charIndex++;
              setTimeout(step, 28);
            } else {
              segIndex++;
              charIndex = 0;
              setTimeout(step, 28);
            }
          };
          step();
        };

        if (reduced || !('IntersectionObserver' in window)) {
          segments.forEach((seg) => { seg.textContent = seg.dataset.full ?? ''; });
        } else {
          const io = new IntersectionObserver((entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                typeSegments();
                obs.disconnect();
              }
            });
          }, { threshold: 0.4 });
          io.observe(quoteEl);
        }
      }
    </script>

    <style>
      :global(body) {
        background: #ffffff;
      }



      .wrap {
        max-width: 74rem;
        margin-inline: auto;
        padding-inline: clamp(1.25rem, 5vw, 3.5rem);
      }

      /* Nav ------------------------------------------------------------ */




