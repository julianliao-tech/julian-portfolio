  { name: 'Border/light', aliases: ['Amber/400', 'Cobalt Indigo/400', 'Green/400', 'Red/400'] },
  { name: 'Border/default', aliases: ['Cobalt Indigo/500', 'Amber/500', 'Green/500', 'Red/500'] },
  { name: 'Border/darker', aliases: ['Cobalt Indigo/600', 'Amber/600', 'Green/600', 'Red/600'] },
  { name: 'Text/label', aliases: ['Cobalt Indigo/500', 'Amber/500', 'Green/500', 'Red/500'] },
  { name: 'Text/white', aliases: ['Greyscale/0', 'Greyscale/0', 'Greyscale/0', 'Greyscale/0'] },
