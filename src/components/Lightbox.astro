---
// Modal image viewer. Markup is inert until src/scripts/lightbox.js
// finds a [data-zoomable] image on the page.
---
<dialog class="lb" data-lightbox aria-label="Image viewer">
  <button class="lb-btn lb-close" type="button" data-lb-close data-lb-control aria-label="Close image viewer">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg>
  </button>
  <button class="lb-btn lb-arrow lb-prev" type="button" data-lb-prev data-lb-control aria-label="Previous image" hidden>
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
  </button>
  <button class="lb-btn lb-arrow lb-next" type="button" data-lb-next data-lb-control aria-label="Next image" hidden>
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
  </button>

  <img class="lb-img" data-lb-img alt="" />

  <div class="lb-meta" data-lb-control>
    <span class="lb-counter" data-lb-counter></span>
    <p class="lb-caption" data-lb-caption></p>
  </div>
</dialog>

<style is:global>
  .lb {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    overflow: hidden;
  }

  .lb:not([open]) {
    display: none;
  }

  .lb::backdrop {
    background: rgba(5, 5, 7, 0.9);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    animation: lb-backdrop 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .lb.is-closing::backdrop {
    animation: lb-backdrop 0.3s cubic-bezier(0.16, 1, 0.3, 1) reverse both;
  }

  @keyframes lb-backdrop {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .lb-img {
    position: fixed;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    object-fit: contain;
    border-radius: 6px;
    transform-origin: top left;
    cursor: zoom-out;
    box-shadow: 0 40px 120px rgba(0, 0, 0, 0.6);
  }

  .lb-btn {
    position: fixed;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border-radius: 999px;
    border: 1px solid rgba(245, 243, 239, 0.16);
    background: rgba(18, 18, 22, 0.7);
    color: #f5f3ef;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }

  .lb-btn:hover {
    background: rgba(40, 40, 48, 0.9);
    border-color: rgba(245, 243, 239, 0.4);
  }

  .lb-btn[hidden] {
    display: none;
  }

  .lb-close {
    top: clamp(0.75rem, 2vw, 1.5rem);
    right: clamp(0.75rem, 2vw, 1.5rem);
  }

  .lb-arrow {
    top: 50%;
    margin-top: -22px;
  }

  .lb-prev { left: clamp(0.5rem, 2vw, 1.5rem); }
  .lb-next { right: clamp(0.5rem, 2vw, 1.5rem); }

  .lb-prev:hover { transform: translateX(-3px); }
  .lb-next:hover { transform: translateX(3px); }

  .lb-meta {
    position: fixed;
    left: 50%;
    bottom: clamp(0.75rem, 2.5vh, 1.75rem);
    transform: translateX(-50%);
    width: min(46rem, 90vw);
    text-align: center;
    animation: lb-meta-in 0.5s 0.15s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes lb-meta-in {
    from { opacity: 0; transform: translate(-50%, 8px); }
    to { opacity: 1; transform: translate(-50%, 0); }
  }

  .lb-counter {
    display: block;
    font-family: var(--font-display);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .lb-caption {
    margin: 0.4rem 0 0;
    max-width: none;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: rgba(245, 243, 239, 0.62);
  }

  @media (max-width: 560px) {
    .lb-caption { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lb::backdrop,
    .lb-meta {
      animation: none;
    }
  }
</style>
