---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

// Homepage-only teaser copy: a tag row + one-line outcome per project,
// condensed from each project's own case study (not new claims).
const teasers: Record<string, { tags: string[]; line: string }> = {
  guide: {
    tags: ['UX Research', 'Accessibility', 'Mobile App'],
    line: "Turn-by-turn routing and real-time obstacle alerts, shaped by a survey of 20+ wheelchair users and caregivers.",
  },
  'michigan-chatgpt': {
    tags: ['Product Design', 'UX Research', 'Information Architecture'],
    line: "Redesigned the University of Michigan's AI workspace into one cohesive hub, from a fragmented set of tools students avoided.",
  },
  surecall: {
    tags: ['UX Design', 'Mobile App', 'Client Work'],
    line: 'A 3-step signal-test flow that turns raw dBm readings into a confidence check anyone can read mid-install.',
  },
  'timecapsule-tunes': {
    tags: ['UX Design', 'Interaction Design', 'Mobile App'],
    line: 'A Spotify-powered app for finding music-based friend groups, built on a 40-response survey where 75% said music helps them bond.',
  },
  dominos: {
    tags: ['Marketing', 'UX Design', 'Client Work'],
    line: 'A minimalist, linear ordering flow for the Ann Arbor franchise site, built to keep food — not clutter — the focus.',
  },
  connexu: {
    tags: ['UX Research', 'Usability Testing', 'Client Work'],
    line: "A full rebuild of connexU's event site, closing the exact navigation and registration gaps two rounds of research turned up.",
  },
};

const consultingWork = {
  slug: 'consulting-work',
  title: 'Consulting Work',
  tags: ['Strategy', 'Brand', 'Client Work'],
  line: 'Two client deliverables from outside the case studies above — decks for Q-Bakehouse and MCBC Pink Moon.',
};

const cards = [
  ...projects.map((p) => ({
    href: `${base}work/${p.id}/`,
    title: p.data.title,
    tags: teasers[p.id]?.tags ?? p.data.skills.slice(0, 3),
    line: teasers[p.id]?.line ?? '',
  })),
  {
    href: `${base}work/${consultingWork.slug}/`,
    title: consultingWork.title,
    tags: consultingWork.tags,
    line: consultingWork.line,
  },
];

const pad = (n: number) => String(n).padStart(2, '0');
---
<BaseLayout title="Julian Liao — UX Designer">
  <section class="hero">
    <div class="aurora" aria-hidden="true" data-parallax="0.06"></div>

    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="eyebrow rise" style="--d: 40ms">UX Designer</p>
        <h1 class="hero-title">
          <span class="line rise" style="--d: 120ms">Hello, I'm</span>
          <span class="line rise" style="--d: 200ms">Julian <span class="wave" aria-hidden="true">👋</span></span>
        </h1>
        <p class="hero-sub rise" style="--d: 300ms">
          UX designer focused on <em class="serif">intuitive</em> and
          <em class="serif">accessible</em> user experiences.
        </p>
        <p class="hero-school rise" style="--d: 380ms">
          <span class="pip" aria-hidden="true"></span>Student @ The University of Michigan
        </p>
      </div>

      <div class="hero-portrait rise" style="--d: 300ms">
        <div class="portrait-float" data-parallax="0.05">
          <div class="portrait-ring" aria-hidden="true"></div>
          <img
            src={`${base}images/home/profile-illustration.webp`}
            alt="Illustrated portrait of Julian Liao"
            width="136"
            height="204"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>

    <a class="scroll-cue rise" style="--d: 620ms" href="#work">
      <span>Scroll</span>
      <span class="cue-rail" aria-hidden="true"><span class="cue-dot"></span></span>
    </a>
  </section>

  <section id="work" class="work wrap">
    <div class="section-head" data-reveal>
      <h2>Projects</h2>
      <span class="section-count">{pad(cards.length)}</span>
    </div>

    <ol class="work-list">
      {cards.map((card, i) => (
        <li data-reveal data-reveal-delay={(i % 3) * 70}>
          <a class="row" href={card.href}>
            <span class="row-index">{pad(i + 1)}</span>
            <span class="row-body">
              <span class="row-title">{card.title}</span>
              <span class="row-tags">{card.tags.join(' · ')}</span>
              {card.line && <span class="row-line">{card.line}</span>}
            </span>
            <span class="row-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M7 17 17 7M9 7h8v8"/></svg>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<style>
  /* Hero ---------------------------------------------------------- */
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(4rem, 11vw, 9rem) clamp(4rem, 9vw, 7rem);
    overflow: hidden;
  }

  /* A single quiet wash, not a saturated dark-mode gradient blob —
     matches the flourish-free reference sites. */
  .aurora {
    position: absolute;
    z-index: -1;
    top: -30%;
    left: 50%;
    width: min(70rem, 130vw);
    aspect-ratio: 1 / 1;
    transform: translateX(-50%);
    background: radial-gradient(circle at 42% 40%, var(--accent-soft), transparent 55%);
    filter: blur(20px);
    pointer-events: none;
  }

  .hero-inner {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }

  .hero-title {
    font-size: var(--step-display);
    line-height: 0.98;
    letter-spacing: -0.01em;
    margin: 0 0 var(--space-3);
  }

  .hero-title .line {
    display: block;
  }

  .wave {
    display: inline-block;
    transform-origin: 70% 70%;
    animation: wave 2.8s var(--ease) 1.2s 2;
  }

  @keyframes wave {
    0%, 60%, 100% { transform: rotate(0deg); }
    10% { transform: rotate(14deg); }
    20% { transform: rotate(-8deg); }
    30% { transform: rotate(14deg); }
    40% { transform: rotate(-4deg); }
    50% { transform: rotate(10deg); }
  }

  .hero-sub {
    font-size: clamp(1.15rem, 2.1vw, 1.75rem);
    line-height: 1.35;
    color: var(--ink);
    max-width: 22ch;
    margin-bottom: var(--space-3);
  }

  .hero-sub em {
    color: var(--accent);
    font-size: 1.1em;
  }

  .hero-school {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--step-small);
    color: var(--ink-soft);
    margin: 0;
    padding: 0.5rem 1rem 0.5rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: var(--r-full);
    background: rgba(16, 16, 16, 0.03);
  }

  .pip {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  /* The illustration is a transparent cut-out, so it sits straight on
     the page with a warm glow behind it rather than in a frame. */
  .hero-portrait {
    width: min(210px, 46vw);
    justify-self: start;
  }

  .portrait-float {
    position: relative;
    will-change: transform;
  }

  .hero-portrait img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
  }

  .portrait-ring {
    position: absolute;
    inset: -28% -34%;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 45%, var(--accent-soft), transparent 64%);
    filter: blur(22px);
  }

  .scroll-cue {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    margin-left: var(--gutter);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--step-micro);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-faint);
    text-decoration: none;
    transition: color 0.3s var(--ease);
  }

  .scroll-cue:hover { color: var(--ink); }

  .cue-rail {
    position: relative;
    width: 1px;
    height: 44px;
    background: var(--line-strong);
    overflow: hidden;
  }

  .cue-dot {
    position: absolute;
    left: -1px;
    top: 0;
    width: 3px;
    height: 12px;
    border-radius: 2px;
    background: var(--accent);
    animation: cue 2.4s var(--ease) infinite;
  }

  @keyframes cue {
    0% { transform: translateY(-14px); opacity: 0; }
    35% { opacity: 1; }
    100% { transform: translateY(44px); opacity: 0; }
  }

  @media (min-width: 900px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    }
    .hero-portrait { justify-self: end; width: min(270px, 24vw); }
  }

  /* Work grid ------------------------------------------------------ */
  .work {
    padding-block: clamp(3rem, 7vw, 6rem) var(--space-6);
  }

  /* Work list -------------------------------------------------------
     A text-first index (title, tags, one-line outcome) rather than an
     image grid — closer to how both reference portfolios present
     their work. */
  .work-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: var(--space-3);
    padding-block: clamp(1.75rem, 4vw, 2.75rem);
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition: background 0.4s var(--ease);
  }

  .row:hover,
  .row:focus-visible {
    background: var(--bg-soft);
  }

  .row-index {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--step-micro);
    letter-spacing: 0.18em;
    color: var(--ink-faint);
    padding-top: 0.4em;
  }

  .row-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  .row-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.4vw, 2.4rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--ink);
    transition: color 0.3s var(--ease);
  }

  .row:hover .row-title,
  .row:focus-visible .row-title {
    color: var(--accent);
  }

  .row-tags {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--step-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .row-line {
    font-size: var(--step-body);
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 58ch;
  }

  .row-arrow {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--ink-soft);
    margin-top: 0.3em;
    transition: transform 0.45s var(--ease-out), background 0.35s var(--ease),
      color 0.35s var(--ease), border-color 0.35s var(--ease);
  }

  .row:hover .row-arrow,
  .row:focus-visible .row-arrow {
    transform: translate(3px, -3px);
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: auto 1fr;
    }
    .row-arrow {
      display: none;
    }
  }

  /* Entrance ------------------------------------------------------- */
  .rise {
    animation: rise 0.95s var(--ease-out) both;
    animation-delay: var(--d, 0ms);
  }

  @keyframes rise {
    from { opacity: 0; transform: translate3d(0, 28px, 0); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .rise { animation: none; }
    .wave, .cue-dot { animation: none; }
  }
</style>
