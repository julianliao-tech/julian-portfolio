        font-size: 0.9rem;
        color: var(--ink);
      }

      .meta dd span {
        display: block;
      }

      .intro {
        max-width: none;
        font-size: 1rem;
        line-height: 1.6;
        color: var(--ink-soft);
        text-align: justify;
        text-align-last: left;
        hyphens: auto;
      }

      .pull-quote {
        position: relative;
        max-width: none;
        font-family: var(--font-serif);
        font-weight: 400;
        font-size: clamp(1.6rem, 3.4vw, 2.4rem);
        line-height: 1.4;
        color: var(--ink-faint);
        margin-top: clamp(1.5rem, 4vw, 2.5rem);
        text-align: center;
      }

      .pull-quote-highlight {
        color: #06251e;
        font-weight: 700;
        box-shadow: inset 0 -0.35em 0 rgba(0, 179, 133, 0.22);
      }

      .pull-quote[data-typewriter]::after {
        content: '';
        display: inline-block;
        width: 2px;
        height: 1em;
        margin-left: 2px;
        background: currentColor;
        vertical-align: text-bottom;
        animation: pull-quote-blink 0.9s steps(1) infinite;
      }

      @keyframes pull-quote-blink {
        50% { opacity: 0; }
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      @media (prefers-reduced-motion: reduce) {
        .pull-quote[data-typewriter]::after {
          animation: none;
        }
      }

      /* By the numbers ------------------------------------------------------- */
      .stat-band {
        background: #00b38a;
        color: #fdfbf9;
        padding-block: clamp(2.5rem, 6vw, 4rem);
      }

      .location-block {
        text-align: center;
        padding-inline: clamp(1.25rem, 5vw, 3.5rem);
      }

      .location-label {
        margin: 0 0 0.5rem;
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #fdfbf9;
      }

      .location-name {
        margin: 0;
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(2rem, 6vw, 3.5rem);
        line-height: 1.1;
        color: #fdfbf9;
      }

      /* Dark / white blocks ---------------------------------------------- */
      .dark-block {
        background: var(--ink);
        color: var(--bg);
        padding-block: clamp(3rem, 7vw, 5rem);
      }

      .white-block {
        padding-block: clamp(2.5rem, 6vw, 4rem);
      }

      .white-block-flush-bottom {
        padding-bottom: 0;
      }

      .white-block h2 {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(1.9rem, 4vw, 2.8rem);
        letter-spacing: -0.01em;
        margin: 0 0 0.6rem;
        color: var(--ink);
      }

      .dark-block h2 {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(1.9rem, 4vw, 2.8rem);
        letter-spacing: -0.01em;
        margin: 0 0 0.6rem;
      }

      .white-block p {
        max-width: none;
        font-size: 1rem;
        line-height: 1.6;
        color: var(--ink-soft);
        text-align: justify;
        text-align-last: left;
        hyphens: auto;
      }

      .dark-block .wrap > p:not(.reflect-subhead) {
        max-width: none;
        font-size: 1rem;
        line-height: 1.6;
        color: rgba(253, 251, 249, 0.7);
        text-align: justify;
        text-align-last: left;
        hyphens: auto;
      }

      .reflect-subhead {
        margin: 0 0 0.75rem;
        font-family: var(--font-body);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.8rem;
        color: rgba(253, 251, 249, 0.5);
      }

      /* Typographic emphasis experiment — bold marks a design decision,
         italic marks an insight/rationale, and .callout-phrase (used once,
         on the single clearest insight on the page) bumps size + color for
         a magazine-pull-quote-within-a-paragraph effect. */
      .white-block strong,
      .context-box strong,
      .feature-text strong {
        color: var(--ink);
        font-weight: 700;
      }

      .dark-block strong {
        color: var(--bg);
        font-weight: 700;
      }

      .white-block em,
      .context-box em,
      .feature-text em {
        font-style: italic;
        color: var(--ink);
      }

      .dark-block em {
        font-style: italic;
        color: var(--bg);
      }

      .callout-phrase {
        font-size: 1.2em;
        font-weight: 700;
        color: #00b385;
      }

      .eyebrow-label {
        font-family: var(--font-body);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #00b385;
        margin: 0 0 0.75rem;
        font-size: 0.85rem;
      }

      /* Images ------------------------------------------------------------ */
      .image-row {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
        margin-top: clamp(1.5rem, 4vw, 2.5rem);
      }

      .image-row img {
        display: block;
        width: 100%;
      }

      @media (min-width: 700px) {
        .image-row-personas { grid-template-columns: 1fr 1fr; }
      }

      .image-row-single {
        margin-top: clamp(1.5rem, 4vw, 2.5rem);
      }

      .image-row-single-wide {
        max-width: 56rem;
        margin-inline: auto;
      }

      .image-row-single img {
        display: block;
        width: 100%;
      }

      .image-row-single-phone {
        max-width: 20rem;
        margin-inline: auto;
      }

      .prototype-video {
        display: block;
        width: 100%;
        aspect-ratio: 912 / 1800;
        border-radius: 1.5rem;
      }

      .placeholder {
        display: grid;
        place-items: center;
        aspect-ratio: 21 / 9;
        border: 1px dashed var(--line-strong);
        background: #ffffff;
        color: var(--ink-faint);
        font-family: var(--font-body);
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .placeholder-phone {
        aspect-ratio: 9 / 19;
      }

      /* Feature bands (green, full-bleed) --------------------------------- */
      .feature-band {
        display: grid;
        grid-template-columns: 1fr;
        background: #00b38a;
      }

      .feature-media img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .feature-text {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: clamp(2rem, 5vw, 3.5rem);
      }

      .feature-heading {
        font-family: var(--font-serif);
        font-weight: 400;
        font-style: italic;
        font-size: clamp(1.6rem, 3vw, 2.1rem);
        color: var(--ink);
        margin: 0 0 0.6rem;
      }

      /* Fill matches the section background on purpose — same fix as the
         context box above; the reference had a white card sitting on
         this green band. */
      .feature-text p {
        margin: 0;
        max-width: none;
        font-size: 1rem;
        line-height: 1.6;
        color: rgba(6, 37, 30, 0.75);
      }

      @media (min-width: 800px) {
        .feature-band { grid-template-columns: 1fr 1fr; }
        .feature-band-reverse .feature-media { order: 2; }
        .feature-band-reverse .feature-text { order: 1; }
      }

      /* Challenge cards --------------------------------------------------- */
      .challenge-head {
        display: flex;
        flex-direction: column;
        gap: 1.1rem;
        margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
      }

      .challenge-head .quirky {
        margin-top: -0.2rem;
      }

      .challenge-head h2 {
        color: var(--bg);
        margin: 0;
      }

      .quirky {
        font-family: var(--font-quirky);
        font-size: 1.2rem;
        transform: rotate(-3deg);
        display: inline-block;
      }

      /* All three challenge sections (and Up Next) share one accent now —
         SureCall's own brand green (#00B385, from the Design Kit asset)
         instead of the earlier blue/sage/coral rotation. */
      .quirky-blue,
      .quirky-sage,
      .quirky-coral {
        color: #00b385;
      }

      .challenge-grid {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
      }

      .challenge-card {
        --tilt-x: 0deg;
        --tilt-y: 0deg;
        border: 1px solid rgba(253, 251, 249, 0.15);
        border-left: 3px solid rgba(253, 251, 249, 0.15);
        padding: 1.5rem;
        background: rgba(253, 251, 249, 0.03);
        transform: perspective(700px) rotateX(var(--tilt-x)) rotateY(var(--tilt-y));
        transition: background 0.3s ease, border-color 0.3s ease, transform 0.3s var(--ease-out);
      }

      .challenge-card p {
        margin: 0.75rem 0 0;
        max-width: none;
        color: rgba(253, 251, 249, 0.45);
        font-size: 1rem;
        line-height: 1.6;
      }

      .challenge-num {
        font-family: var(--font-body);
        font-weight: 800;
        font-size: 1.5rem;
        color: rgba(253, 251, 249, 0.35);
      }

      .challenge-card.is-active {
        background: rgba(253, 251, 249, 0.08);
        border-color: rgba(253, 251, 249, 0.3);
      }

      .challenge-card-blue.is-active,
      .challenge-card-sage.is-active,
      .challenge-card-coral.is-active {
        border-left-color: #00b385;
      }

      .challenge-card-blue.is-active .challenge-num,
      .challenge-card-sage.is-active .challenge-num,
      .challenge-card-coral.is-active .challenge-num {
        color: #00b385;
      }

      .challenge-card.is-active p {
        color: var(--bg);
        font-weight: 500;
      }

      @media (min-width: 700px) {
        .challenge-grid { grid-template-columns: repeat(3, 1fr); }
      }

      /* Key takeaways ------------------------------------------------------- */
      .takeaways-heading { color: var(--bg); }

      .takeaways-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
        margin-top: clamp(1.5rem, 4vw, 2.5rem);
        padding-top: clamp(1.5rem, 4vw, 2.5rem);
        border-top: 1px solid rgba(253, 251, 249, 0.15);
      }

      .takeaway-card {
        padding-left: 0;
      }

      .takeaway-dot {
        display: inline-block;
        width: 24px;
        height: 24px;
        border-radius: 999px;
        background: var(--accent-light);
        margin-bottom: 1rem;
      }

      .takeaway-card h3 {
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 1.1rem;
        color: var(--bg);
        margin: 0 0 0.5rem;
      }

      .takeaway-card p {
        margin: 0;
        max-width: none;
        color: rgba(253, 251, 249, 0.6);
        font-size: 1rem;
        line-height: 1.6;
      }

      @media (min-width: 700px) {
        .takeaways-grid {
          grid-template-columns: 1fr 1fr;
        }

        .takeaways-grid .takeaway-card:last-child {
          border-left: 1px solid rgba(253, 251, 249, 0.15);
          padding-left: 2rem;
        }
      }

      /* Up next --------------------------------------------------------------- */
      .up-next { padding-block: clamp(3rem, 7vw, 5rem); }

      .up-next-row {
        --tilt-x: 0deg;
        --tilt-y: 0deg;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1.5rem;
        margin-top: 1rem;
        text-decoration: none;
      }

      .up-next-row img {
        width: 100px;
        aspect-ratio: 1;
        object-fit: cover;
        border: 1px solid var(--line);
        transform: perspective(700px) rotateX(var(--tilt-x)) rotateY(var(--tilt-y));
        transition: transform 0.3s var(--ease-out);
      }

      .up-next-row h2 {
        margin: 0;
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(1.6rem, 4vw, 2.2rem);
        color: var(--ink);
      }

      .up-next-row p {
        margin: 0.25rem 0 0;
        color: var(--ink-faint);
        font-size: 0.9rem;
      }

      .btn-outline {
        margin-left: auto;
        border: 1px solid var(--ink);
        border-radius: 999px;
        padding: 0.5em 1.2em;
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--ink);
      }

      /* Footer ------------------------------------------------------------------ */
      .footer { text-align: center; }

      .footer-heading {
        color: var(--bg);
        font-size: clamp(2.5rem, 7vw, 4.5rem);
        font-family: var(--font-display);
        font-weight: 400;
      }

      .footer-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1rem;
        margin: 1.5rem 0 2rem;
      }

      .footer .btn-pill { border-color: var(--bg); color: var(--bg); }
      .footer .btn-pill-solid { background: var(--bg); color: var(--ink); }

      .footer-social {
        color: rgba(253, 251, 249, 0.7);
        font-family: var(--font-body);
        font-weight: 600;
        text-decoration: none;
      }
    </style>
  </body>
</html>
