---
// ---------------------------------------------------------------------
// Case study page.
// Same architecture built for the SureCall format test (full-bleed
// images between narrow text, a marquee intro, brand-color feature
// bands, dark "Challenge" sections, tilt/lightbox/scroll-progress
// interactions), applied to Michigan ChatGPT's own real content and
// its own brand colors (Michigan Maize #FFCB05 / Michigan Blue
// #00274C) instead of reusing SureCall's green.
//
// Every fact and every image is pulled from
// src/content/projects/michigan-chatgpt.md, public/images/michigan-chatgpt/,
// and real screenshots/wireframes Julian added directly — nothing invented.
// One spot still has no matching real asset (the marquee's intro video)
// and is left as a labeled placeholder box rather than filled with a
// stand-in.
// ---------------------------------------------------------------------
import '../../styles/global.css';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Lightbox from '../../components/Lightbox.astro';

const base = import.meta.env.BASE_URL;
const pageTitle = 'Michigan ChatGPT · Julian Liao';
const pageDescription = 'Four campus AI tools nobody could tell apart, rebuilt into one homepage';
const ogImage = new URL(`${base}images/home/profile-illustration.webp`, Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);
const img = (n: string) => `${base}images/michigan-chatgpt/${n}`;

const meta = [
  { label: 'Timeline', value: 'Aug – Dec 2025' },
  { label: 'Role', value: ['Product Designer', 'UX Researcher'] },
  { label: 'Team', value: 'Solo Project' },
  { label: 'Tools', value: ['Figma', 'FigJam', 'Slack'] },
  {
    label: 'Skills',
    value: ['Wireframing', 'Prototyping', 'Design Systems', 'Interaction Design', 'User Research'],
  },
];

const challenges = [
  'Say what each tool actually does, without turning the homepage into a wall of text.',
  'Pull four different navigation patterns into one that behaves the same way everywhere.',
  'Serve the person who has never been here and the person who comes every day, on one screen.',
];

const researchFindings = [
  'they could not say what any one of the tools was for',
  'they were not sure how to get from one tool to another',
  'they opened ChatGPT instead, because guessing there was easier',
  'nothing about the interface looked like the sites they already use',
];

const keyInsights = [
  'The words were the barrier, not the technology. People who use AI every day still could not tell these four tools apart.',
  'Familiar beats clever. When a page behaves like the pages someone already trusts, they stop bracing and start using it.',
  'When navigation changes between tools, people assume they have left the site and quit exploring.',
];

const firstTimeNeeds = [
  'Work out in one screen that these are the AI tools Michigan built',
  'See what each one is for, and which one fits what I came to do',
  'Move around without feeling like I am one click from breaking something',
];

const returningNeeds = [
  'Get straight into the tool I use, without reading anything first',
  'See what has changed since last time',
  'Reach login, documentation, or an actual human in one click',
];

const whatShipped = [
  'A homepage where all four tools are named in plain language and sit in one row',
  'Cards you can scan in a few seconds, instead of a paragraph you have to read',
  'Michigan branding that is unmistakable without taking over the screen',
  'Bigger targets, clearer labels, and type you can read on a phone outside',
  'Answers tuned for campus questions, so a first time user does not need a good prompt',
];

const lookingAhead = [
  'A real documentation section, instead of links that go nowhere',
  'A homepage that remembers the tool you actually use',
  'A way in from Canvas and the rest of the software students already have open',
];

const marqueeWords = Array(6).fill('U-M AI WORKSPACE');

const nextProject = {
  title: 'SureCall',
  subtitle: 'Telling someone on a ladder whether the install worked',
  image: `${base}images/home/tile-surecall.png`,
  href: `${base}work/surecall/`,
};
---

{/* prettier-ignore */}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#fdfbf9" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={canonical.href} />
    <meta name="description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,600&family=Instrument+Serif:ital@0;1&family=Permanent+Marker&display=swap"
    />
  </head>
  <body>
    <Nav />

    <div data-zoom-group data-zoom-scan>
      <section class="hero-banner">
        <img data-tilt src={img('00-cover-banner.webp')} alt="Michigan ChatGPT redesign shown on a laptop and phone, with the M AI Lab mark, on a maize background" />
      </section>

      <section class="marquee-section" aria-hidden="true">
        <div class="marquee-row">
          <div class="marquee-track marquee-track-left">
            {[...marqueeWords, ...marqueeWords].map((w) => <span>{w}</span>)}
          </div>
        </div>
        <div class="marquee-row">
          <div class="marquee-track marquee-track-right">
            {[...marqueeWords, ...marqueeWords].map((w) => <span>{w}</span>)}
          </div>
        </div>
        <div class="marquee-row">
          <div class="marquee-track marquee-track-left">
            {[...marqueeWords, ...marqueeWords].map((w) => <span>{w}</span>)}
          </div>
        </div>
        <div class="marquee-row">
          <div class="marquee-track marquee-track-right">
            {[...marqueeWords, ...marqueeWords].map((w) => <span>{w}</span>)}
          </div>
        </div>
        <div class="marquee-laptop">
          <div class="laptop-frame">
            <video src={img('marquee-banner.mp4')} autoplay muted loop playsinline aria-label="Screen recording of the Michigan ChatGPT homepage, showing the U-M GPT, Go Blue, Maizey, and GPT Toolkit cards"></video>
          </div>
          <div class="laptop-base"></div>
        </div>
      </section>

      <section class="head-block">
        <div class="wrap">
          <div class="head-top">
            <h1 class="title">Michigan<br />ChatGPT</h1>
            <div class="context-box">
              <p class="context-label">Where this started</p>
              <h2 class="context-heading">Michigan built the AI. Nobody could tell the four tools apart.</h2>
              <p>Michigan ChatGPT is the university's own AI workspace: U-M GPT, Maizey, Go Blue and the GPT Toolkit, all running on models curated for people here. Michigan was the first university to pull that off, and I still think that is a big deal. The problem was never the models. It was that the homepage asked you to pick one of four tools before it told you what any of them were.</p>
            </div>
          </div>

          <dl class="meta">
            {meta.map((m) => (
              <div>
                <dt>{m.label}</dt>
                <dd>{Array.isArray(m.value) ? m.value.map((v) => <span>{v}</span>) : m.value}</dd>
              </div>
            ))}
          </dl>

          <p class="intro">I am a Michigan student, so I was a user of this thing long before I was a designer of it. That is the honest reason I picked it. What surprised me once I started asking people about it is that nobody was intimidated by the AI. They were stuck on the names. Maizey, Go Blue, GPT Toolkit: none of those tell you what is behind them. <strong>People were not failing to use the platform. They were failing to pick a starting point</strong>. When picking takes too long, they open ChatGPT in another tab and campus has lost them for the semester. So I stopped treating this as a visual refresh and started treating it as a naming problem that happens to have a homepage attached.</p>

          <p class="pull-quote" data-typewriter>
            <span aria-hidden="true"><span class="tw-seg" data-full="How do I get someone to the right tool "></span><span class="tw-seg pull-quote-highlight" data-full="before they give up and open another tab"></span><span class="tw-seg" data-full="?"></span></span>
            <span class="sr-only">How do I get someone to the right tool before they give up and open another tab?</span>
          </p>
        </div>
      </section>

      <section class="stat-band">
        <div class="location-block">
          <p class="location-label">Project Location</p>
          <p class="location-name">Ann Arbor, Michigan</p>
        </div>
      </section>

      <section class="dark-block">
        <div class="wrap">
          <div class="challenge-head">
            <span class="quirky">Four names, no map</span>
            <h2>Nothing on the page told you which door to open</h2>
          </div>
          <ol class="challenge-grid challenge-grid-4">
            {challenges.map((c, i) => (
              <li class:list={['challenge-card', { 'is-active': i === 0 }]} data-tilt>
                <span class="challenge-num">{String(i + 1).padStart(2, '0')}</span>
                <p>{c}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="white-block">
        <div class="wrap">
          <h2>I asked around campus, and none of it was about the AI</h2>
          <p>I ran surveys and sat down with students who use campus technology every week. Their answers kept landing in the same four places: <strong>{researchFindings.join('; ')}</strong>. Every one of those is about getting to the tool, not about the tool itself, which told me the fix was in the words and the first screen, not the models.</p>
          <ul class="findings-list">
            {keyInsights.map((k) => <li>{k}</li>)}
          </ul>
          <p class="take">
            <span class="take-label">What I think about this stage</span>
            I used to think research meant finding out what people want. It does not. Every person I
            spoke to wanted "something simpler", which is not a design instruction. The useful part was
            watching where they hesitated, and hesitation does not show up in a survey.
            <strong>People are reliable about what they did and unreliable about what they would do</strong>,
            so I weight the first and discount the second.
          </p>

          <div class="visitor-needs">
            <div>
              <h3 class="visitor-heading">If this is my first time here, I need to:</h3>
              <ul class="findings-list">
                {firstTimeNeeds.map((n) => <li>{n}</li>)}
              </ul>
            </div>
            <div>
              <h3 class="visitor-heading">If I am here every week, I need to:</h3>
              <ul class="findings-list">
                {returningNeeds.map((n) => <li>{n}</li>)}
              </ul>
            </div>
          </div>
          <span class="quirky quirky-tight">The pieces</span>
          <div class="image-row-single image-row-single-flush">
            <img data-tilt src={img('components-spec.webp')} alt="Michigan ChatGPT component library: navbar, search bar, mode-selection buttons, sidebar, and sample sent/reply message bubbles" />
          </div>
        </div>
      </section>

      <section class="dark-block">
        <div class="wrap">
          <div class="challenge-head">
            <span class="quirky">Fewer doors</span>
            <h2>Every extra choice on the first screen costs you somebody</h2>
          </div>
          <ol class="challenge-grid challenge-grid-4">
            {challenges.map((c, i) => (
              <li class:list={['challenge-card', { 'is-active': i === 1 }]} data-tilt>
                <span class="challenge-num">{String(i + 1).padStart(2, '0')}</span>
                <p>{c}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="white-block">
        <div class="wrap">
          <h2>I designed for the person who had never heard of Maizey</h2>
          <p>I went through the old site and wrote down every place I had to stop and think. Most of them were decisions the page was asking me to make before it had told me anything. Three ideas did the heavy lifting and none of them are complicated. Jakob's Law: people expect a new site to work like the sites they already use, so I did not invent a single new pattern. Hick's Law: every extra option makes the choice slower, so the homepage offers four things and not fourteen. The aesthetic usability effect: people judge a clean interface as easier to use even when it is not. Uncomfortable, but worth designing for. <em>Then I rewrote the order of the page so the first thing you meet is what the tools are, not a menu of them.</em> Four columns on mobile and twelve on desktop keep everything landing in the same places as the screen changes size.</p>
          <p class="take">
            <span class="take-label">What I think about this stage</span>
            Naming the laws is the easy half. The honest version is that I had already decided the
            homepage should carry four tools, and Hick's Law is how I defended it afterwards.
            <strong>I think that is fine as long as you know you are doing it, and a problem the moment
            you forget</strong>. Principles are good at stopping bad arguments. They are not where the
            idea comes from.
          </p>

          <div class="image-row-single image-row-single-wide">
            <img data-tilt src={img('02.webp')} alt="Three design-principle cards: Jakob's Law (familiarity), Hick's Law (decision simplification), and the Aesthetic-Usability Effect, each with how it was applied to the redesign" />
          </div>
        </div>
      </section>

      <section class="white-block">
        <div class="wrap">
          <p class="eyebrow-label">Eight ideas, drawn fast, most of them cut</p>
          <p>I sketched eight directions before committing to one: finishing your sentence for you, shifting the background with the conversation, a video analyzer, translation, exporting a chat as a PDF, pulling text out of an image. Drawing them badly and quickly is the point, because it is much easier to throw away a sketch than a prototype. <strong>Most of them did not survive, and the ones that did were the boring ones</strong>: how much goes above the fold, and whether you can tell what a tool does from its card alone.</p>
          <p class="take">
            <span class="take-label">What I think about this stage</span>
            Low fidelity is not really a stage, it is a permission slip. The uglier the sketch, the more
            freely somebody tells you it is wrong, and I would much rather hear that in week one than in
            week six. <strong>The minute a screen looks finished, feedback turns polite and stops being
            useful.</strong> Staying ugly longer is the cheapest skill I have picked up.
          </p>

          <div class="image-row-single image-row-single-wide">
            <img data-tilt src={img('lowfi-wireframes.webp')} alt="Eight low fidelity wireframes for U-M GPT: finishing sentences, changing background color based on conversation, a video analyzer, translation mode, linking to other software, setting tone, exporting past chats as a PDF, and reading text from images and videos" />
          </div>
        </div>
      </section>

      <section class="dark-block">
        <div class="wrap">
          <div class="challenge-head">
            <span class="quirky">Two kinds of visitor</span>
            <h2>New users and regulars want opposite things</h2>
          </div>
          <ol class="challenge-grid challenge-grid-4">
            {challenges.map((c, i) => (
              <li class:list={['challenge-card', { 'is-active': i === 2 }]} data-tilt>
                <span class="challenge-num">{String(i + 1).padStart(2, '0')}</span>
                <p>{c}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="feature-band feature-band-navy">
        <div class="feature-media feature-media-pair">
          <video class="feature-media-mobile" src={img('landing-mobile.mp4')} autoplay muted loop playsinline aria-label="Filled landing page walkthrough on a phone"></video>
          <video src={img('landing-desktop.mp4')} autoplay muted loop playsinline aria-label="Filled landing page walkthrough on a laptop"></video>
        </div>
        <div class="feature-text">
          <h2 class="feature-heading">Every tool on one screen, so nobody has to guess</h2>
          <p>The homepage leads with a line that says what this actually is, then four cards, one per tool, each described in words a first year would use. You can read the whole thing in about as long as you were willing to spend deciding whether to bother. That is the entire goal: no guessing about what the platform is, and no guessing about where to start. Every visit now begins in the same place.</p>
        </div>
      </section>

      <section class="feature-band feature-band-maize feature-band-reverse">
        <div class="feature-media feature-media-pair">
          <img data-tilt src={img('sidebar-desktop-yellow.webp')} alt="Michigan ChatGPT sidebar navigation open over the chat homepage, on a laptop" />
          <img data-tilt class="feature-media-mobile" src={img('sidebar-mobile-yellow.webp')} alt="Michigan ChatGPT sidebar navigation, on a phone" />
        </div>
        <div class="feature-text">
          <h2 class="feature-heading">One way back, from anywhere in the system</h2>
          <p>The sidebar groups tools, resources and support into categories that stay put no matter which tool you are inside. <strong>Bigger tap targets, labels you can read, and the same icon meaning the same thing every time.</strong> People who come back every week do not read the screen. They aim at where the thing was last time. The sidebar is built for aiming.</p>
        </div>
      </section>

      <section class="feature-band feature-band-navy">
        <div class="feature-media feature-media-pair">
          <img data-tilt class="feature-media-mobile" src={img('customize-mobile.webp')} alt="Michigan ChatGPT Choose Mode chatbot customization screen, on a phone" />
          <img data-tilt src={img('customize-desktop.webp')} alt="Michigan ChatGPT Choose Mode chatbot customization screen, on a laptop" />
        </div>
        <div class="feature-text">
          <h2 class="feature-heading">Answers that already know you are on campus</h2>
          <p>Responses are tuned for academic, research and campus questions, so what comes back is shaped for the place you are asking from. <em>It also covers for people who have never written a prompt in their life</em>. You should not have to be good at talking to AI to get something useful out of it, and most people are not, including plenty who use it daily.</p>
        </div>
      </section>

      <section class="feature-band feature-band-maize feature-band-reverse">
        <div class="feature-media feature-media-pair">
          <img data-tilt class="feature-media-mobile" src={img('translation-mobile-yellow.webp')} alt="Michigan ChatGPT Translation Mode screen with input and output language selectors, on a phone" />
          <img data-tilt src={img('translation-desktop-yellow.webp')} alt="Michigan ChatGPT Translation Mode screen with input and output language selectors, on a laptop" />
        </div>
        <div class="feature-text">
          <h2 class="feature-heading">Reading it in the language you actually think in</h2>
          <p>Translation mode lets multilingual students work in whichever language they are fastest in, and switch back when they need the campus wording. <strong>A lot of people here think in another language first</strong>, and making them do financial aid or housing paperwork in their second one is a tax nobody chose to pay. This was the cheapest feature on the list and probably the one I would defend hardest.</p>
        </div>
      </section>

      <section class="feature-band feature-band-navy">
        <div class="feature-media feature-media-pair">
          <img data-tilt class="feature-media-mobile" src={img('audio-mobile.webp')} alt="Michigan ChatGPT audio feedback conversation with Keep Listening and Audio Respond controls, on a phone" />
          <img data-tilt src={img('audio-desktop.webp')} alt="Michigan ChatGPT audio feedback conversation with Keep Listening and Audio Respond controls, on a laptop" />
        </div>
        <div class="feature-text">
          <h2 class="feature-heading">For the times you cannot look at the screen</h2>
          <p>Audio feedback reads responses and confirmations out loud. It matters most to people with vision loss, and it quietly helps everyone else: walking to class, cooking, or just done with reading for the day. <em>Accessibility work keeps turning out to be convenience work for somebody else</em>, which is the argument I use when someone calls it a nice to have.</p>
        </div>
      </section>

      <section class="white-block">
        <div class="wrap">
          <p class="take">
            <span class="take-label">What I think about this stage</span>
            Building the component library before the screens felt like procrastinating, and it saved me
            more time than anything else on this project. Once a card exists as one thing, a change to it
            is a change everywhere, and arguments about spacing stop being arguments.
            <strong>A design system is not a deliverable, it is a way of only solving a problem once.</strong>
          </p>
        </div>
      </section>

      <section class="brand-section">
        <div class="wrap brand-intro">
          <p class="eyebrow-label">The look</p>
          <h2 class="brand-heading">Looks like<br />Michigan.</h2>
        </div>
        <div class="wrap brand-showcase-row">
          <div class="brand-phone-frame">
            <img data-tilt src={img('brand-mobile.webp')} alt="Michigan ChatGPT Fellow Wolverine screen on a phone, shown with column-grid guides over the maize interface" />
          </div>
          <div class="brand-spec-card">
            <div class="spec-row">
              <div class="spec-item">
                <p class="spec-label">Columns</p>
                <p class="spec-value">4</p>
              </div>
              <div class="spec-item">
                <p class="spec-label">Type</p>
                <p class="spec-value">Stretch</p>
              </div>
            </div>
            <div class="spec-row">
              <div class="spec-item">
                <p class="spec-label">Gutter</p>
                <p class="spec-value">16</p>
              </div>
              <div class="spec-item">
                <p class="spec-label">Margin</p>
                <p class="spec-value">0</p>
              </div>
              <div class="spec-item">
                <p class="spec-label">Width</p>
                <p class="spec-value">Auto</p>
              </div>
            </div>
          </div>
        </div>
        <div class="wrap brand-showcase-row">
          <div class="brand-laptop-shell">
            <div class="laptop-frame brand-laptop-frame">
              <img data-tilt src={img('brand-desktop.webp')} alt="Michigan ChatGPT Fellow Wolverine screen on a laptop, shown with column-grid guides over the maize interface" />
            </div>
            <div class="laptop-base"></div>
          </div>
          <div class="brand-spec-card">
            <div class="spec-row">
              <div class="spec-item">
                <p class="spec-label">Columns</p>
                <p class="spec-value">12</p>
              </div>
              <div class="spec-item">
                <p class="spec-label">Type</p>
                <p class="spec-value">Stretch</p>
              </div>
            </div>
            <div class="spec-row">
              <div class="spec-item">
                <p class="spec-label">Gutter</p>
                <p class="spec-value">12</p>
              </div>
              <div class="spec-item">
                <p class="spec-label">Margin</p>
                <p class="spec-value">0</p>
              </div>
              <div class="spec-item">
                <p class="spec-label">Width</p>
                <p class="spec-value">Auto</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="white-block white-block-flush-bottom white-block-flush-top">
        <div class="image-row-single image-row-single-zero">
          <img data-tilt src={img('13-figjam-board.webp')} alt="FigJam board of the Michigan ChatGPT redesign: component library, low fidelity wireframes, page flows, and desktop and mobile screen variations" />
        </div>
      </section>

      <section class="dark-block">
        <div class="wrap">
          <h2>Where it landed, and what I would change</h2>
          <ul class="findings-list findings-list-dark">
            {whatShipped.map((w) => <li>{w}</li>)}
          </ul>
          <p>What I was after is a platform you can trust at a glance, where the first visit and the fiftieth both start somewhere obvious.</p>
          <p>The thing I did not expect to learn is how much of trust is just familiarity. Clarity and polish are not decoration here. They are what makes somebody willing to type a real question into a box owned by their school. Taking this from surveys through to finished screens is also the first time I owned a whole process end to end, and it changed how I start work now: <em>I spend far longer arguing about what to call things than I used to</em>.</p>
          <ul class="findings-list findings-list-dark">
            {lookingAhead.map((l) => <li>{l}</li>)}
          </ul>
          <p>This one is personal. Michigan is my community, and these are tools my friends open between classes without thinking about it. <strong>Making them easier to find is a small change that a lot of people get to feel</strong>, which is most of why I want to do this work at all.</p>
        </div>
      </section>

      <section class="up-next">
        <div class="wrap">
          <span class="quirky">Up Next</span>
          <a class="up-next-row" href={nextProject.href} data-tilt>
            <img src={nextProject.image} alt="" />
            <div>
              <h2>{nextProject.title}</h2>
              <p>{nextProject.subtitle}</p>
            </div>
            <span class="btn-outline">View Project</span>
          </a>
        </div>
      </section>
    </div>

    <Footer />

    <Lightbox />

    <script>
      import '../../scripts/site.js';
      import '../../scripts/lightbox.js';

      const btn = document.querySelector('[data-copy-email]');
      btn?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText('julianliaowork@gmail.com');
          const original = btn.textContent;
          btn.textContent = 'Copied!';
          setTimeout(() => { btn.textContent = original; }, 1500);
        } catch {
          window.location.href = 'mailto:julianliaowork@gmail.com';
        }
      });

      // Belt-and-suspenders autoplay, same as the SureCall test page.
      document.querySelectorAll<HTMLVideoElement>('.feature-media video, .laptop-frame video').forEach((v) => {
        v.play().catch(() => {});
      });

      // Typewriter effect on the pull-quote — types each segment in order
      // (plain text, then the highlighted phrase, then the trailing plain
      // text) once the quote scrolls into view. Reduced-motion and
      // no-IntersectionObserver both fall back to showing the full text.
      const quoteEl = document.querySelector<HTMLElement>('[data-typewriter]');
      if (quoteEl) {
        const segments = Array.from(quoteEl.querySelectorAll<HTMLElement>('.tw-seg'));
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const typeSegments = () => {
          let segIndex = 0;
          let charIndex = 0;
          const step = () => {
            if (segIndex >= segments.length) return;
            const seg = segments[segIndex];
            const full = seg.dataset.full ?? '';
            if (charIndex <= full.length) {
              seg.textContent = full.slice(0, charIndex);
              charIndex++;
              setTimeout(step, 28);
            } else {
              segIndex++;
              charIndex = 0;
              setTimeout(step, 28);
            }
          };
          step();
        };

        if (reduced || !('IntersectionObserver' in window)) {
          segments.forEach((seg) => { seg.textContent = seg.dataset.full ?? ''; });
        } else {
          const io = new IntersectionObserver((entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                typeSegments();
                obs.disconnect();
              }
            });
          }, { threshold: 0.4 });
          io.observe(quoteEl);
        }
      }
    </script>

