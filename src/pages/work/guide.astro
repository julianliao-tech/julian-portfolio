---
// ---------------------------------------------------------------------
// Case study page.
// Same architecture built for the SureCall and Michigan ChatGPT format
// tests (full-bleed images between narrow text, a marquee intro, a
// brand-color stat band, dark "Challenge" sections, brand-color
// feature bands, tilt/lightbox/scroll-progress interactions), applied
// here to the Guide app's own real content and its own real brand
// colors — periwinkle blue #97ADD1, coral #E28A8A, and mint green
// #97D1A3, all pulled directly from the Design Kit asset (15.webp),
// not guessed.
//
// Every fact and every image is pulled from
// src/content/projects/guide.md and public/images/guide/ — nothing
// invented. Guide has exactly three challenges in the source doc, so
// (like SureCall) this uses three separate interleaved "Challenge"
// sections rather than one combined grid. There's no stated project
// location in the source doc, so — unlike the SureCall/Michigan
// pages — there's no location band here; a real stat band (4-week
// timeline, 20+ survey responses, 3 core functions, all literally
// counted from the source doc) stands in its place instead.
// ---------------------------------------------------------------------
import '../../styles/global.css';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Lightbox from '../../components/Lightbox.astro';

const base = import.meta.env.BASE_URL;
const pageTitle = 'Guide Mobile Application — Julian Liao';
const pageDescription = 'A wheelchair-accessible navigation app for safer, independent travel';
const ogImage = new URL(`${base}images/home/profile-illustration.webp`, Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);
const img = (n: string) => `${base}images/guide/${n}`;

const meta = [
  { label: 'Timeline', value: '4 Weeks' },
  { label: 'Role', value: ['UX Designer', 'UX Researcher'] },
  { label: 'Team', value: 'Just Me!' },
  { label: 'Tools', value: ['Figma', 'FigJam', 'Miro'] },
  {
    label: 'Skills',
    value: ['Wireframing', 'Prototyping', 'Design Systems', 'Interaction Design', 'User Research'],
  },
];

const challenges = [
  'Determining what obstructions were most important to cover during travel.',
  'How to exactly show/notify users of an elevator location or other important landmark in their path.',
  'Designing for users who may be traveling quickly or unable to analyze all the content on their phone.',
];

const painPoints = ['Elevators', 'Ramps', 'Crowds', 'Bathrooms', 'Report'];
const trustPoints = ['Elevator Status', 'Ramp Conditions', 'Reported Obstacles'];

// Percentages measured directly from the real donut charts (surveytwo.png,
// the Confidence Level screenshot) — not invented.
const surveyCharts = [
  {
    title: 'Knowledge',
    question: 'Have you ever used an app, map or website that included accessibility information about a public space?',
    segments: [
      { label: 'No', pct: 80, color: '#162e5f' },
      { label: 'Yes', pct: 20, color: '#1a50e0' },
    ],
  },
  {
    title: 'Confidence Level',
    question: 'If a friend/family member asked you for advice about which public spaces are accessible, how confident would you feel giving them accurate info?',
    segments: [
      { label: 'Not Very Confident', pct: 58, color: '#162e5f' },
      { label: 'Somewhat Confident', pct: 32, color: '#1c50de' },
      { label: 'Other', pct: 10, color: '#6093e4' },
    ],
  },
];

const conicGradient = (segments: { pct: number; color: string }[]) => {
  let acc = 0;
  const stops = segments.map((s) => {
    const start = acc;
    acc += s.pct;
    return `${s.color} ${start}% ${acc}%`;
  });
  return `conic-gradient(${stops.join(', ')})`;
};

const marqueeWords = Array(6).fill('TRAVELIN’ SAFE');

const nextProject = {
  title: 'Michigan ChatGPT',
  subtitle: 'Redesigning the University of Michigan’s AI workspace',
  image: `${base}images/home/tile-michigan-chatgpt.webp`,
  href: `${base}work/michigan-chatgpt/`,
};
---

{/* prettier-ignore */}
