---
const base = import.meta.env.BASE_URL;
---
<header class="nav">
  <div class="wrap nav-inner">
    <a class="wordmark" href={base}>Julian Liao</a>
    <nav class="links">
      <a href={base}>Home</a>
      <a href={`${base}about`}>About</a>
      <a href={`${base}photos`}>Photos</a>
      <a href="https://www.linkedin.com/in/julian-liao-475685239/" target="_blank" rel="noreferrer" aria-label="LinkedIn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
      </a>
      <a href="mailto:julianliaowork@gmail.com" aria-label="Email">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
      </a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-2);
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    text-decoration: none;
    color: var(--ink);
  }
  .links {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .links a {
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-small);
    color: var(--ink-soft);
    display: flex;
    align-items: center;
  }
  .links a:hover {
    color: var(--accent);
  }
  @media (max-width: 480px) {
    .links { gap: var(--space-2); }
  }
</style>
