        font-family: var(--font-body);
        font-size: 0.76rem;
        color: var(--ink-faint);
      }

      .spec-nums {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        color: var(--ink);
      }

      /* The published-but-unreached steps. Muted, not hidden: the point
         of showing them is that the scale is complete. */
      .spec-unused {
        align-self: center;
        font-family: var(--font-mono);
        font-size: 0.58rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--ink-faint);
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 0.1rem 0.45rem;
        white-space: nowrap;
      }

      .spec-row:has(.spec-unused) .spec-sample { color: var(--ink-faint); }

      /* The sample is set at the size and leading the active mode's
         variables carry — the specimen changes, not just the numbers. */
      .spec-sample {
        margin: 0;
        max-width: none;
        color: var(--ink);
        overflow-wrap: anywhere;
      }

      [data-mode='Mobile'] .spec-sample { font-size: var(--s-Mobile); line-height: var(--l-Mobile); }
      [data-mode='Tablet'] .spec-sample { font-size: var(--s-Tablet); line-height: var(--l-Tablet); }
      [data-mode='Desktop'] .spec-sample { font-size: var(--s-Desktop); line-height: var(--l-Desktop); }

      .spec-face-heading { font-family: 'Space Grotesk', var(--font-body); }
      .spec-face-body { font-family: 'Atkinson Hyperlegible', var(--font-body); }
      .spec-face-annotation { font-family: 'Caveat', cursive; }

      @media (min-width: 900px) {
        .spec-row { grid-template-columns: 16rem 1fr; }
        .spec-meta { flex-direction: column; gap: 0.15rem; }
      }

      /* Faces ----------------------------------------------------------- */
      .face-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.25rem;
        margin-top: clamp(1.75rem, 4vw, 2.5rem);
      }

      .face-card {
        border: 1px solid var(--line);
        padding: 1.4rem;
      }

      .face-sample {
        margin: 0 0 0.9rem;
        max-width: none;
        font-size: clamp(2rem, 4.5vw, 2.75rem);
        line-height: 1.1;
        color: var(--indigo);
      }

      .face-card h3 {
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 0.98rem;
        margin: 0 0 0.45rem;
        color: var(--ink);
      }

      .face-card p:not(.face-sample) {
        margin: 0;
        font-size: 0.9rem;
        line-height: 1.6;
        color: var(--ink-soft);
      }

      @media (min-width: 820px) {
        .face-grid { grid-template-columns: repeat(3, 1fr); }
      }

      /* Prototype -------------------------------------------------------
         A laptop-ish stage borrowed from elink.astro's .laptop-frame, so
         the embed reads as a device rather than a bare rectangle. The
         poster and the iframe share the stage, which keeps its own
         aspect ratio either way and stops the swap shifting the page. */
      .proto-stage {
        margin-top: clamp(1.5rem, 4vw, 2.25rem);
        max-width: 62rem;
        margin-inline: auto;
      }

      .proto-screen {
        position: relative;
        aspect-ratio: 16 / 10;
        border: 3px solid var(--ink);
        border-radius: 0.75rem 0.75rem 0 0;
        overflow: hidden;
        background: var(--paper);
      }

      /* No `.proto-screen iframe` rule here: the iframe is created at
         click time, so Astro's scoping attribute never lands on it and
         a rule written here would not match. It is sized inline in the
         script above instead. */

      .proto-launch {
        display: block;
        width: 100%;
        height: 100%;
        padding: 0;
        border: 0;
        background: none;
        cursor: pointer;
      }

      .proto-launch img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top center;
        filter: saturate(0.9) brightness(0.96);
        transition: filter 0.25s ease, transform 0.4s ease;
      }

      .proto-launch:hover img,
      .proto-launch:focus-visible img {
        filter: none;
        transform: scale(1.015);
      }

      .proto-cta {
        position: absolute;
        inset-inline: 0;
        bottom: clamp(1.25rem, 4vw, 2.25rem);
        margin-inline: auto;
        width: fit-content;
        padding: 0.7rem 1.4rem;
        background: var(--ink);
        color: var(--paper);
        font-family: 'Space Grotesk', var(--font-body);
        font-weight: 700;
        font-size: 0.9rem;
        border-radius: 999px;
      }

      .proto-base {
        height: 0.85rem;
        border-radius: 0 0 0.6rem 0.6rem;
        background: var(--ink);
      }

      .proto-note {
        margin: 0.9rem auto 0;
        max-width: 62rem;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        color: var(--ink-faint);
      }

      @media (prefers-reduced-motion: reduce) {
        .proto-launch img { transition: none; }
        .proto-launch:hover img,
        .proto-launch:focus-visible img { transform: none; }
      }

      /* Components ------------------------------------------------------
         The exports run from a 600x12 rule to a 136x767 figure, so a
         plain `width: 100%` grid tears itself apart. Instead every media
         box is a fixed ratio and the specimen is centered inside it,
         never scaled past 1.6x its own export. Rows stay level and
         nothing is upscaled into mush. */
      .comp-tier {
        margin: clamp(1.75rem, 4vw, 2.5rem) 0 0.9rem;
        font-family: var(--font-mono);
        font-size: 0.68rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--indigo);
      }

      .comp-grid {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.25rem;
      }

      .comp-card {
        display: flex;
        flex-direction: column;
        border: 1px solid var(--line);
        background: #ffffff;
      }

      .comp-media {
        display: grid;
        place-items: center;
        padding: 1.1rem;
        background: var(--paper);
        border-bottom: 1px solid var(--line);
      }

      .comp-media-set { aspect-ratio: 3 / 1; }
      .comp-media-single { aspect-ratio: 4 / 3; }

      .comp-media img {
        display: block;
        width: auto;
        height: auto;
        max-width: min(100%, var(--mw));
        max-height: min(100%, var(--mh));
        object-fit: contain;
      }

      .comp-body {
        flex: 1;
        padding: 0.9rem 1.1rem 1.1rem;
      }

      .comp-body h3 {
        font-family: 'Space Grotesk', var(--font-body);
        font-weight: 700;
        font-size: 1rem;
        margin: 0 0 0.25rem;
        color: var(--ink);
      }

      .comp-body p {
        margin: 0;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        line-height: 1.5;
        color: var(--indigo);
      }

      @media (min-width: 720px) {
        .comp-grid { grid-template-columns: repeat(2, 1fr); }
      }

      @media (min-width: 1040px) {
        .comp-grid-singles { grid-template-columns: repeat(4, 1fr); }
      }

      /* Up next --------------------------------------------------------- */
      .up-next { padding-block: clamp(3rem, 7vw, 4.5rem); }

      .up-next-row {
        --tilt-x: 0deg;
        --tilt-y: 0deg;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1.5rem;
        margin-top: 1rem;
        text-decoration: none;
      }

      .up-next-row img {
        width: 100px;
        aspect-ratio: 1;
        object-fit: cover;
        border: 1px solid var(--line);
        transform: perspective(700px) rotateX(var(--tilt-x)) rotateY(var(--tilt-y));
        transition: transform 0.3s var(--ease-out);
      }

      .up-next-row h2 {
        margin: 0;
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(1.6rem, 4vw, 2.2rem);
        color: var(--ink);
      }

      .up-next-row p {
        margin: 0.25rem 0 0;
        color: var(--ink-faint);
        font-size: 0.9rem;
      }

      .btn-outline {
        margin-left: auto;
        border: 1px solid var(--ink);
        border-radius: 999px;
        padding: 0.5em 1.2em;
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--ink);
      }
    
      /* Opinion asides — my read on a stage, separate from the account
         of what the file actually contains. */
      .take {
        max-width: 62ch;
        margin: 2rem 0 0;
        padding-left: 1.1rem;
        border-left: 3px solid var(--amber);
        font-family: var(--font-body);
        font-size: 1rem;
        line-height: 1.7;
        color: var(--ink-soft);
      }

      .take strong { color: var(--ink); font-weight: 700; }

      .take-label {
        display: block;
        margin-bottom: 0.35rem;
        font-family: var(--font-display);
        font-size: 1.05rem;
        color: var(--indigo);
      }
</style>
  </body>
</html>
