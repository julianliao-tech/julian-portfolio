---
// ---------------------------------------------------------------------
// The contents control for a case study: a slim bar that sticks under
// the site nav, showing the section you are currently in. Click it and
// the full list of sections drops down, aligned to the same column as
// the rest of the page. Click a heading and the page jumps there.
//
// This replaced two floating versions, a rail and then a tab on the
// right edge. Both sat in empty space beside the page and read as a
// stray chip rather than part of it. A bar is attached to the page
// frame, lines up with the text column, and never covers an image.
//
// It has to sit in normal flow where it should stick, so it is placed
// directly after <Nav /> rather than at the end of the page.
//
// The list is built at runtime from the page's own <h2>s, so a page
// that gains or loses a section needs no edit here. Two kinds of <h2>
// are skipped: the design system accordion titles (headings of a
// dropdown, not of a section) and the Up Next block (the next project,
// not part of this one).
//
// Astro's scoped styles cannot reach nodes made with createElement, so
// every rule for the generated list is written with :global().
// ---------------------------------------------------------------------
---

<div class="scon" data-section-rail data-open="false" hidden>
  <div class="scon-bar">
    <div class="wrap scon-inner">
      <button
        type="button"
        class="scon-btn"
        aria-expanded="false"
        aria-controls="section-list"
        data-srail-toggle
      >
        <span class="scon-label">Contents</span>
        <span class="scon-now">
          <span class="scon-now-num" data-srail-num></span>
          <span class="scon-now-name" data-srail-now></span>
        </span>
        <span class="scon-chev" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7">
            <path d="M5 9l7 7 7-7" stroke-linecap="square" />
          </svg>
        </span>
      </button>
    </div>
  </div>

  <nav class="scon-panel" id="section-list" aria-label="Sections">
    <div class="wrap">
      <ul></ul>
    </div>
  </nav>
</div>

<script>
  const rail = document.querySelector<HTMLElement>('[data-section-rail]');
  // The case studies have no <main>: the sections sit in the zoom group,
  // or straight in the body.
  const scope = document.querySelector<HTMLElement>('main, [data-zoom-group]') || document.body;

  if (rail) {
    const heads = Array.from(scope.querySelectorAll<HTMLElement>('h2')).filter(
      (h) =>
        !h.closest('[data-acc-item]') &&
        !h.closest('.up-next') &&
        !h.closest('.nav') &&
        !h.closest('footer')
    );

    if (heads.length >= 3) {
      const list = rail.querySelector('ul');
      const toggle = rail.querySelector<HTMLButtonElement>('[data-srail-toggle]');
      const now = rail.querySelector<HTMLElement>('[data-srail-now]');
      const nowNum = rail.querySelector<HTMLElement>('[data-srail-num]');
      const navEl = document.querySelector<HTMLElement>('[data-nav]');

      const items = heads.map((h) => {
        const label = (h.textContent || '').trim();
        if (!h.id) {
          const base =
            label
              .toLowerCase()
              .replace(/[^a-z0-9]+/g, '-')
              .replace(/^-|-$/g, '')
              .slice(0, 40) || 'section';
          let id = base;
          let n = 2;
          while (document.getElementById(id)) id = `${base}-${n++}`;
          h.id = id;
        }
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `#${h.id}`;
        const num = document.createElement('span');
        num.className = 'scon-num';
        num.textContent = String(heads.indexOf(h) + 1).padStart(2, '0');
        const text = document.createElement('span');
        text.className = 'scon-text';
        text.textContent = label;
        a.append(num, text);
        li.appendChild(a);
        list?.appendChild(li);
        return { a, head: h, label };
      });

      rail.hidden = false;
      const bar = rail.querySelector<HTMLElement>('.scon-bar');

      const setOpen = (open: boolean) => {
        rail.dataset.open = String(open);
        toggle?.setAttribute('aria-expanded', String(open));
      };

      // The bar always sits flush at the very top. The site nav slides
      // back in over it when you scroll up, which is why the bar is a
      // layer below the nav rather than trying to follow its height:
      // following it left a gap for the length of the nav's own slide.
      let navH = 0;
      const measure = () => {
        navH = navEl?.offsetHeight || 0;
        follow();
      };
      const follow = () => {
        const first = items[0].head.getBoundingClientRect().top;
        const pinned = first <= 8;
        rail.classList.toggle('is-pinned', pinned);
        if (!pinned && rail.dataset.open === 'true') setOpen(false);
      };
      measure();

      // Clearance for anything pinned over the top of the page: the nav
      // when it is showing, plus the bar itself.
      const offset = () => {
        const navShowing = !navEl?.classList.contains('is-hidden');
        return (navShowing ? navH : 0) + (bar?.offsetHeight || 0) + 16;
      };

      toggle?.addEventListener('click', () => setOpen(rail.dataset.open !== 'true'));

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && rail.dataset.open === 'true') {
          setOpen(false);
          toggle?.focus();
        }
      });

      document.addEventListener('click', (e) => {
        if (rail.dataset.open !== 'true') return;
        if (!rail.contains(e.target as Node)) setOpen(false);
      });

      let current = -1;
      const setActive = (i: number) => {
        if (i === current) return;
        current = i;
        items.forEach((it, n) => {
          it.a.classList.toggle('is-active', n === i);
          if (n === i) it.a.setAttribute('aria-current', 'true');
          else it.a.removeAttribute('aria-current');
        });
        if (now) now.textContent = items[i]?.label || '';
        if (nowNum) nowNum.textContent = i >= 0 ? String(i + 1).padStart(2, '0') : '';
      };

      let ticking = false;
      const update = () => {
        ticking = false;
        follow();
        const line = offset() + 8;
        let active = 0;
        items.forEach((it, i) => {
          if (it.head.getBoundingClientRect().top <= line) active = i;
        });
        setActive(active);
      };
      update();

      window.addEventListener(
        'scroll',
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(update);
        },
        { passive: true }
      );
      window.addEventListener(
        'resize',
        () => {
          measure();
          update();
        },
        { passive: true }
      );

      items.forEach((it, i) => {
        it.a.addEventListener('click', (e) => {
          e.preventDefault();
          const top = it.head.getBoundingClientRect().top + window.scrollY - offset();
          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top, behavior: reduce ? 'auto' : 'smooth' });
          setActive(i);
          setOpen(false);
          history.replaceState(null, '', `#${it.head.id}`);
        });
      });
    }
  }
</script>

<style>
  /* Always out of the flow. Hidden over the landing block, then shown
     already at the top the moment the first section reaches it, with no
     animation on the way in. */
  .scon {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    /* One layer under the site nav (30), so the nav covers it on the
       way back in instead of the two stacking. */
    z-index: 20;
    display: none;
  }

  .scon.is-pinned { display: block; }

  /* The bar ----------------------------------------------------------- */
  .scon-bar {
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .scon-inner { padding-block: 0; }

  .scon-btn {
    appearance: none;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    width: 100%;
    padding: 0.7rem 0;
    background: transparent;
    border: 0;
    cursor: pointer;
    text-align: left;
    color: var(--ink);
  }

  .scon-btn:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: -2px;
  }

  .scon-label {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--step-micro);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-faint);
    transition: color 0.2s var(--ease);
  }

  .scon-btn:hover .scon-label { color: var(--ink); }

  .scon-now {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: var(--step-small);
    line-height: 1.3;
    color: var(--ink-soft);
  }

  .scon-now-num {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--step-micro);
    color: var(--ink-faint);
  }

  .scon-now-name {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .scon-chev {
    flex: none;
    display: grid;
    place-items: center;
    color: var(--ink-faint);
    transition: transform 0.25s var(--ease), color 0.2s var(--ease);
  }

  .scon-btn:hover .scon-chev { color: var(--ink); }
  .scon[data-open='true'] .scon-chev { transform: rotate(180deg); color: var(--ink); }

  /* The panel --------------------------------------------------------- */
  .scon-panel {
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s var(--ease), border-color 0.3s var(--ease);
    border-bottom-color: transparent;
  }

  .scon[data-open='true'] .scon-panel {
    max-height: 60vh;
    overflow-y: auto;
    border-bottom-color: var(--line);
  }

  .scon-panel :global(ul) {
    list-style: none;
    margin: 0;
    padding: 1rem 0 1.25rem;
    display: grid;
    gap: 0 clamp(1.5rem, 4vw, 3rem);
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 760px) {
    .scon-panel :global(ul) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 1180px) {
    .scon-panel :global(ul) { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .scon-panel :global(li) { border-left: 1px solid var(--line); }

  .scon-panel :global(a) {
    display: flex;
    gap: 0.6rem;
    padding: 0.35rem 0 0.35rem 0.75rem;
    margin-left: -1px;
    border-left: 2px solid transparent;
    font-size: var(--step-small);
    line-height: 1.4;
    color: var(--ink-faint);
    text-decoration: none;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .scon-panel :global(a:hover) { color: var(--ink); }

  .scon-panel :global(a:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  .scon-panel :global(a.is-active) {
    color: var(--ink);
    border-left-color: var(--ink);
    font-weight: 500;
  }

  .scon-panel :global(.scon-num) {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--step-micro);
    line-height: 1.75;
    color: var(--ink-faint);
    font-weight: 400;
  }

  .scon-panel :global(a.is-active .scon-num) { color: var(--ink); }

  .scon-panel :global(.scon-text) {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .scon-panel,
    .scon-chev,
    .scon-panel :global(a) { transition: none; }
  }

  @media (max-width: 600px) {
    .scon { display: none; }
  }
</style>
