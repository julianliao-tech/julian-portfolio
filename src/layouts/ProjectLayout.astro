---
import BaseLayout from './BaseLayout.astro';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  role: string[];
  timeline: string;
  team: string;
  tools: string[];
  skills: string[];
  order: number;
  tileImage: string;
  tileAlt: string;
  nextOverrideHref?: string;
  nextOverrideTitle?: string;
}

const {
  title,
  role,
  timeline,
  team,
  tools,
  skills,
  order,
  tileImage,
  tileAlt,
  nextOverrideHref,
  nextOverrideTitle,
} = Astro.props;
const base = import.meta.env.BASE_URL;

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((p) => p.data.order === order);
const prev = idx > 0 ? all[idx - 1] : null;
const nextEntry = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : null;

// Icon + label + value(s) for each fact — mirrors the old site's
// Role / Team / Timeline / Skills / Tools strip under the title.
const facts = [
  {
    label: 'Role',
    icon: 'M12 12a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9Z M4.5 20.5a7.5 7.5 0 0 1 15 0',
    values: role,
  },
  {
    label: 'Team',
    icon:
      'M8.5 10.6a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z M15.5 11.1a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z M3 19c0-3 2.5-5.4 5.5-5.4S14 16 14 19 M13.3 19c0-2.3 1.6-4.1 3.6-4.1s3.6 1.8 3.6 4.1',
    values: [team],
  },
  {
    label: 'Timeline',
    icon: 'M12 20.5a8.5 8.5 0 1 0 0-17 8.5 8.5 0 0 0 0 17Z M12 7.5V12l3.2 1.8',
    values: [timeline],
  },
  {
    label: 'Skills',
    icon: 'M12 20.5a8.5 8.5 0 1 0 0-17 8.5 8.5 0 0 0 0 17Z M12 16.5a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9Z',
    dot: true,
    values: skills,
  },
  {
    label: 'Tools',
    icon: 'M4.5 4.5h6v6h-6z M13.5 4.5h6v6h-6z M4.5 13.5h6v6h-6z M13.5 13.5h6v6h-6z',
    values: tools,
  },
];
const num = String(order).padStart(2, '0');
---
<BaseLayout title={`${title} — Julian Liao`}>
  <article class="project">
    <header class="project-head wrap">
      <a class="back" href={`${base}#work`}>
        <span class="back-arrow" aria-hidden="true">&larr;</span> All projects
      </a>

      <p class="eyebrow">Case study {num}</p>
      <h1>{title}</h1>

      <div class="hero-media" data-tilt data-reveal>
        <img src={tileImage} alt={tileAlt} class="reveal-zoom" loading="eager" decoding="async" />
      </div>

      <ul class="facts">
        {facts.map((f) => (
          <li class="fact">
            <svg class="fact-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={f.icon} />
              {f.dot && <circle cx="12" cy="12" r="1.4" fill="currentColor" stroke="none" />}
            </svg>
            <span class="fact-label">{f.label}</span>
            {f.values.length > 1 ? (
              <ul class="fact-list">
                {f.values.map((v) => <li>{v}</li>)}
              </ul>
            ) : (
              <span class="fact-value">{f.values[0]}</span>
            )}
          </li>
        ))}
      </ul>
    </header>

    <div class="prose wrap" data-zoom-group data-zoom-scan>
      <slot />
    </div>

    <nav class="project-pager wrap" aria-label="More projects">
      {prev ? (
        <a class="pager-link" href={`${base}work/${prev.id}/`}>
          <span class="pager-label"><span aria-hidden="true">&larr;</span> Previous</span>
          <span class="pager-title">{prev.data.title}</span>
        </a>
      ) : <span class="pager-empty" />}
      {nextEntry ? (
        <a class="pager-link pager-next" href={`${base}work/${nextEntry.id}/`}>
          <span class="pager-label">Next <span aria-hidden="true">&rarr;</span></span>
          <span class="pager-title">{nextEntry.data.title}</span>
        </a>
      ) : nextOverrideHref ? (
        <a class="pager-link pager-next" href={`${base}${nextOverrideHref}/`}>
          <span class="pager-label">Next <span aria-hidden="true">&rarr;</span></span>
          <span class="pager-title">{nextOverrideTitle}</span>
        </a>
      ) : <span class="pager-empty" />}
    </nav>
  </article>
</BaseLayout>

<style>
  .project-head {
    padding-block: clamp(2.5rem, 7vw, 5rem) 0;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--step-small);
    color: var(--ink-faint);
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    transition: color 0.3s var(--ease);
  }

  .back:hover { color: var(--ink); }

  .back-arrow {
    display: inline-block;
    transition: transform 0.4s var(--ease-out);
  }

  .back:hover .back-arrow { transform: translateX(-4px); }

  .project-head h1 {
    font-size: clamp(2.4rem, 7.5vw, 5.5rem);
    line-height: 1.02;
    letter-spacing: -0.01em;
    max-width: 16ch;
    margin: 0 0 clamp(2rem, 5vw, 3.5rem);
  }

  /* Hero -------------------------------------------------------------
     The same device-mockup illustration used for this project's Home
     grid tile, shown large here. [data-tilt] (site.js) drives the same
     cursor-tracked rotation as the card thumbnails, so the tile and
     its case study feel like the same object. */
  .hero-media {
    --tilt-x: 0deg;
    --tilt-y: 0deg;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--bg-elev);
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
    /* Fixed at Guide's own illustration proportions (2108×1762) so
       every case study's hero renders at the same size regardless of
       its source image's native aspect ratio. */
    aspect-ratio: 6 / 5;
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: perspective(1200px) rotateX(var(--tilt-x)) rotateY(var(--tilt-y)) scale(1.02);
    transition: transform 0.6s var(--ease-out);
  }

  .hero-media:hover img {
    transition: transform 0.15s var(--ease-out);
  }

  /* Facts strip --------------------------------------------------------
     Role / Team / Timeline / Skills / Tools, echoing the icon row from
     the previous site's case studies. */
  .facts {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-4) var(--space-3);
    margin: 0;
    padding: var(--space-4) 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .fact {
    padding-left: var(--space-3);
    border-left: 1px solid var(--line);
  }

  .fact:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .fact-icon {
    display: block;
    color: var(--accent);
    margin-bottom: 0.6rem;
  }

  .fact-label {
    display: block;
    font-family: var(--font-body);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: var(--step-micro);
    color: var(--ink-faint);
    margin-bottom: 0.4rem;
  }

  .fact-value {
    display: block;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .fact-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .fact-list li {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--ink);
    letter-spacing: -0.01em;
    line-height: 1.5;
  }

  @media (max-width: 620px) {
    .facts {
      grid-template-columns: repeat(2, 1fr);
    }

    .fact:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }
  }

  /* Prose ---------------------------------------------------------
     Text sits in a readable column centered in the container (equal
     space either side), left-aligned within that column; a couple of
     call-out elements (.split, blockquote) deliberately bleed out to
     the full container width for visual variety. */
  .prose {
    display: grid;
    grid-template-columns:
      [wide-start] minmax(0, 1fr) [text-start] minmax(0, 68ch) [text-end]
      minmax(0, 1fr) [wide-end];
    padding-block: clamp(3rem, 8vw, 6rem) 0;
    counter-reset: section;
  }

  .prose > :global(*) {
    grid-column: text-start / text-end;
  }

  .prose :global(h2) {
    font-size: var(--step-h2);
    margin: clamp(3.5rem, 8vw, 6rem) 0 var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
  }

  .prose :global(h2::before) {
    counter-increment: section;
    content: counter(section, decimal-leading-zero);
    display: block;
    font-size: var(--step-micro);
    font-weight: 600;
    letter-spacing: 0.22em;
    color: var(--accent);
    margin-bottom: 0.9rem;
  }

  .prose > :global(h2:first-child) {
    margin-top: 0;
    border-top: 0;
    padding-top: 0;
  }

  .prose :global(h3) {
    font-size: var(--step-h3);
    margin-top: var(--space-4);
    color: var(--ink);
  }

  .prose :global(p) {
    max-width: none;
    line-height: 1.7;
  }

  .prose :global(ul),
  .prose :global(ol) {
    color: var(--ink-soft);
    padding-left: 1.2em;
    margin-bottom: var(--space-3);
  }

  .prose :global(li) {
    margin-bottom: 0.45em;
  }

  .prose :global(li::marker) {
    color: var(--accent);
  }

  .prose :global(strong) {
    color: var(--ink);
  }

  .prose :global(a) {
    color: var(--accent);
  }

  /* Markdown renders each image as its own paragraph, kept at text
     width rather than bleeding into the wide column — these are
     mostly tall screenshots, and full-bleed made the page feel much
     longer than the writing actually is. */
  .prose > :global(p:has(> img)) {
    grid-column: text-start / text-end;
    /* Grid rows don't collapse margins, so keep the image close to the
       copy it illustrates and let the gap fall after it. */
    margin-block: var(--space-2) var(--space-4);
  }

  /* A curtain-wipe reveal layered on top of the shared fade/rise from
     global.css (opacity + transform) — additive, not a replacement,
     since clip-path doesn't touch either property. Gated behind
     html.js like every other reveal rule, so a no-JS visitor (who
     never gets .is-in) sees the image plainly instead of permanently
     clipped to nothing. */
  html.js .prose > :global(p:has(> img)) {
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.9s var(--ease-out);
    transition-delay: var(--reveal-delay, 0ms);
  }

  html.js .prose > :global(p:has(> img).is-in) {
    clip-path: inset(0 0 0% 0);
  }

  .prose :global(img) {
    display: block;
    width: 100%;
    max-width: 30rem;
    margin-inline: auto;
    height: auto;
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    background: var(--bg-elev);
    transition: border-color 0.4s var(--ease), transform 0.7s var(--ease-out);
  }

  .prose :global(img:hover) {
    border-color: var(--line-strong);
  }

  /* Same treatment as .prose img, for screen-recorded product-demo
     clips (muted/looping, styled like a silent GIF rather than a
     video player — no controls needed). */
  .prose :global(video) {
    display: block;
    width: 100%;
    max-width: 30rem;
    margin-inline: auto;
    height: auto;
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    background: var(--bg-elev);
  }

  /* Occasional side-by-side layout: a paragraph beside the image it
     describes, alternating which side the image sits on (.split-reverse).
     Used sparingly within specific case studies, not for every image —
     authored directly as raw HTML in the markdown where it fits. */
  .prose :global(.split) {
    grid-column: wide-start / wide-end;
    display: grid;
    gap: var(--space-3);
    align-items: center;
    margin-block: clamp(2.5rem, 6vw, 4rem);
  }

  .prose :global(.split-text p) {
    margin: 0;
  }

  .prose :global(.split-media img) {
    max-width: none;
    margin-inline: 0;
  }

  @media (min-width: 800px) {
    .prose :global(.split) {
      grid-template-columns: 1fr 1fr;
      gap: clamp(2rem, 4vw, 3.5rem);
    }

    .prose :global(.split-reverse .split-media) {
      order: -1;
    }
  }

  /* Full-bleed figure for content that needs more than the 30rem text-width
     cap — dense diagrams and charts (Gantt charts, WBS trees, data tables)
     that turn to mush at phone-screenshot size. Used sparingly, same as
     .split and blockquote. */
  .prose :global(.wide-figure) {
    grid-column: wide-start / wide-end;
    margin-block: clamp(2rem, 5vw, 3rem);
  }

  .prose :global(.wide-figure img),
  .prose :global(.wide-figure video) {
    max-width: 100%;
    margin-inline: 0;
  }

  .prose :global(blockquote) {
    grid-column: wide-start / wide-end;
    margin: var(--space-4) 0;
    padding: var(--space-3) var(--space-4);
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-left: 2px solid var(--accent);
    border-radius: 0 var(--r) var(--r) 0;
  }

  .prose :global(blockquote p) {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    line-height: 1.4;
  }

  /* Pager ---------------------------------------------------------- */
  .project-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: clamp(4rem, 9vw, 7rem);
    border-top: 1px solid var(--line);
  }

  .pager-link,
  .pager-empty {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: clamp(1.75rem, 4vw, 3rem) var(--space-3);
    text-decoration: none;
    transition: background 0.4s var(--ease);
  }

  .pager-link:hover {
    background: var(--bg-soft);
  }

  /* Keep the outer edges flush with the page gutter. */
  .pager-link:not(.pager-next) { padding-left: 0; }
  .pager-next { padding-right: 0; }

  .pager-next {
    text-align: right;
    grid-column: 2;
    align-items: flex-end;
    border-left: 1px solid var(--line);
  }

  .pager-label {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--step-micro);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .pager-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.1rem, 2.2vw, 1.6rem);
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--ink);
  }

  @media (max-width: 620px) {
    .project-pager { grid-template-columns: 1fr; }
    .pager-next {
      grid-column: 1;
      text-align: left;
      align-items: flex-start;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .pager-empty { display: none; }
    .pager-link { padding-inline: 0; }
  }
</style>
