---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const consultingWork = {
  slug: 'consulting-work',
  title: 'Consulting Work',
  tileImage: `${base}images/home/tile-consulting-work.webp`,
  tileAlt: 'Consulting project thumbnails: Q-Bakehouse and MCBC Pink Moon',
};
---
<BaseLayout title="Julian Liao — UX Designer">
  <section class="hero wrap">
    <p class="eyebrow">UX Designer</p>
    <h1>Hello, I'm Julian <span aria-hidden="true">👋</span></h1>
    <p class="hero-sub">UX designer focused on <em>intuitive</em> and <em>accessible</em> user experiences.</p>
    <p class="hero-school">Student @ The University of Michigan</p>
    <img class="hero-portrait" src={`${base}images/home/profile-illustration.webp`} alt="Illustrated portrait of Julian Liao" width="320" height="320" />
  </section>

  <section id="work" class="wrap work-section">
    <h2>Projects</h2>
    <div class="grid">
      {projects.map((p) => (
        <a class="card" href={`${base}work/${p.id}`}>
          <img src={p.data.tileImage} alt={p.data.tileAlt} loading="lazy" />
          <span class="card-title">{p.data.title}</span>
        </a>
      ))}
      <a class="card" href={`${base}work/${consultingWork.slug}`}>
        <img src={consultingWork.tileImage} alt={consultingWork.tileAlt} loading="lazy" />
        <span class="card-title">{consultingWork.title}</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-6) var(--space-5);
    position: relative;
  }
  .hero h1 {
    font-size: var(--step-hero);
    max-width: 14ch;
  }
  .hero-sub {
    font-size: var(--step-h3);
    color: var(--ink);
    max-width: 38ch;
  }
  .hero-sub em {
    font-style: normal;
    color: var(--accent);
  }
  .hero-school {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--ink-soft);
  }
  .hero-portrait {
    width: min(220px, 40vw);
    height: auto;
    margin-top: var(--space-4);
    border-radius: var(--radius);
  }

  .work-section {
    padding-block: var(--space-4) var(--space-6);
  }
  .work-section h2 {
    font-size: var(--step-h1);
    margin-bottom: var(--space-4);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-3);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    text-decoration: none;
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.18s ease, border-color 0.18s ease;
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
  }
  .card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .card-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-h3);
    color: var(--ink);
    padding: 0 var(--space-2) var(--space-2);
  }
</style>
