---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;

// Each graphic already bakes in its own label, doodle and collage —
// no card/border needed, just place them at the four corners around
// the text, matching Julian's reference layout.
const corners = {
  tl: {
    src: `${base}images/about/about-2.webp`,
    alt: 'DJ/Music Production collage: Julian DJing outdoors on turntables, and producing music at a laptop and keyboard',
  },
  tr: {
    src: `${base}images/about/about-1.webp`,
    alt: "Photography/Film Making collage: Julian at Michigan Stadium in a photo-crew vest, with film festival selection notices for his short 'The Letter'",
  },
  bl: {
    src: `${base}images/about/about-4.webp`,
    alt: 'Furniture Design collage: a handmade wooden stool with a woven cord seat, plus a close-up of the weave pattern',
  },
  br: {
    src: `${base}images/about/about-3.webp`,
    alt: 'Sports collage: Julian playing baseball, basketball, and soccer, with his Michigan Squash team and a sectional-champion award',
  },
};
---
<BaseLayout
  title="About — Julian Liao"
  description="Julian Liao is a UX design student at the University of Michigan."
>
  <section class="wrap about-head">
    <p class="eyebrow">About</p>
    <h1>A bit about me</h1>
  </section>

  <section class="wrap about-body">
    <div class="about-layout" data-zoom-group>
      <figure class="shot shot-tl" data-reveal data-reveal-delay="0">
        <img
          class="reveal-zoom"
          data-zoom-frame
          src={corners.tl.src}
          alt={corners.tl.alt}
          width="2500"
          height="1932"
          loading="lazy"
          decoding="async"
          data-zoomable
        />
      </figure>

      <figure class="shot shot-tr" data-reveal data-reveal-delay="60">
        <img
          class="reveal-zoom"
          data-zoom-frame
          src={corners.tr.src}
          alt={corners.tr.alt}
          width="2500"
          height="1932"
          loading="lazy"
          decoding="async"
          data-zoomable
        />
      </figure>

      <div class="about-copy">
        <p data-reveal>
          I'm Julian, a student at the <strong>University</strong> of <strong>Michigan</strong> studying UX
          Design with a double minor in Digital Studies and Business at the Ross School of Business.
        </p>
        <p data-reveal>
          Growing up, I spent my summers bringing my ambitious ideas to life at a short film camp with my
          friends; writing, shooting, and editing stories that turned imagination into reality.
        </p>
        <p data-reveal>
          Over the years, I've been creative through sports, street photography, music production and
          furniture design.
        </p>
        <p data-reveal>
          While studying in the library as a freshman in college, I stumbled across a flyer advertising a
          UX Design opportunity. Being my curious self I looked into it and the craft immediately clicked
          with me.
        </p>
        <p data-reveal>
          UX Design blends my creative instincts with a structured, thoughtful process I genuinely enjoy.
          Today, I design digital experiences that are intuitive, accessible, and meaningful; driven by the
          same passion that first had me holding a camera and chasing a story.
        </p>
      </div>

      <figure class="shot shot-bl" data-reveal data-reveal-delay="60">
        <img
          class="reveal-zoom"
          data-zoom-frame
          src={corners.bl.src}
          alt={corners.bl.alt}
          width="2500"
          height="1932"
          loading="lazy"
          decoding="async"
          data-zoomable
        />
      </figure>

      <figure class="shot shot-br" data-reveal data-reveal-delay="0">
        <img
          class="reveal-zoom"
          data-zoom-frame
          src={corners.br.src}
          alt={corners.br.alt}
          width="2500"
          height="1932"
          loading="lazy"
          decoding="async"
          data-zoomable
        />
      </figure>
    </div>
  </section>
</BaseLayout>

<style>
  .about-head {
    padding-block: clamp(3.5rem, 9vw, 7rem) clamp(2rem, 5vw, 3.5rem);
  }

  .about-head h1 {
    font-size: var(--step-display);
    line-height: 1;
    margin: 0;
  }

  .about-body {
    padding-bottom: clamp(3rem, 8vw, 6rem);
    /* Wider than the site's default --max-width so the four corner
       graphics have room to sit outside the text column. */
    max-width: 100rem;
  }

  /* Mobile-first: the two top shots side by side, then the text, then
     the two bottom shots side by side. The four-corner arrangement
     only kicks in once there's room for real margins either side of
     the text — see the min-width query below. */
  .about-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-areas:
      'tl tr'
      'text text'
      'bl br';
    align-items: center;
    gap: clamp(1.5rem, 5vw, 3rem);
  }

  .shot-tl { grid-area: tl; }
  .shot-tr { grid-area: tr; }
  .shot-bl { grid-area: bl; }
  .shot-br { grid-area: br; }

  .about-copy {
    grid-area: text;
    max-width: 42rem;
    margin-inline: auto;
    border-top: 1px solid var(--line);
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  .about-copy p {
    font-size: clamp(1.05rem, 1.6vw, 1.35rem);
    line-height: 1.55;
    max-width: none;
    margin-bottom: var(--space-3);
  }

  /* The opening line carries the weight. */
  .about-copy p:first-child {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.35rem, 2.6vw, 2.1rem);
    line-height: 1.28;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin-bottom: var(--space-4);
  }

  /* Each graphic already contains its own label, doodle and collage
     on a transparent ground — no card, border or crop, just sized
     down and dropped into place. */
  .shot {
    margin: 0;
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Four true corners flanking the text, vertically centered against
     it, once there's enough width to hold them. */
  @media (min-width: 1300px) {
    .about-layout {
      grid-template-columns: minmax(12rem, 19rem) minmax(0, 42rem) minmax(12rem, 19rem);
      grid-template-areas:
        'tl text tr'
        'bl text br';
      justify-content: center;
    }

    .about-copy {
      margin-inline: 0;
    }

    /* Images fill their column (width: 100%), so only the vertical
       placement matters here: top pair hugs the top edge, bottom
       pair hugs the bottom edge, leaving open space toward the text
       at vertical center — matching the reference layout. */
    .shot-tl,
    .shot-tr {
      align-self: start;
    }

    .shot-bl,
    .shot-br {
      align-self: end;
    }
  }
</style>
